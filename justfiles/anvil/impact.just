# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/local.md
#
# Impact analysis lives in one place: the `anvil-impact` recipe. It runs
# cargo-delta against the working tree vs. the base ref. Clean runs write a
# durable cache under target/anvil/impact/; dirty local runs write their
# ephemeral projections under target/anvil/impact-dirty/. The per-crate check
# recipes consume both via _anvil-impact-include. Cloud impact jobs require a
# clean checkout, run `just anvil-impact`, and upload target/anvil/impact/ as
# an artifact; each downstream group job downloads it, so the checks read the
# clean cache instead of recomputing.
#
# The base ref is resolved by the shared _anvil-base-ref helper (helpers.just,
# also reused by anvil-mutants-diff). The impact -> `--package name@version`
# tier projection is _anvil-impact-format, defined in THIS file next to its
# sole caller; this recipe orchestrates the snapshots + caching around both so
# the exact same projection is used locally and in CI.
#
# Escape hatch: set ANVIL_IMPACT=off in the environment that invokes `just`
# to disable scoping entirely (no git, no snapshot, no cargo-delta). Because
# `just` runs dependencies in that same environment, the guard is honored
# even when these recipes run as a `: anvil-impact` dependency of a check.
# This is how the scheduled tier stays full-workspace.
#
# Set ANVIL_IMPACT=consume when an authoritative target/anvil/impact cache is
# already present and must be trusted verbatim -- e.g. a cloud-workflow group
# job that downloaded the impact artifact the impact job produced. In that
# mode anvil-impact does not snapshot or recompute (so it needs neither
# cargo-delta nor a fetched base ref, which group jobs lack); it asserts the
# downloaded include_<tier>.txt files are present -- failing loudly if any are
# missing -- and the checks read them directly. The cache also carries an
# optional doctest_packages.txt capability projection. Doc-test consumes it
# when present and falls back to one locked metadata query for caches produced
# by older catalogs or full-workspace paths that did not need package mapping.
# ANVIL_IMPACT_INPUT_DIR optionally selects a different read-only cache in
# consume mode, for example a checked-in fixture. Unset/empty uses the default
# target/anvil/impact directory. Computing impact never writes to this override.

export ANVIL_IMPACT_INVOCATION_ID := env_var_or_default('ANVIL_IMPACT_INVOCATION_ID', just_pid())

# Private. Produces cargo-delta snapshots with two independent cache keys:
#   * baseline.json  -- snapshot of the base ref. EXPENSIVE (needs a throwaway
#     git worktree). Keyed on the base commit sha, effective .delta.toml
#     identity, and pinned cargo-delta version (baseline.key stores
#     "<base-sha> <config-hash> <cargo-delta-version>"). A clean run stores
#     it under target/anvil/impact/snapshots/ and reuses it while fresh.
#   * current.json   -- snapshot of the working tree. Cheap. Keyed on
#     "<HEAD sha> <cargo-delta-version>" (current.key) for a clean tree.
#     Dirty local runs always snapshot the files on disk into a unique
#     target/anvil/impact-dirty/<generation>/snapshots/ directory and write no
#     current key. The completed generation is published through a selector
#     keyed by the Just invocation process id, plus an `active` inspection
#     selector. Generations remain immutable so concurrent invocations cannot
#     delete each other's producer or consumer inputs. Tool upgrades invalidate
#     cached clean snapshots so incompatible formats are never reused. If
#     .delta.toml itself is dirty,
#     the baseline is also rebuilt in the dirty generation so snapshots always
#     use one config.

# Snapshot the base ref and working tree for impact analysis.
[script("pwsh", "-NoProfile")]
_anvil-impact-snapshot impact_dir="":
    $ErrorActionPreference = 'Stop'
    $impactDirArgument = '{{ impact_dir }}'
    # Exit 2 (not the generic 1 used for operational failures below) marks
    # *invalid caller configuration*: an unrecognized ANVIL_IMPACT value is a
    # mistake in how the recipe was invoked, not a runtime failure of the work
    # it does. Keeping the two distinct lets a caller (or CI) tell a bad-mode
    # misconfiguration apart from a genuine snapshot/impact failure. All three
    # ANVIL_IMPACT readers (_anvil-impact-snapshot, anvil-impact,
    # _anvil-impact-include) use the same 2/1 split; keep them in sync.
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'off' -or $env:ANVIL_IMPACT -eq 'consume') { exit 0 }

    # A dirty local tree snapshots the current files on disk. target/ is
    # excluded because both clean and dirty impact products live there. Git
    # handles rename and case semantics through the pathspec.
    $dirtyChanges = @(git status --porcelain -- . ':(exclude)target/' | Where-Object { $_ })
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $dirty = $dirtyChanges.Count -gt 0
    $cloudCompute = ($env:GITHUB_ACTIONS -eq 'true') -or ($env:TF_BUILD -eq 'True')
    if ($dirty -and $cloudCompute) {
        Write-Error 'anvil-impact: cloud impact computation requires a clean working tree; restore or commit all checkout changes before running the impact job.'
        exit 1
    }

    $cleanImpactDir = 'target/anvil/impact'
    $impactDir = if (-not [string]::IsNullOrWhiteSpace($impactDirArgument)) {
        $impactDirArgument
    } elseif ($dirty) {
        Join-Path 'target/anvil/impact-dirty' ([System.Guid]::NewGuid().ToString('N'))
    } else {
        $cleanImpactDir
    }
    [System.IO.Directory]::CreateDirectory($impactDir) | Out-Null
    $deltaConfigDirty = $dirty -and (@(git status --porcelain -- .delta.toml | Where-Object { $_ }).Count -gt 0)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $baselineImpactDir = if ($deltaConfigDirty) { $impactDir } else { $cleanImpactDir }
    $baselineSnapDir = Join-Path $baselineImpactDir 'snapshots'
    $snapDir = Join-Path $impactDir 'snapshots'
    $baselineJson = Join-Path $baselineSnapDir 'baseline.json'
    $baselineKeyFile = Join-Path $baselineSnapDir 'baseline.key'
    $currentJson = Join-Path $snapDir 'current.json'
    $currentKeyFile = Join-Path $snapDir 'current.key'
    $noWorkspaceMarker = Join-Path $baselineSnapDir 'baseline-no-workspace'
    $generationSnapDir = Join-Path $impactDir 'snapshots'
    $generationBaselineJson = Join-Path $generationSnapDir 'baseline.json'
    $generationBaselineKey = Join-Path $generationSnapDir 'baseline.key'
    $generationNoWorkspaceMarker = Join-Path $generationSnapDir 'baseline-no-workspace'
    $workspacePath = (Get-Location).Path
    $workspaceHash = [Convert]::ToHexString(
        [System.Security.Cryptography.SHA256]::HashData(
            [System.Text.Encoding]::UTF8.GetBytes($workspacePath)
        )
    )
    $baselineMutex = [System.Threading.Mutex]::new($false, "anvil-impact-baseline-$workspaceHash")

    # Effective cargo-delta config identity -- part of the baseline cache key.
    # Resolve the repo's `.delta.toml` ONCE here, at the repo root, before the
    # fast path below and before any Push-Location into the base worktree.
    # (This probe -- like the one in anvil-impact -- is CWD-relative; it relies
    # on `just` invoking recipes at the repo root, which the generated Justfile
    # guarantees.) cargo-delta's default config lookup is `delta.toml` (no dot),
    # so a repo that uses `.delta.toml` must pass `--config` explicitly or every
    # snapshot/impact runs under cargo-delta's built-in defaults -- ignoring
    # file_exclude / [parser] / assume_patterns / trip_wire_patterns. All three
    # invocations (baseline snapshot, current snapshot, impact) share this one
    # `$deltaArgs`.
    #
    # Because that config governs WHAT every snapshot captures, it is part of
    # the baseline's identity: editing `.delta.toml` (or adding/removing it)
    # must invalidate the baseline exactly like a moved base ref would.
    # Otherwise a warm local cache keyed on the base sha alone would keep an
    # old-config baseline while the current snapshot -- regenerated because the
    # committed config edit moved HEAD -- is captured under the new config, and
    # `cargo delta impact` would then diff two snapshots taken under different
    # rules and silently mis-scope. So hash the resolved config (or mark its
    # absence) and fold it into the composite baseline key alongside the base
    # sha and pinned cargo-delta version
    # below (which also flows into anvil-impact's projection cache via
    # baseline.key). Absent a config file, `$deltaArgs` stays empty and the id
    # is `<none>`, so adopters without a `.delta.toml` are unaffected.
    #
    # anvil manages `.delta.toml` (the anvil-delta artifact owns its
    # trip_wire_patterns region), so in an anvil-managed repo the file should
    # exist whenever this impact recipe does. Its absence means cargo-delta runs
    # under defaults with trip wires + file_exclude OFF, which can silently
    # UNDER-scope -- the opposite of what trip wires exist to prevent. Every
    # neighbouring precondition here (missing base ref, shallow clone) is a hard
    # error; failing open on this one alone would be surprising, so warn loudly.
    # We warn rather than fail because a repo may legitimately opt out of the
    # `.delta.toml` region; the warning surfaces the reduced coverage without
    # blocking. (anvil-impact re-probes but stays silent: this dependency
    # recipe always runs first, so one warning per compute is enough.)
    $deltaArgs = @()
    $deltaConfigId = '<none>'
    if (Test-Path '.delta.toml') {
        $deltaConfigPath = (Resolve-Path '.delta.toml').Path
        $deltaArgs = @('--config', $deltaConfigPath)
        # SHA-256 is an arbitrary but stable choice: the key only needs a
        # deterministic content fingerprint to detect config edits, not any
        # cryptographic property. Get-FileHash defaults to SHA-256, so this
        # avoids pulling in another algorithm. Changing it only invalidates
        # already-cached baselines (they recompute once); it is not a contract.
        $deltaConfigId = (Get-FileHash -LiteralPath $deltaConfigPath -Algorithm SHA256).Hash
    } else {
        [Console]::Error.WriteLine("anvil-impact: warning: no .delta.toml found at the repo root; cargo-delta will run under its defaults (trip_wire_patterns and file_exclude_patterns inactive), which can under-scope the impact set. Restore the anvil-managed .delta.toml to get conservative scoping.")
    }

    # Only a clean tree corresponds exactly to HEAD. Include the pinned
    # cargo-delta version in the clean current key without invoking the tool,
    # so an upgrade invalidates old snapshot formats. target/ changes do not
    # perturb this key.
    $currentState = "$((git rev-parse HEAD).Trim()) {{ cargo_delta_version }}"

    # Consumer fast path: reuse an already-present, matching snapshot set
    # WITHOUT cargo-delta or a fetched base ref -- this short-circuits a local
    # repeat run when nothing changed. (The cloud-workflow consume path never
    # reaches here: ANVIL_IMPACT=consume returned at the guard above and trusts
    # the downloaded artifact verbatim -- anvil-impact asserts its presence
    # before any scoped check reads it.) We still detect a moved base ref when
    # it is cheaply resolvable (best effort). If the base cannot be resolved
    # $baseSha stays $null, the baseline is treated as not fresh, and we fall
    # through to the recompute path, which fails fast with git-fetch guidance
    # rather than scoping against a stale baseline.
    $currentFresh = (-not $dirty) -and (Test-Path $currentJson) -and (Test-Path $currentKeyFile) -and `
        ("$(Get-Content -Raw $currentKeyFile)".Trim() -eq $currentState)
    $baseSha = $null
    $base = (& "{{ just_executable() }}" _anvil-base-ref 2>$null)
    if (($LASTEXITCODE -eq 0) -and $base) {
        $base = ($base | Select-Object -First 1).Trim()
        git rev-parse --verify "$base^{commit}" 2>$null | Out-Null
        if ($LASTEXITCODE -eq 0) { $baseSha = (git rev-parse $base).Trim() }
    }
    # A moved base ref, changed config, or tool upgrade invalidates the
    # baseline, so it is never reused across incompatible rules or formats.
    $baselineKey = "$baseSha $deltaConfigId {{ cargo_delta_version }}"
    $baselineFresh = (-not $deltaConfigDirty) -and (Test-Path $baselineKeyFile) -and `
        ((Test-Path $baselineJson) -or (Test-Path $noWorkspaceMarker)) -and `
        ("$(Get-Content -Raw $baselineKeyFile)".Trim() -eq $baselineKey)
    if ($currentFresh -and $baselineFresh) {
        Write-Host 'anvil-impact: snapshots up to date'
        exit 0
    }

    # --- (Re)compute path: this is the only path that needs cargo-delta and a
    # resolvable base ref (the impact job in cloud workflows, or a local first
    # run / cache miss). ---
    # cargo-delta is validated here -- inside the recompute path, after the
    # off/consume guard and the fast path -- rather than as a hard `just`
    # dependency of `anvil-impact`. Only recompute needs the tool; the paths
    # that skip it (ANVIL_IMPACT=off/consume, or a cache hit) must be able to
    # no-op without it. Groups that can actually reach recompute declare
    # cargo-delta as their own setup prereq (see groups/*.just), so a local
    # `just anvil-<group>` still fails fast if it is missing; keeping it off
    # anvil-impact's dependency line is what lets the no-op paths stay
    # tool-agnostic.
    & "{{ just_executable() }}" anvil-tool-cargo-delta-validate-prereqs
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    [System.IO.Directory]::CreateDirectory($baselineSnapDir) | Out-Null
    [System.IO.Directory]::CreateDirectory($snapDir) | Out-Null

    # The best-effort base-ref resolution above may have left `$baseSha` unset
    # (unresolvable ref, or a `just`/git hiccup). Recompute cannot proceed
    # without it, so resolve with fail-fast diagnostics now. We deliberately do
    # NOT `git fetch`: mutating git state as a side effect of a build check is
    # surprising and can race the user's own git operations.
    if (-not $baseSha) {
        $base = (& "{{ just_executable() }}" _anvil-base-ref)
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        $base = $base.Trim()
        git rev-parse --verify "$base^{commit}" 2>$null | Out-Null
        if ($LASTEXITCODE -ne 0) {
            $branch = ($base -replace '^origin/', '')
            Write-Error "anvil-impact: base ref '$base' not found locally. Run ``git fetch origin $branch`` and retry."
            exit 1
        }
        $baseSha = (git rev-parse $base).Trim()
    }
    if ((git rev-parse --is-shallow-repository) -eq 'true') {
        Write-Error 'anvil-impact: shallow clone detected; cargo-delta needs full history for the base ref. Run ``git fetch --unshallow`` and retry.'
        exit 1
    }
    if ($dirty) {
        Set-Content -LiteralPath (Join-Path $impactDir 'base.sha') -Value $baseSha -Encoding UTF8 -NoNewline
    }

    # --- Baseline snapshot: only when the base sha, config, or tool changed. ---
    # Re-derive the composite key now that `$baseSha` is authoritatively
    # resolved (the fast-path value above may have been $null on a cache miss).
    $baselineKey = "$baseSha $deltaConfigId {{ cargo_delta_version }}"
    $haveBaseline = (Test-Path $baselineKeyFile) -and `
        ("$(Get-Content -Raw $baselineKeyFile)".Trim() -eq $baselineKey) -and `
        ((Test-Path $baselineJson) -or (Test-Path $noWorkspaceMarker))
    if ($haveBaseline) {
        Write-Host "anvil-impact: baseline snapshot up to date (base $baseSha)"
    } else {
        Write-Host "anvil-impact: snapshotting baseline at $base ($baseSha)"
        # The baseline worktree is checked out at the merge target, whose
        # rust-toolchain.toml may pin a toolchain that is NOT installed on this
        # machine (any PR that bumps rust-toolchain.toml hits this). The
        # snapshot is metadata-only (file presence + content hashes), so use
        # the selected compiler from the current checkout to override any
        # different toolchain file in the baseline worktree. Environment/MSRV
        # selections are already valid rustup overrides. For a selecting
        # toolchain file, use the selected rustc sysroot as an unambiguous path
        # toolchain.
        $stableArgs = {{_anvil_stable_toolchain_args}}
        $baselineToolchain = if (-not [string]::IsNullOrWhiteSpace($env:RUSTUP_TOOLCHAIN)) {
            $env:RUSTUP_TOOLCHAIN.Trim()
        } elseif ($stableArgs.Count -eq 1) {
            ([string] $stableArgs[0]).Substring(1)
        } else {
            $sysroot = @(& rustc --print sysroot)
            if ($LASTEXITCODE -ne 0 -or $sysroot.Count -ne 1 -or [string]::IsNullOrWhiteSpace([string] $sysroot[0])) {
                Write-Error 'anvil-impact: rustc could not report the current checkout stable toolchain sysroot'
                exit 1
            }
            ([string] $sysroot[0]).Trim()
        }

        # Temp-root precedence follows the runner-managed scratch dir on each
        # host: RUNNER_TEMP on GitHub Actions, AGENT_TEMPDIRECTORY on Azure
        # Pipelines -- both are job-owned and cleaned up by the runner, so the
        # throwaway worktree never leaks into the workspace or survives the job.
        # Local runs fall back to the system temp dir. A fresh nonce prevents
        # collisions with abandoned directories when the OS reuses a PID.
        $tmpRoot = $env:RUNNER_TEMP
        if (-not $tmpRoot) { $tmpRoot = $env:AGENT_TEMPDIRECTORY }
        if (-not $tmpRoot) { $tmpRoot = [System.IO.Path]::GetTempPath() }
        $wt = Join-Path $tmpRoot "anvil-baseline-$PID-$([System.Guid]::NewGuid().ToString('N'))"
        # GIT_LFS_SKIP_SMUDGE=1: the worktree inherits the repo config but not
        # the credential helper, so LFS smudge would fail. cargo-delta only
        # needs file content hashes; LFS pointer files hash consistently.
        $env:GIT_LFS_SKIP_SMUDGE = '1'
        $baselineFailed = $false
        $baselineNoWorkspace = $false
        $baseSnap = $null
        try {
            $worktreeOutput = @(git worktree add --detach $wt $baseSha 2>&1)
            if ($LASTEXITCODE -ne 0) {
                throw "anvil-impact: failed to create baseline worktree at ${wt}: $($worktreeOutput -join [Environment]::NewLine)"
            }
            if (-not (Test-Path (Join-Path $wt 'Cargo.toml'))) {
                # First-time anvil adoption: the base predates the cargo
                # workspace (no root Cargo.toml), so there is nothing for
                # cargo-delta to snapshot. Record a marker; anvil-impact falls
                # back to full-workspace validation rather than failing.
                Write-Host "anvil-impact: base '$base' has no root Cargo.toml (first-time adoption?); falling back to full-workspace"
                $baselineNoWorkspace = $true
            } else {
                Push-Location $wt
                # Override only this baseline subprocess scope, then restore the
                # caller's input override before returning to the current tree.
                $hadToolchain = Test-Path Env:\RUSTUP_TOOLCHAIN
                $priorToolchain = if ($hadToolchain) { $env:RUSTUP_TOOLCHAIN } else { $null }
                try {
                    $env:RUSTUP_TOOLCHAIN = $baselineToolchain
                    $baseSnap = cargo delta @deltaArgs snapshot
                    if ($LASTEXITCODE -ne 0) { throw 'cargo delta snapshot (baseline) failed' }
                } finally {
                    if ($hadToolchain) {
                        $env:RUSTUP_TOOLCHAIN = $priorToolchain
                    } else {
                        Remove-Item Env:\RUSTUP_TOOLCHAIN -ErrorAction SilentlyContinue
                    }
                    Pop-Location
                }
            }
        } catch {
            $baselineFailed = $true
            throw
        } finally {
            $cleanupFailures = [System.Collections.Generic.List[string]]::new()
            $worktreeOutput = @(git worktree list --porcelain -z)
            $listFailed = $LASTEXITCODE -ne 0
            if ($listFailed) {
                $cleanupFailures.Add("failed to list worktrees: $($worktreeOutput -join [Environment]::NewLine)")
            }
            $worktrees = if ($listFailed) { @() } else { ($worktreeOutput -join "`n").Split([char] 0) }
            $registeredPath = 'worktree ' + $wt.Replace([System.IO.Path]::DirectorySeparatorChar, [char] '/')
            if ($listFailed -or $worktrees -contains $registeredPath) {
                $cleanupOutput = @(git worktree remove --force --force $wt 2>&1)
                if ($LASTEXITCODE -ne 0) {
                    $cleanupFailures.Add("failed to remove baseline worktree at ${wt}: $($cleanupOutput -join [Environment]::NewLine)")
                }
            }
            try {
                if (Test-Path -LiteralPath $wt) {
                    Remove-Item -LiteralPath $wt -Recurse -Force -ErrorAction Stop
                }
            } catch {
                $cleanupFailures.Add("failed to remove baseline directory at ${wt}: $($_.Exception.Message)")
            }
            if ($cleanupFailures.Count -gt 0) {
                $cleanupMessage = "anvil-impact: baseline cleanup failed: $($cleanupFailures -join '; ')"
                if ($baselineFailed) {
                    Write-Warning -Message $cleanupMessage -WarningAction Continue
                } else {
                    throw $cleanupMessage
                }
            }
        }

        # Publish baseline cache files only after the snapshot succeeds. A
        # workspace-wide mutex serializes replacement for concurrent local
        # invocations, while dirty runs copy their selected baseline into the
        # immutable generation before releasing it.
        if (-not $baselineNoWorkspace -and -not $baseSnap) {
            throw 'cargo-delta did not produce a baseline snapshot'
        }
        try {
            [void]$baselineMutex.WaitOne()
            if ($baselineNoWorkspace) {
                Remove-Item -LiteralPath $baselineJson -ErrorAction SilentlyContinue
                New-Item -ItemType File -Path $noWorkspaceMarker -Force | Out-Null
                if ($dirty) {
                    New-Item -ItemType File -Path $generationNoWorkspaceMarker -Force | Out-Null
                    Remove-Item -LiteralPath $generationBaselineJson -ErrorAction SilentlyContinue
                }
            } else {
                Set-Content -LiteralPath $baselineJson -Value $baseSnap -Encoding UTF8
                Remove-Item -LiteralPath $noWorkspaceMarker -ErrorAction SilentlyContinue
                if ($dirty) {
                    Set-Content -LiteralPath $generationBaselineJson -Value $baseSnap -Encoding UTF8
                    Remove-Item -LiteralPath $generationNoWorkspaceMarker -ErrorAction SilentlyContinue
                }
            }
            Set-Content -LiteralPath $baselineKeyFile -Value $baselineKey -Encoding UTF8 -NoNewline
            if ($dirty) {
                Set-Content -LiteralPath $generationBaselineKey -Value $baselineKey -Encoding UTF8 -NoNewline
            }
        } finally {
            $baselineMutex.ReleaseMutex()
        }
    }
    if ($dirty -and $haveBaseline) {
        try {
            [void]$baselineMutex.WaitOne()
            $actualKey = "$(Get-Content -Raw -LiteralPath $baselineKeyFile)".Trim()
            if ($actualKey -ne $baselineKey) {
                Write-Error "anvil-impact: baseline '$base' changed while publishing dirty impact; rerun the command."
                exit 1
            }
            if (Test-Path -LiteralPath $noWorkspaceMarker -PathType Leaf) {
                New-Item -ItemType File -Path $generationNoWorkspaceMarker -Force | Out-Null
            } else {
                Copy-Item -LiteralPath $baselineJson -Destination $generationBaselineJson -Force
            }
            Set-Content -LiteralPath $generationBaselineKey -Value $baselineKey -Encoding UTF8 -NoNewline
        } finally {
            $baselineMutex.ReleaseMutex()
        }
    }

    # --- Current snapshot: clean content is cached by HEAD, while dirty
    # content is always captured fresh from the filesystem. ---
    $haveCurrent = (-not $dirty) -and (Test-Path $currentJson) -and (Test-Path $currentKeyFile) -and `
        ("$(Get-Content -Raw $currentKeyFile)".Trim() -eq $currentState)
    if ($haveCurrent) {
        Write-Host 'anvil-impact: current snapshot up to date'
    } else {
        if ($dirty) {
            Write-Host 'anvil-impact: snapshotting dirty working tree'
        } else {
            Write-Host 'anvil-impact: snapshotting working tree'
        }
        $curSnap = & cargo {{_anvil_stable_toolchain_args}} delta @deltaArgs snapshot
        if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-impact: cargo delta snapshot (current) failed'; exit 1 }
        Set-Content -LiteralPath $currentJson -Value $curSnap -Encoding UTF8
        if (-not $dirty) {
            Set-Content -LiteralPath $currentKeyFile -Value $currentState -Encoding UTF8 -NoNewline
        }
    }

# Public. Computes the impact set from the two snapshots and projects each
# tier into a pre-built `--package name@version ...` string (or the sentinel
# `--skip` when the tier is empty) via the shared _anvil-impact-format
# helper, written to include_<tier>.txt. Per-crate checks depend on this
# recipe and read those files via _anvil-impact-include. Clean projections
# are cached; dirty local projections are always recomputed.

# Compute the impact set and write its clean cache or dirty local output.
[group("anvil")]
[script("pwsh", "-NoProfile")]
anvil-impact:
    $ErrorActionPreference = 'Stop'
    if ($env:ANVIL_IMPACT_INVOCATION_ID -notmatch '^\d+$') {
        Write-Error "anvil-impact: ANVIL_IMPACT_INVOCATION_ID must be a numeric Just process id"
        exit 2
    }
    # Exit 2 = invalid caller configuration (bad ANVIL_IMPACT), distinct from
    # the generic 1 used for operational failures -- see _anvil-impact-snapshot.
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'off') { exit 0 }
    if ($env:ANVIL_IMPACT -eq 'consume') {
        $inputDir = if ($env:ANVIL_IMPACT_INPUT_DIR) { $env:ANVIL_IMPACT_INPUT_DIR } else { 'target/anvil/impact' }
        # consume = trust an already-downloaded cache verbatim, so assert the
        # cache is actually present. If the CI download ever stops landing at
        # target/anvil/impact/ (renamed artifact, a missing download step, or
        # an adopter invoking the group action directly), every scoped check
        # would otherwise silently widen to --workspace and the pipeline would
        # stay green. Fail loudly instead. (Presence only -- freshness stays a
        # deliberate non-goal in consume mode.)
        $missing = @('modified', 'affected', 'required') |
            Where-Object { -not (Test-Path -LiteralPath (Join-Path $inputDir "include_$_.txt") -PathType Leaf) }
        if ($missing.Count -gt 0) {
            Write-Error "anvil-impact: ANVIL_IMPACT=consume but the input impact cache is missing ($($missing -join ', ') include file(s) absent under $inputDir). A complete cache holds include_modified.txt, include_affected.txt and include_required.txt. The read directory is ANVIL_IMPACT_INPUT_DIR when set, otherwise target/anvil/impact -- check that variable if the path above is not where you expected. Supply a complete impact cache before scoped checks run."
            exit 1
        }
        exit 0
    }

    $dirtyChanges = @(git status --porcelain -- . ':(exclude)target/' | Where-Object { $_ })
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $dirty = $dirtyChanges.Count -gt 0
    $cloudCompute = ($env:GITHUB_ACTIONS -eq 'true') -or ($env:TF_BUILD -eq 'True')
    if ($dirty -and $cloudCompute) {
        Write-Error 'anvil-impact: cloud impact computation requires a clean working tree; restore or commit all checkout changes before running the impact job.'
        exit 1
    }
    $cleanImpactDir = 'target/anvil/impact'
    $dirtyImpactRoot = 'target/anvil/impact-dirty'
    $impactDir = if ($dirty) {
        Join-Path $dirtyImpactRoot ([System.Guid]::NewGuid().ToString('N'))
    } else {
        $cleanImpactDir
    }
    $workspaceHash = [Convert]::ToHexString(
        [System.Security.Cryptography.SHA256]::HashData(
            [System.Text.Encoding]::UTF8.GetBytes((Get-Location).Path)
        )
    )
    $publicationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-publication-$workspaceHash")
    if (-not $dirty) {
        try {
            [void]$publicationMutex.WaitOne()
            if (Test-Path -LiteralPath $dirtyImpactRoot -PathType Container) {
                Get-ChildItem -LiteralPath $dirtyImpactRoot -File -Filter 'active*' -ErrorAction SilentlyContinue |
                    Remove-Item -Force -ErrorAction Stop
            }
        } finally {
            $publicationMutex.ReleaseMutex()
        }
    } else {
        $invocationMarker = Join-Path $dirtyImpactRoot "active-$env:ANVIL_IMPACT_INVOCATION_ID"
    }
    & "{{ just_executable() }}" _anvil-impact-snapshot $impactDir
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    if ($dirty) {
        $publishDirty = {
            try {
                [void]$publicationMutex.WaitOne()
                [System.IO.Directory]::CreateDirectory($dirtyImpactRoot) | Out-Null
                foreach ($marker in @($invocationMarker, (Join-Path $dirtyImpactRoot 'active'))) {
                    $pendingMarker = Join-Path $dirtyImpactRoot "pending-$([System.Guid]::NewGuid().ToString('N'))"
                    Set-Content -LiteralPath $pendingMarker -Value $impactDir -Encoding UTF8 -NoNewline
                    [System.IO.File]::Move($pendingMarker, $marker, $true)
                }

                $activeGenerations = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
                foreach ($marker in @(Get-ChildItem -LiteralPath $dirtyImpactRoot -File -Filter 'active*' -ErrorAction SilentlyContinue)) {
                    if ($marker.Name -match '^active-(\d+)$') {
                        $invocationProcess = Get-Process -Id ([int]$Matches[1]) -ErrorAction SilentlyContinue
                        if (-not $invocationProcess) {
                            Remove-Item -LiteralPath $marker.FullName -Force -ErrorAction Stop
                            continue
                        }
                    }
                    $markerGeneration = "$(Get-Content -Raw -LiteralPath $marker.FullName)".Trim()
                    if ($markerGeneration) {
                        [void]$activeGenerations.Add((Resolve-Path -LiteralPath $markerGeneration).Path)
                    }
                }

                # Eight is intentionally generous relative to the tiny local
                # cache cost and keeps cleanup bounded without thrashing.
                $completedGenerations = @(Get-ChildItem -LiteralPath $dirtyImpactRoot -Directory -ErrorAction SilentlyContinue |
                    Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'complete') -PathType Leaf } |
                    Sort-Object -Property LastWriteTimeUtc -Descending)
                foreach ($oldGeneration in @($completedGenerations | Select-Object -Skip 8)) {
                    if ($activeGenerations.Contains($oldGeneration.FullName)) { continue }
                    $generationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-generation-$($oldGeneration.Name)")
                    $locked = $false
                    try {
                        $locked = $generationMutex.WaitOne(0)
                        if ($locked -and (Test-Path -LiteralPath $oldGeneration.FullName -PathType Container)) {
                            Remove-Item -LiteralPath $oldGeneration.FullName -Recurse -Force -ErrorAction Stop
                        }
                    } catch [System.UnauthorizedAccessException] {
                        # Leave the generation for a later cleanup pass.
                    } catch [System.IO.IOException] {
                        # Leave the generation for a later cleanup pass.
                    } finally {
                        if ($locked) { $generationMutex.ReleaseMutex() }
                        $generationMutex.Dispose()
                    }
                }
            } finally {
                $publicationMutex.ReleaseMutex()
            }
        }
    }
    $deltaConfigDirty = $dirty -and (@(git status --porcelain -- .delta.toml | Where-Object { $_ }).Count -gt 0)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $baselineImpactDir = if ($dirty) { $impactDir } else { $cleanImpactDir }
    $snapDir = Join-Path $impactDir 'snapshots'
    $baselineSnapDir = Join-Path $baselineImpactDir 'snapshots'
    $baselineJson = Join-Path $baselineSnapDir 'baseline.json'
    $currentJson = Join-Path $snapDir 'current.json'
    $baselineKeyFile = Join-Path $baselineSnapDir 'baseline.key'
    $currentKeyFile = Join-Path $snapDir 'current.key'
    $impactJson = Join-Path $impactDir 'impact.json'
    $impactStateFile = Join-Path $impactDir 'impact.state'
    $doctestPackages = Join-Path $impactDir 'doctest_packages.txt'

    if ($dirty) {
        Write-Host "anvil-impact: using fresh impact for $($dirtyChanges.Count) uncommitted change(s) in the local working tree" -ForegroundColor Yellow
    }

    # Clean runs key the projection on both clean snapshot markers. Dirty runs
    # intentionally skip this cache and always compare the fresh disk snapshot
    # with the baseline selected by _anvil-impact-snapshot.
    $includeFiles = @('modified', 'affected', 'required') | ForEach-Object { Join-Path $impactDir "include_$_.txt" }
    $wantState = $null
    if (-not $dirty) {
        $wantState = ("$(Get-Content -Raw $baselineKeyFile)".Trim()) + ' ' + ("$(Get-Content -Raw $currentKeyFile)".Trim())
        $fresh = (Test-Path $impactJson) -and (Test-Path $impactStateFile) -and `
            ("$(Get-Content -Raw $impactStateFile)".Trim() -eq $wantState) -and `
            (@($includeFiles | Where-Object { -not (Test-Path $_) }).Count -eq 0) -and `
            (Test-Path -LiteralPath $doctestPackages -PathType Leaf)
        if ($fresh) {
            Write-Host 'anvil-impact: impact set up to date (cache hit)'
            exit 0
        }
    }

    # First-time anvil adoption: the base predates the cargo workspace, so
    # there is no baseline to diff against. Fall back to full-workspace
    # validation -- modified runs unconditionally (empty), affected/required
    # default to --workspace -- rather than failing the impact computation.
    if (Test-Path (Join-Path $baselineSnapDir 'baseline-no-workspace')) {
        Write-Host 'anvil-impact: baseline has no workspace; defaulting all tiers to full-workspace'
        Set-Content -LiteralPath (Join-Path $impactDir 'include_modified.txt') -Value '' -Encoding UTF8 -NoNewline
        Set-Content -LiteralPath (Join-Path $impactDir 'include_affected.txt') -Value '--workspace' -Encoding UTF8 -NoNewline
        Set-Content -LiteralPath (Join-Path $impactDir 'include_required.txt') -Value '--workspace' -Encoding UTF8 -NoNewline
        Set-Content -LiteralPath $impactJson -Value '{}' -Encoding UTF8
        if (-not $dirty) {
            Set-Content -LiteralPath $impactStateFile -Value $wantState -Encoding UTF8 -NoNewline
        }
        Remove-Item -LiteralPath $doctestPackages -ErrorAction SilentlyContinue
        if ($dirty) {
            New-Item -ItemType File -Path (Join-Path $impactDir 'complete') -Force | Out-Null
            & $publishDirty
        }
        exit 0
    }

    # Resolve the repo's cargo-delta config for `cargo delta impact` below. This
    # recipe is a separate pwsh script from `_anvil-impact-snapshot`, so it does
    # not inherit that recipe's `$deltaArgs`; resolve it again here (at the repo
    # root) so the impact diff honors `.delta.toml` (e.g. trip_wire_patterns).
    $deltaArgs = @()
    if (Test-Path '.delta.toml') { $deltaArgs = @('--config', (Resolve-Path '.delta.toml').Path) }

    # Full impact JSON -- the durable source of truth. When no files changed
    # between baseline and current the impact set is empty, which cargo-delta
    # reports either as a report with empty tiers or by printing nothing at
    # all (it "quits" early). Store an empty object for that blank output so
    # impact.json always exists -- the freshness check above keys on its
    # presence, and a missing file would force a recompute on every
    # invocation.
    $impactOut = (& cargo {{_anvil_stable_toolchain_args}} delta @deltaArgs impact --baseline $baselineJson --current $currentJson --format json | Out-String)
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-impact: cargo delta impact failed'; exit 1 }
    if ([string]::IsNullOrWhiteSpace($impactOut)) { $impactOut = '{}' }
    Set-Content -LiteralPath $impactJson -Value $impactOut.Trim() -Encoding UTF8

    # Project each tier into its `--package name@version ...` / `--skip`
    # string via the shared formatter (version-qualified workspace-member
    # specs live there, used identically by the cloud impact steps).
    foreach ($tier in @('modified', 'affected', 'required')) {
        $value = (& "{{ just_executable() }}" _anvil-impact-format $tier $impactJson)
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        Set-Content -LiteralPath (Join-Path $impactDir "include_$tier.txt") -Value $value.Trim() -Encoding UTF8 -NoNewline
        Write-Host "anvil-impact: $tier -> $($value.Trim())"
    }
    if (-not $dirty) {
        Set-Content -LiteralPath $impactStateFile -Value $wantState -Encoding UTF8 -NoNewline
    } else {
        New-Item -ItemType File -Path (Join-Path $impactDir 'complete') -Force | Out-Null
        & $publishDirty
    }

# _anvil-impact-format: turns a cargo-delta impact report into the
# `--package <spec> ...` string the scoped checks consume, projected per
# tier into include_<tier>.txt by `anvil-impact` above -- its only caller,
# next to which it now lives (impact analysis stays in one place).
#
# Arguments:
#   tier       - one of "modified" / "affected" / "required". Selected
#                from the cargo-delta JSON (which uses TitleCase keys).
#   impactJson - path to the file the caller produced via
#                `cargo delta impact --format json`.
#
# Output (stdout, exactly one line so the caller can capture it):
#   * "--package name@version --package name2@version2 ..." when the
#     tier has members. Each package is a version-qualified cargo spec:
#     the version (read from locked `cargo metadata --no-deps` and intersected
#     with workspace_members) disambiguates a workspace member from a like-named
#     transitive dependency pulled in at a different version, which a
#     bare `-p name` cannot do ("multiple packages named name").
#   * "--skip" when the tier is empty (recipes treat this as a no-op).
# Metadata failures and unknown package names are written to
# STDERR and fail the recipe, so callers never continue with an incomplete
# package set (which would silently under-scope and skip a check).
#
# Why pwsh + ConvertFrom-Json rather than jq + read: cargo-delta and
# cargo-metadata both emit JSON, and parsing structured data through a
# tab-delimited `IFS` read is fragile -- e.g. tab is an IFS-whitespace
# character, so an empty interior field (a package with no lib target)
# coalesces with its delimiters and silently shifts every later field.
# Working with objects sidesteps that entire class of bug.
#
# Usage:
#   pwsh : $val = (& "{{ just_executable() }}" _anvil-impact-format affected $impactJson)
[script("pwsh", "-NoProfile")]
_anvil-impact-format tier impactJson:
    $ErrorActionPreference = 'Stop'
    $tier = '{{tier}}'
    $impactJson = '{{impactJson}}'
    # cargo-delta keys its impact tiers in TitleCase.
    $tierKey = switch ($tier) {
        'modified' { 'Modified' }
        'affected' { 'Affected' }
        'required' { 'Required' }
        default {
            Write-Error "anvil-impact: unknown tier '$tier' (expected modified/affected/required)"
            exit 1
        }
    }
    # cargo-delta JSON reports Cargo package names. Library target names and
    # manifest directory leaves are not aliases: they can name a different
    # workspace package.
    $metadataJson = & cargo {{_anvil_stable_toolchain_args}} metadata --locked --no-deps --format-version 1
    $metadataExit = $LASTEXITCODE
    if ($metadataExit -ne 0) {
        [Console]::Error.WriteLine('anvil-impact: cargo metadata failed')
        exit $metadataExit
    }
    try {
        $meta = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-impact: could not parse cargo metadata output: $_"
        exit 1
    }
    # Preserve exact package-name casing instead of using PowerShell's default
    # case-insensitive hashtables.
    $byName = [System.Collections.Generic.Dictionary[string, object]]::new([System.StringComparer]::Ordinal)
    $workspaceIds = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
    foreach ($id in $meta.workspace_members) { [void]$workspaceIds.Add("$id") }
    $workspacePackages = @($meta.packages | Where-Object { $workspaceIds.Contains("$($_.id)") })
    if ($tier -eq 'modified') {
        $doctestSpecs = [string[]]@(
            $workspacePackages |
                Where-Object { $_.targets | Where-Object { $_.doctest -eq $true } } |
                ForEach-Object { "$($_.name)@$($_.version)" }
        )
        [Array]::Sort($doctestSpecs, [System.StringComparer]::Ordinal)
        $doctestFile = Join-Path (Split-Path $impactJson -Parent) 'doctest_packages.txt'
        Set-Content -LiteralPath $doctestFile -Value ($doctestSpecs -join "`n") -Encoding UTF8 -NoNewline
    }
    foreach ($p in $workspacePackages) {
        $byName[$p.name] = $p
    }
    $impact = Get-Content -LiteralPath $impactJson -Raw | ConvertFrom-Json
    $names = @($impact.$tierKey)
    $specs = [System.Collections.Generic.List[string]]::new()
    foreach ($name in $names) {
        if ([string]::IsNullOrWhiteSpace($name)) { continue }
        if (-not $byName.ContainsKey($name)) {
            Write-Error "anvil-impact: cargo-delta returned unknown package '$name' in the $tier set. Re-run with ANVIL_IMPACT=off to proceed unscoped, and report the unmapped identifier."
            exit 1
        }
        $p = $byName[$name]
        $specs.Add("--package $($p.name)@$($p.version)")
    }
    if ($specs.Count -eq 0) {
        Write-Output '--skip'
    } else {
        Write-Output ($specs -join ' ')
    }

# Private. Returns the workspace-member package specs with at least one Cargo
# target marked doctest=true. Prefer the projection written while impact
# metadata was already in memory; fall back to one locked metadata query when
# impact is disabled, the baseline lacks a workspace, or an older cache is consumed.
#
# Output is one space-delimited line of name@version specs, sorted ordinally.

# Resolve workspace doctest capability from the impact cache.
[script("pwsh", "-NoProfile")]
_anvil-impact-doctest-packages:
    $ErrorActionPreference = 'Stop'
    if ($env:ANVIL_IMPACT_INVOCATION_ID -notmatch '^\d+$') {
        Write-Error "anvil-impact: ANVIL_IMPACT_INVOCATION_ID must be a numeric Just process id"
        exit 2
    }
    $selectedContent = $null
    $selectedFileFound = $false
    $dirtyGenerationSelected = $false
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'consume' -and $env:ANVIL_IMPACT_INPUT_DIR) {
        $inputDir = $env:ANVIL_IMPACT_INPUT_DIR
    } elseif ($env:ANVIL_IMPACT -eq 'off') {
        $inputDir = 'target/anvil/impact'
    } elseif ($env:ANVIL_IMPACT -eq 'consume') {
        $inputDir = 'target/anvil/impact'
    } else {
        $activeMarker = Join-Path 'target/anvil/impact-dirty' "active-$env:ANVIL_IMPACT_INVOCATION_ID"
        if (Test-Path -LiteralPath $activeMarker -PathType Leaf) {
            $workspaceHash = [Convert]::ToHexString(
                [System.Security.Cryptography.SHA256]::HashData(
                    [System.Text.Encoding]::UTF8.GetBytes((Get-Location).Path)
                )
            )
            $publicationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-publication-$workspaceHash")
            try {
                [void]$publicationMutex.WaitOne()
                if (Test-Path -LiteralPath $activeMarker -PathType Leaf) {
                    $selectedDir = "$(Get-Content -Raw -LiteralPath $activeMarker)".Trim()
                    $dirtyGenerationSelected = $true
                    $generationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-generation-$(Split-Path $selectedDir -Leaf)")
                    try {
                        [void]$generationMutex.WaitOne()
                        $completeFile = Join-Path $selectedDir 'complete'
                        $baseFile = Join-Path $selectedDir 'base.sha'
                        if (-not (Test-Path -LiteralPath $completeFile -PathType Leaf) -or
                            -not (Test-Path -LiteralPath $baseFile -PathType Leaf)) {
                            Write-Error "anvil-impact: dirty impact selector is stale ($activeMarker)"
                            exit 1
                        }
                        $candidateFile = Join-Path $selectedDir 'doctest_packages.txt'
                        if (Test-Path -LiteralPath $candidateFile -PathType Leaf) {
                            $selectedFileFound = $true
                            $selectedContent = "$(Get-Content -Raw -LiteralPath $candidateFile)"
                        }
                    } finally {
                        $generationMutex.ReleaseMutex()
                        $generationMutex.Dispose()
                    }
                }
            } finally {
                $publicationMutex.ReleaseMutex()
                $publicationMutex.Dispose()
            }
            if (-not $dirtyGenerationSelected) {
                Write-Error "anvil-impact: no dirty impact generation selector for this Just invocation ($activeMarker)"
                exit 1
            }
            $inputDir = $selectedDir
        } else {
            $inputDir = 'target/anvil/impact'
        }
    }
    $file = Join-Path $inputDir 'doctest_packages.txt'
    if ($selectedFileFound) {
        $specs = @($selectedContent -split "`n" | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
        Write-Output ($specs -join ' ')
        exit 0
    }
    if (-not $dirtyGenerationSelected -and $env:ANVIL_IMPACT -ne 'off' -and (Test-Path -LiteralPath $file -PathType Leaf)) {
        $specs = @(Get-Content -LiteralPath $file | Where-Object { -not [string]::IsNullOrWhiteSpace($_) })
        Write-Output ($specs -join ' ')
        exit 0
    }
    $metadataJson = & cargo {{_anvil_stable_toolchain_args}} metadata --locked --no-deps --format-version 1
    $metadataExit = $LASTEXITCODE
    if ($metadataExit -ne 0) {
        [Console]::Error.WriteLine('anvil-doc-test: cargo metadata failed')
        exit $metadataExit
    }
    try {
        $meta = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-doc-test: could not parse cargo metadata output: $_"
        exit 1
    }
    $workspaceIds = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
    foreach ($id in $meta.workspace_members) { [void]$workspaceIds.Add("$id") }
    $specs = [string[]]@(
        $meta.packages |
            Where-Object { $workspaceIds.Contains("$($_.id)") } |
            Where-Object { $_.targets | Where-Object { $_.doctest -eq $true } } |
            ForEach-Object { "$($_.name)@$($_.version)" }
    )
    [Array]::Sort($specs, [System.StringComparer]::Ordinal)
    Write-Output ($specs -join ' ')

# Private. Resolves an impact category's scope for a check recipe and echoes it on stdout.
#   1. ANVIL_IMPACT=off            -> tier default (full-workspace / run).
#   2. include_<tier>.txt present  -> its contents (a --package list or --skip).
#   3. absent under ANVIL_IMPACT=consume -> hard failure (exit 1). consume trusts
#      an already-supplied cache, so a missing include file is a defect, not a
#      reason to widen scope.
#   4. otherwise                   -> tier default.
# Tier default: --workspace for affected/required; empty (run) for modified.
# Each scoped check calls this directly (into a local $include variable) to
# read its category's scope from the impact cache -- target/anvil/impact by
# default, target/anvil/impact-dirty for a dirty local tree, or
# ANVIL_IMPACT_INPUT_DIR under consume.

# Resolve a tier's package scope from the impact cache.
[script("pwsh", "-NoProfile")]
_anvil-impact-include tier:
    $ErrorActionPreference = 'Stop'
    if ($env:ANVIL_IMPACT_INVOCATION_ID -notmatch '^\d+$') {
        Write-Error "anvil-impact: ANVIL_IMPACT_INVOCATION_ID must be a numeric Just process id"
        exit 2
    }
    $tier = '{{ tier }}'
    $selectedContent = $null
    $selectedFileFound = $false
    $dirtyGenerationSelected = $false
    $default = if ($tier -eq 'modified') { '' } else { '--workspace' }
    # Exit 2 = invalid caller configuration (bad ANVIL_IMPACT), distinct from
    # the generic 1 used for operational failures -- see _anvil-impact-snapshot.
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'off') { Write-Output $default; exit 0 }
    if ($env:ANVIL_IMPACT -eq 'consume') {
        $inputDir = if ($env:ANVIL_IMPACT_INPUT_DIR) { $env:ANVIL_IMPACT_INPUT_DIR } else { 'target/anvil/impact' }
    } else {
        $activeMarker = Join-Path 'target/anvil/impact-dirty' "active-$env:ANVIL_IMPACT_INVOCATION_ID"
        if (Test-Path -LiteralPath $activeMarker -PathType Leaf) {
            $workspaceHash = [Convert]::ToHexString(
                [System.Security.Cryptography.SHA256]::HashData(
                    [System.Text.Encoding]::UTF8.GetBytes((Get-Location).Path)
                )
            )
            $publicationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-publication-$workspaceHash")
            try {
                [void]$publicationMutex.WaitOne()
                if (Test-Path -LiteralPath $activeMarker -PathType Leaf) {
                    $selectedDir = "$(Get-Content -Raw -LiteralPath $activeMarker)".Trim()
                    $dirtyGenerationSelected = $true
                    $generationMutex = [System.Threading.Mutex]::new($false, "anvil-impact-generation-$(Split-Path $selectedDir -Leaf)")
                    try {
                        [void]$generationMutex.WaitOne()
                        $completeFile = Join-Path $selectedDir 'complete'
                        $baseFile = Join-Path $selectedDir 'base.sha'
                        if (-not (Test-Path -LiteralPath $completeFile -PathType Leaf) -or
                            -not (Test-Path -LiteralPath $baseFile -PathType Leaf)) {
                            Write-Error "anvil-impact: dirty impact selector is stale ($activeMarker)"
                            exit 1
                        }
                        $candidateFile = Join-Path $selectedDir "include_$tier.txt"
                        if (Test-Path -LiteralPath $candidateFile -PathType Leaf) {
                            $selectedFileFound = $true
                            $selectedContent = "$(Get-Content -Raw -LiteralPath $candidateFile)"
                        }
                    } finally {
                        $generationMutex.ReleaseMutex()
                        $generationMutex.Dispose()
                    }
                }
            } finally {
                $publicationMutex.ReleaseMutex()
                $publicationMutex.Dispose()
            }
            if (-not $dirtyGenerationSelected) {
                Write-Error "anvil-impact: no dirty impact generation selector for this Just invocation ($activeMarker)"
                exit 1
            }
            $inputDir = $selectedDir
        } else {
            $inputDir = 'target/anvil/impact'
        }
    }
    $file = Join-Path $inputDir "include_$tier.txt"
    if ($selectedFileFound) {
        Write-Output ($selectedContent.Trim())
        exit 0
    }
    if ($dirtyGenerationSelected) {
        Write-Error "anvil-impact: completed dirty impact generation is missing include_$tier.txt ($selectedDir)"
        exit 1
    }
    if (Test-Path -LiteralPath $file -PathType Leaf) {
        Write-Output ("$(Get-Content -Raw -LiteralPath $file)".Trim())
    } elseif ($env:ANVIL_IMPACT -eq 'consume') {
        Write-Error "anvil-impact: ANVIL_IMPACT=consume but the input impact cache is missing ($file). A complete cache holds include_modified.txt, include_affected.txt and include_required.txt. The read directory is ANVIL_IMPACT_INPUT_DIR when set, otherwise target/anvil/impact -- check that variable if the path above is not where you expected. Supply a complete impact cache before scoped checks run."
        exit 1
    } else {
        Write-Output $default
    }

# Private. Same contract as _anvil-impact-include, but a member list is
# returned as aggregate Cargo selection: "--workspace --exclude <name> ...".
# Cargo resolves --exclude against workspace members only, so this stays
# unambiguous when a registry dependency shares a member's name and version
# (where `--package name@version` fails). "--skip", "--workspace" and the
# empty modified default pass through unchanged, so callers keep their
# explicit skip: excluding every member is a Cargo error, not a no-op.

# Resolve a tier's scope as workspace-exclude Cargo selection.
[script("pwsh", "-NoProfile")]
_anvil-impact-exclude tier:
    Set-StrictMode -Version 3.0
    $ErrorActionPreference = 'Stop'
    $include = (& "{{ just_executable() }}" _anvil-impact-include '{{ tier }}')
    $impactExit = $LASTEXITCODE
    if ($impactExit -ne 0) { exit $impactExit }
    if ($include -notmatch '(^|\s)--package\s') { Write-Output $include; exit 0 }
    $specs = @(-split $include | Where-Object { $_ -ne '--package' })
    & "{{ just_executable() }}" _anvil-workspace-exclude @specs
    exit $LASTEXITCODE

# Private. Prints "--workspace --exclude <name> ..." selecting exactly the
# given workspace-member name@version specs. Fails when a spec is not a
# workspace member, so a stale selection never widens silently.

# Convert workspace-member specs to workspace-exclude Cargo selection.
[script("pwsh", "-NoProfile")]
_anvil-workspace-exclude +specs:
    Set-StrictMode -Version 3.0
    $ErrorActionPreference = 'Stop'
    $selected = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
    foreach ($spec in -split '{{ specs }}') { [void]$selected.Add($spec) }
    $metadataJson = & cargo {{_anvil_stable_toolchain_args}} metadata --locked --no-deps --format-version 1
    $metadataExit = $LASTEXITCODE
    if ($metadataExit -ne 0) {
        [Console]::Error.WriteLine('anvil: cargo metadata failed')
        exit $metadataExit
    }
    $meta = $metadataJson | ConvertFrom-Json
    $workspaceIds = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
    foreach ($id in $meta.workspace_members) { [void]$workspaceIds.Add("$id") }
    $selection = [System.Collections.Generic.List[string]]::new()
    $selection.Add('--workspace')
    $found = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::Ordinal)
    foreach ($p in @($meta.packages | Where-Object { $workspaceIds.Contains("$($_.id)") })) {
        $spec = "$($p.name)@$($p.version)"
        if ($selected.Contains($spec)) {
            [void]$found.Add($spec)
        } else {
            $selection.Add('--exclude')
            $selection.Add($p.name)
        }
    }
    $missing = @($selected | Where-Object { -not $found.Contains($_) })
    if ($missing.Count -gt 0) {
        [Console]::Error.WriteLine("anvil: not workspace members: $($missing -join ', ')")
        exit 1
    }
    Write-Output ($selection -join ' ')