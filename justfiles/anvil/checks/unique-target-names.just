# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Update behaviour: https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/updates.md

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (a collision is a property of the whole workspace, not of the
# packages a diff happens to touch).
#
# Cargo uplifts some build outputs to a shared directory under
# `target/<profile>/` without a metadata hash: binaries and examples, plus
# `cdylib`, `dylib`, and `staticlib` libraries. Two workspace packages that
# name such a target the same way write the same file -- and, on Windows, the
# same debug-info file, plus the same SBOM sidecar when CI generates one.
# Cargo reports this as `output filename collision`, warns that it may become
# a hard error, and keeps building, so the workspace stays green while
# concurrent jobs race for one path. This recipe turns that warning into a
# failure before anything is compiled.
#
# Test and benchmark binaries keep a metadata hash in
# `target/<profile>/deps/`, as do `lib` and `rlib` libraries and build
# scripts, so duplicate names there are harmless and are not reported. Cargo
# already rejects duplicate target names inside a single package, so only
# cross-package duplicates are reported here.
#
# Targets are grouped by the file name they produce, not by their crate
# type: `cdylib` and `dylib` emit the same platform shared-library file, so
# a collision can cross the two crate types.

# Check that uplifted binary, example, and library target names are unique.
[script("pwsh", "-NoProfile")]
anvil-unique-target-names: anvil-unique-target-names-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $metadataJson = & cargo {{_anvil_stable_toolchain_args}} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) {
        Write-Error 'anvil-unique-target-names: cargo metadata failed'
        exit $LASTEXITCODE
    }
    try {
        $metadata = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-unique-target-names: could not parse cargo metadata output: $_"
        exit 1
    }

    # Crate types Cargo copies out of `deps/` into the profile directory,
    # mapped to the family of file name they emit. `cdylib` and `dylib` share
    # a family because they produce the same platform file, so a collision
    # between them must be caught.
    $families = [ordered]@{
        'bin' = 'executable'
        'cdylib' = 'shared library'
        'dylib' = 'shared library'
        'staticlib' = 'static library'
    }
    # The file name each family emits, used to name the contested path.
    $fileNames = @{
        'executable' = '<name>'
        'shared library' = '[lib]<name>[.so|.dll|.dylib]'
        'static library' = '[lib]<name>[.a|.lib]'
    }
    # Target kinds that always keep a metadata hash in `deps/`.
    $hashed = @('test', 'bench', 'custom-build')

    $owners = [ordered]@{}
    foreach ($package in $metadata.packages) {
        if ($metadata.workspace_members -notcontains $package.id) { continue }
        foreach ($target in $package.targets) {
            if ($target.kind | Where-Object { $hashed -contains $_ }) { continue }
            $isExample = $target.kind -contains 'example'
            $directory = if ($isExample) { 'target/<profile>/examples' } else { 'target/<profile>' }
            foreach ($crateType in $target.crate_types) {
                if (-not $families.Contains($crateType)) { continue }
                $family = $families[$crateType]
                $label = if ($isExample) { 'example' } elseif ($family -eq 'executable') { 'binary' } else { $family }
                # Keyed by family rather than crate type, so two crate types
                # that emit one file name share a bucket, while families that
                # emit different names (an executable next to a static
                # library) stay apart.
                $key = "$directory $family $($target.name)"
                if (-not $owners.Contains($key)) {
                    $owners[$key] = [pscustomobject]@{
                        Label = $label
                        Name = $target.name
                        Path = "$directory/" + $fileNames[$family].Replace('<name>', $target.name)
                        Packages = [System.Collections.Generic.List[string]]::new()
                    }
                }
                $owners[$key].Packages.Add($package.name)
            }
        }
    }

    $failed = $false
    foreach ($key in ($owners.Keys | Sort-Object)) {
        $entry = $owners[$key]
        $packages = @($entry.Packages | Sort-Object -Unique)
        if ($packages.Count -lt 2) { continue }
        $failed = $true
        Write-Host "anvil-unique-target-names: $($entry.Label) target '$($entry.Name)' is declared by $($packages.Count) workspace packages: $($packages -join ', ')"
        Write-Host "  all of them uplift to $($entry.Path), so one build output overwrites the others"
    }
    if ($failed) {
        Write-Error 'anvil-unique-target-names: rename the reported targets so each one uplifts to its own path'
        exit 1
    }

# unique-target-names reads cargo metadata from a pwsh script; there is no
# cargo tool to install beyond the toolchain itself.

# Install prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-setup installer="install": anvil-toolchain-stable-install anvil-tool-pwsh-validate-prereqs

# Validate prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-pwsh-validate-prereqs
