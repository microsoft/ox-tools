# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Update behaviour: https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/updates.md

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (a collision is a property of the whole workspace, not of the
# packages a diff happens to touch).
#
# Cargo compiles each unit into `target/<profile>/deps/` under a
# metadata-hashed name, then uplifts the root unit of most target kinds to
# `target/<profile>/` (examples to `target/<profile>/examples/`) under a
# plain, unhashed name. Two workspace packages whose targets uplift to the
# same file name therefore write the same file -- and, on Windows, the same
# import library and debug-info files, plus the same SBOM sidecar when CI
# generates one. Cargo reports this as `output filename collision`, warns
# that it may become a hard error, and keeps building, so the workspace
# stays green while concurrent jobs race for one path. This recipe turns
# that warning into a failure before anything is compiled.
#
# Only test and benchmark binaries and build scripts stay in `deps/`, so
# duplicate names among those are harmless and are not reported. Everything
# else uplifts, including an ordinary `lib`: two packages named `foo-bar`
# and `foo_bar` both uplift to `libfoo_bar.rlib` because target names
# normalise `-` to `_`, with no explicit `[lib] name` anywhere.
#
# Targets are grouped by the file name they emit rather than by crate type,
# because several crate types share one name and must land in one bucket
# (`cdylib`, `dylib`, and `proc-macro` all emit the platform shared-library
# file) while others that share a directory must not (an `rlib` and a
# `cdylib` of the same name emit different files and do not collide).
#
# Cargo already rejects duplicate target names inside a single package, so
# only cross-package duplicates are reported here.

# Check that uplifted target names are unique across the workspace.
[script("pwsh", "-NoProfile")]
anvil-unique-target-names: anvil-unique-target-names-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $metadataJson = & cargo {{_anvil_stable_toolchain_args}} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) {
        Write-Error 'anvil-unique-target-names: cargo metadata failed'
        exit $LASTEXITCODE
    }
    try {
        $metadata = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-unique-target-names: could not parse cargo metadata output: $_"
        exit 1
    }

    # Crate type -> the family of file name it emits. Crate types that emit
    # the same name share a family; `cargo metadata` reports an ordinary
    # library as `lib`, not `rlib`, so both spellings are listed.
    $families = [ordered]@{
        'bin' = 'executable'
        'lib' = 'rust library'
        'rlib' = 'rust library'
        'cdylib' = 'shared library'
        'dylib' = 'shared library'
        'proc-macro' = 'shared library'
        'staticlib' = 'static library'
    }
    # The file name each family emits, used to name the contested path.
    $fileNames = @{
        'executable' = '<name>[.exe]'
        'rust library' = 'lib<name>.rlib'
        'shared library' = '[lib]<name>[.so|.dll|.dylib]'
        'static library' = '[lib]<name>[.a|.lib]'
    }
    # How each family is described in the diagnostic.
    $labels = @{
        'executable' = 'binary'
        'rust library' = 'library'
        'shared library' = 'shared library'
        'static library' = 'static library'
    }
    # The only target kinds Cargo never uplifts: they keep their metadata
    # hash in `deps/`, so duplicate names among them cannot collide.
    $hashed = @('test', 'bench', 'custom-build')

    # Ordinal on purpose. Cargo keys its own collision check by exact path,
    # so target names differing only in case are distinct targets to Cargo
    # and must not be merged here -- a case-insensitive comparer would fail
    # a workspace that Cargo builds without a warning.
    $owners = [System.Collections.Generic.Dictionary[string, object]]::new([StringComparer]::Ordinal)
    foreach ($package in $metadata.packages) {
        if ($metadata.workspace_members -notcontains $package.id) { continue }
        foreach ($target in $package.targets) {
            if ($target.kind | Where-Object { $hashed -contains $_ }) { continue }
            $isExample = $target.kind -contains 'example'
            $directory = if ($isExample) { 'target/<profile>/examples' } else { 'target/<profile>' }
            foreach ($crateType in $target.crate_types) {
                if (-not $families.Contains($crateType)) { continue }
                $family = $families[$crateType]
                $fileName = $fileNames[$family].Replace('<name>', $target.name)
                $key = "$directory/$fileName"
                if (-not $owners.ContainsKey($key)) {
                    $owners[$key] = [pscustomobject]@{
                        Label = if ($isExample) { 'example' } else { $labels[$family] }
                        Name = $target.name
                        Path = $key
                        Packages = [System.Collections.Generic.List[string]]::new()
                    }
                }
                $owners[$key].Packages.Add($package.name)
            }
        }
    }

    $failed = $false
    foreach ($key in ($owners.Keys | Sort-Object)) {
        $entry = $owners[$key]
        $packages = @($entry.Packages | Sort-Object -Unique)
        if ($packages.Count -lt 2) { continue }
        $failed = $true
        Write-Host "anvil-unique-target-names: $($entry.Label) target '$($entry.Name)' is declared by $($packages.Count) workspace packages: $($packages -join ', ')"
        Write-Host "  all of them uplift to $($entry.Path), so one build output overwrites the others"
    }
    if ($failed) {
        Write-Error 'anvil-unique-target-names: rename the reported targets so each one uplifts to its own path'
        exit 1
    }

# unique-target-names reads cargo metadata from a pwsh script; there is no
# cargo tool to install beyond the toolchain itself.

# Install prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-setup installer="install": anvil-toolchain-stable-install anvil-tool-pwsh-validate-prereqs

# Validate prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-pwsh-validate-prereqs
