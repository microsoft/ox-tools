# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Update behaviour: https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/updates.md

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Smoke-only fuzz pass via [bolero](https://crates.io/crates/bolero):
# each fuzz target gets a 60-second libfuzzer run, just enough to
# surface obvious crashes/hangs introduced by a PR without paying for
# a long fuzzing campaign.
#
# Linux-only: cargo-bolero's libfuzzer engine (and its bolero-afl
# build dependency) only builds on Linux, so the recipe self-skips on
# non-Linux hosts -- the pr-runtime-analysis Windows/ARM legs treat
# bolero as a no-op rather than a failure. This matches oxidizer's
# reference workflow, whose bolero job runs exclusively on ubuntu.
# Crates that ship bolero harnesses still get them compiled and
# exercised as ordinary tests by anvil-llvm-cov on every leg; the
# libfuzzer campaign is the Linux-only extra.
#
# Cargo metadata first excludes affected packages whose dependency graph
# cannot reach bolero or bolero-engine. This performs no builds. We include
# all features and platforms conservatively, including renamed/transitive
# dependencies, so embedded unit-test and integration-test harnesses remain
# discoverable without a source-code heuristic or explicit registration.
# Remaining candidates use `cargo +<nightly> bolero list --profile release`;
# a dependency alone does not prove a harness exists, so empty discovery
# still no-ops. The libfuzzer engine requires nightly, so the test
# invocation uses the pinned rust_nightly. Adopters who want longer
# campaigns wire a separate scheduled job; anvil deliberately does
# not ship a long-form fuzz tier (the failure surface is too
# repo-specific to standardize).

# Run Bolero tests for affected workspace packages.
[group("anvil")]
[script("pwsh", "-NoProfile")]
anvil-bolero: anvil-bolero-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    $include = (& "{{ just_executable() }}" _anvil-impact-include affected)
    $impactExit = $LASTEXITCODE
    if ($impactExit -ne 0) { exit $impactExit }
    if (-not $IsLinux) {
        Write-Host 'anvil-bolero: non-Linux host -- skipping (cargo-bolero/libfuzzer is Linux-only; harnesses still run under anvil-llvm-cov)'
        exit 0
    }
    if ($include -eq '--skip') {
        Write-Host 'anvil-bolero: no affected packages; skipping'
        exit 0
    }

    # Pure selection boundary, also exercised in-process by the catalog tests.
    function Get-AnvilBoleroPackages($metadata, [string]$include) {
        if (-not $metadata -or -not $metadata.PSObject.Properties['packages'] -or
            -not $metadata.PSObject.Properties['workspace_members'] -or -not $metadata.PSObject.Properties['resolve'] -or
            -not $metadata.packages -or -not $metadata.workspace_members -or -not $metadata.resolve -or -not $metadata.resolve.nodes) {
            throw 'cargo metadata must include packages, workspace_members, and resolve.nodes; do not use --no-deps'
        }
        $nodes = [System.Collections.Generic.Dictionary[string, object]]::new([StringComparer]::Ordinal)
        foreach ($node in $metadata.resolve.nodes) {
            if (-not $node.id -or $null -eq $node.dependencies) {
                throw 'cargo metadata resolve node is missing its id or dependencies'
            }
            $nodes.Add($node.id, $node)
        }
        $candidates = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
        foreach ($package in $metadata.packages) {
            if (-not $package.id -or -not $package.name -or -not $package.version -or -not $nodes.ContainsKey($package.id)) {
                throw 'cargo metadata package is missing its identity or resolve node'
            }
            if ($package.name -in @('bolero', 'bolero-engine')) { $null = $candidates.Add($package.id) }
        }
        do {
            $changed = $false
            foreach ($node in $nodes.Values) {
                foreach ($dependency in $node.dependencies) {
                    if (-not $nodes.ContainsKey($dependency)) { throw "cargo metadata is missing dependency node '$dependency'" }
                    if ($candidates.Contains($dependency) -and $candidates.Add($node.id)) { $changed = $true }
                }
            }
        } while ($changed)

        $members = @($metadata.packages | Where-Object { $_.id -cin $metadata.workspace_members })
        if ($members.Count -ne $metadata.workspace_members.Count) { throw 'cargo metadata is missing a workspace member' }
        $selected = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::Ordinal)
        if ($include -and $include -ne '--workspace') {
            $pkgArgs = @(-split $include)
            for ($i = 0; $i -lt $pkgArgs.Count; $i++) {
                if ($pkgArgs[$i] -ne '--package' -or ($i + 1) -ge $pkgArgs.Count) {
                    throw "unsupported affected-package arguments: $include"
                }
                $spec = $pkgArgs[++$i]
                if (-not ($members | Where-Object { "$($_.name)@$($_.version)" -ceq $spec })) {
                    throw "affected package '$spec' is not a workspace member; rerun anvil-impact"
                }
                $null = $selected.Add($spec)
            }
        }
        foreach ($package in $members) {
            $spec = "$($package.name)@$($package.version)"
            if (($selected.Count -eq 0 -or $selected.Contains($spec)) -and $candidates.Contains($package.id)) { $spec }
        }
    }

    $metadataJson = & cargo '+{{ rust_nightly }}' metadata --locked --all-features --format-version 1
    $metadataExit = $LASTEXITCODE
    if ($metadataExit -ne 0) {
        Write-Error "anvil-bolero: cargo metadata failed (exit $metadataExit); resolve the dependency error before retrying"
        exit $metadataExit
    }
    try {
        $packageSpecs = @(Get-AnvilBoleroPackages ($metadataJson | ConvertFrom-Json) $include)
    } catch {
        Write-Error "anvil-bolero: could not select discovery candidates from cargo metadata: $_"
        exit 1
    }

    # cargo-bolero accepts only one --package, so discover each package
    # separately and combine the emitted JSON target objects. cargo-each
    # resolves each workspace-member spec and passes cargo-bolero a
    # source-qualified '{cargo-spec}', which stays unambiguous when a
    # registry dependency shares the member's name and version.
    $targets = [System.Collections.Generic.List[object]]::new()
    foreach ($packageSpec in $packageSpecs) {
        $targetsJson = & cargo {{_anvil_stable_toolchain_args}} each --package $packageSpec '--' cargo '+{{ rust_nightly }}' bolero list --profile release --package '{cargo-spec}'
        if ($LASTEXITCODE -ne 0) {
            Write-Error "anvil-bolero: target discovery failed for package '$packageSpec'"
            exit $LASTEXITCODE
        }
        try {
            foreach ($targetJson in ($targetsJson | Where-Object { $_ -match '^\{' })) {
                $target = $targetJson | ConvertFrom-Json
                $target | Add-Member -NotePropertyName anvilPackageSpec -NotePropertyValue $packageSpec
                $targets.Add($target)
            }
        } catch {
            Write-Error "anvil-bolero: could not parse target discovery output for package '$packageSpec': $_"
            exit 1
        }
    }
    if ($targets.Count -eq 0) {
        Write-Host 'anvil-bolero: no fuzz targets in affected packages; skipping'
        exit 0
    }
    $failed = $false
    foreach ($t in $targets) {
        $testName = if ($t.test) { $t.test } elseif ($t.test_name) { $t.test_name } else { $t.target }
        if (-not $testName) {
            Write-Error "anvil-bolero: target discovery returned an unsupported object: $($t | ConvertTo-Json -Compress)"
            exit 1
        }
        Write-Host "anvil-bolero: $($t.anvilPackageSpec)::${testName}"
        & cargo {{_anvil_stable_toolchain_args}} each --package $t.anvilPackageSpec '--' cargo '+{{ rust_nightly }}' bolero test --profile release --engine libfuzzer -T 60s --package '{cargo-spec}' $testName
        if ($LASTEXITCODE -ne 0) { $failed = $true }
    }
    if ($failed) { exit 1 }

# bolero needs cargo-bolero, cargo-each, and the pinned nightly toolchain
# (libfuzzer engine requires nightly rustc features).

# Install prerequisites for the `anvil-bolero` recipe.
[private]
anvil-bolero-setup installer="install": anvil-toolchain-nightly-install (anvil-tool-cargo-bolero-install installer) (anvil-tool-cargo-each-install installer)

# Validate prerequisites for the `anvil-bolero` recipe.
[private]
anvil-bolero-validate-prereqs: anvil-toolchain-nightly-validate-prereqs anvil-tool-cargo-bolero-validate-prereqs anvil-tool-cargo-each-validate-prereqs
