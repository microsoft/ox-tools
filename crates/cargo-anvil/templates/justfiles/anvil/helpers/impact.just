# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY unless you intend to depart from anvil-provided defaults.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Regenerate with cargo-anvil to update this file.


anvil_impact_override := ""
anvil_impact_mode := if anvil_impact_override != "" {
    anvil_impact_override
} else if env("ANVIL_IMPACT", "") == "" {
    ""
} else if env("ANVIL_IMPACT") == "consume" {
    "consume"
} else if env("ANVIL_IMPACT") == "off" {
    "off"
} else {
    error("ANVIL_IMPACT must be unset, 'consume', or 'off'")
}
export ANVIL_IMPACT_INVOCATION_ID := env_var_or_default("ANVIL_IMPACT_INVOCATION_ID", just_pid())
anvil_impact_input_dir := if anvil_impact_mode == "consume" {
    env("ANVIL_IMPACT_INPUT_DIR", "target/anvil/impact")
} else if anvil_impact_mode == "" {
    "target/anvil/impact-invocations/" + ANVIL_IMPACT_INVOCATION_ID
} else {
    "target/anvil/impact"
}
anvil_impact_compute_prefix := if anvil_impact_mode == "" { "" } else { "# " }
anvil_impact_toolchain_arg := if anvil_impact_mode == "" { anvil_stable_toolchain_arg } else { "" }

anvil_base_ref := if env("BASE_REF", "") == "" {
    if env("SYSTEM_PULLREQUEST_TARGETBRANCH", "") == "" {
        if env("GITHUB_BASE_REF", "") == "" {
            "origin/main"
        } else {
            "origin/" + env("GITHUB_BASE_REF")
        }
    } else {
        "origin/" + replace(env("SYSTEM_PULLREQUEST_TARGETBRANCH"), "refs/heads/", "")
    }
} else {
    env("BASE_REF")
}
anvil_modified_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/modified.packages")
}

anvil_affected_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/affected.packages")
}

anvil_required_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/required.packages")
}

anvil_explicit_package_args := if anvil_impact_mode == "off" { "" } else { "'{packages}'" }

anvil_root_msrv := env("ANVIL_ROOT_MSRV", "")
workspace_rust_version_line := if anvil_root_msrv == "" {
    shell("cargo each --workspace --once --dry-run -- " + quote("workspace-rust-version={workspace-rust-version}"))
} else {
    "workspace-rust-version=" + if anvil_root_msrv == "none" { "" } else { anvil_root_msrv }
}
workspace_rust_version := replace(workspace_rust_version_line, "workspace-rust-version=", "")

anvil_stable_toolchain_arg := if env("RUSTUP_TOOLCHAIN", "") == "" {
    if path_exists(justfile_directory() + "/rust-toolchain.toml") {
        ""
    } else if path_exists(justfile_directory() + "/rust-toolchain") {
        ""
    } else if workspace_rust_version == "" {
        ""
    } else {
        quote("+" + workspace_rust_version)
    }
} else {
    ""
}

anvil_msrv_selection := if workspace_rust_version == "" { "--none" } else { anvil_affected_selection }
anvil_msrv_workspace_selection := if workspace_rust_version == "" { "--none" } else { "--workspace" }

# Private. Produces cargo-delta snapshots with two independent cache keys:
#   * baseline.json  -- snapshot of the base ref. EXPENSIVE (needs a throwaway
#     git worktree). Keyed on the base commit sha, effective .delta.toml
#     identity, and pinned cargo-delta version (baseline.key stores
#     "<base-sha> <config-hash> <cargo-delta-version>"). A clean run stores
#     it under target/anvil/impact/snapshots/ and reuses it while fresh.
#   * current.json   -- snapshot of the working tree. Cheap. Keyed on
#     "<HEAD sha> <cargo-delta-version>" (current.key) for a clean tree.
#     Dirty local runs always snapshot the files on disk into a unique
#     target/anvil/impact-dirty/<generation>/snapshots/ directory and write no
#     current key. The completed generation is published through a selector
#     keyed by the Just invocation process id, plus an `active` inspection
#     selector. Generations remain immutable so concurrent invocations cannot
#     delete each other's producer or consumer inputs. Tool upgrades invalidate
#     cached clean snapshots so incompatible formats are never reused. If
#     .delta.toml itself is dirty,
#     the baseline is also rebuilt in the dirty generation so snapshots always
#     use one config.

# Snapshot the base ref and working tree for impact analysis.
[script("pwsh", "-NoProfile")]
_anvil-impact-snapshot impact_dir="":
    $ErrorActionPreference = 'Stop'
    $impactDirArgument = '{{ impact_dir }}'
    # Exit 2 (not the generic 1 used for operational failures below) marks
    # *invalid caller configuration*: an unrecognized ANVIL_IMPACT value is a
    # mistake in how the recipe was invoked, not a runtime failure of the work
    # it does. Keeping the two distinct lets a caller (or CI) tell a bad-mode
    # misconfiguration apart from a genuine snapshot/impact failure. All three
    # Both ANVIL_IMPACT readers (_anvil-impact-snapshot and anvil-impact) use
    # the same 2/1 split; keep them in sync.
    if ($env:ANVIL_IMPACT -and $env:ANVIL_IMPACT -notin @('off', 'consume')) {
        [Console]::Error.WriteLine("anvil: ANVIL_IMPACT='$($env:ANVIL_IMPACT)' is not recognized (expected 'off', 'consume', or unset).")
        exit 2
    }
    if ($env:ANVIL_IMPACT -eq 'off' -or $env:ANVIL_IMPACT -eq 'consume') { exit 0 }

    # A dirty local tree snapshots the current files on disk. target/ is
    # excluded because both clean and dirty impact products live there. Git
    # handles rename and case semantics through the pathspec.
    $dirtyChanges = @(git status --porcelain -- . ':(exclude)target/' | Where-Object { $_ })
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $dirty = $dirtyChanges.Count -gt 0
    $cloudCompute = ($env:GITHUB_ACTIONS -eq 'true') -or ($env:TF_BUILD -eq 'True')
    if ($dirty -and $cloudCompute) {
        Write-Error 'anvil-impact: cloud impact computation requires a clean working tree; restore or commit all checkout changes before running the impact job.'
        exit 1
    }

    $cleanImpactDir = 'target/anvil/impact'
    $impactDir = if (-not [string]::IsNullOrWhiteSpace($impactDirArgument)) {
        $impactDirArgument
    } elseif ($dirty) {
        Join-Path 'target/anvil/impact-dirty' ([System.Guid]::NewGuid().ToString('N'))
    } else {
        $cleanImpactDir
    }
    [System.IO.Directory]::CreateDirectory($impactDir) | Out-Null
    if ($dirty) {
        Set-Content -LiteralPath (Join-Path $impactDir 'producer.pid') -Value $env:ANVIL_IMPACT_INVOCATION_ID -Encoding UTF8 -NoNewline
    }
    $deltaConfigDirty = $dirty -and (@(git status --porcelain -- .delta.toml | Where-Object { $_ }).Count -gt 0)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $baselineImpactDir = if ($deltaConfigDirty) { $impactDir } else { $cleanImpactDir }
    $baselineSnapDir = Join-Path $baselineImpactDir 'snapshots'
    $snapDir = Join-Path $impactDir 'snapshots'
    $baselineJson = Join-Path $baselineSnapDir 'baseline.json'
    $baselineKeyFile = Join-Path $baselineSnapDir 'baseline.key'
    $currentJson = Join-Path $snapDir 'current.json'
    $currentKeyFile = Join-Path $snapDir 'current.key'
    $noWorkspaceMarker = Join-Path $baselineSnapDir 'baseline-no-workspace'
    $generationSnapDir = Join-Path $impactDir 'snapshots'
    $generationBaselineJson = Join-Path $generationSnapDir 'baseline.json'
    $generationBaselineKey = Join-Path $generationSnapDir 'baseline.key'
    $generationNoWorkspaceMarker = Join-Path $generationSnapDir 'baseline-no-workspace'
    $workspacePath = (Get-Location).Path
    $workspaceHash = [Convert]::ToHexString(
        [System.Security.Cryptography.SHA256]::HashData(
            [System.Text.Encoding]::UTF8.GetBytes($workspacePath)
        )
    )
    $baselineMutex = [System.Threading.Mutex]::new($false, "anvil-impact-baseline-$workspaceHash")

    # Effective cargo-delta config identity -- part of the baseline cache key.
    # Resolve the repo's `.delta.toml` ONCE here, at the repo root, before the
    # fast path below and before any Push-Location into the base worktree.
    # (This probe -- like the one in anvil-impact -- is CWD-relative; it relies
    # on `just` invoking recipes at the repo root, which the generated Justfile
    # guarantees.) cargo-delta's default config lookup is `delta.toml` (no dot),
    # so a repo that uses `.delta.toml` must pass `--config` explicitly or every
    # snapshot/impact runs under cargo-delta's built-in defaults -- ignoring
    # file_exclude / [parser] / assume_patterns / trip_wire_patterns. All three
    # invocations (baseline snapshot, current snapshot, impact) share this one
    # `$deltaArgs`.
    #
    # Because that config governs WHAT every snapshot captures, it is part of
    # the baseline's identity: editing `.delta.toml` (or adding/removing it)
    # must invalidate the baseline exactly like a moved base ref would.
    # Otherwise a warm local cache keyed on the base sha alone would keep an
    # old-config baseline while the current snapshot -- regenerated because the
    # committed config edit moved HEAD -- is captured under the new config, and
    # `cargo delta impact` would then diff two snapshots taken under different
    # rules and silently mis-scope. So hash the resolved config (or mark its
    # absence) and fold it into the composite baseline key alongside the base
    # sha and pinned cargo-delta version
    # below (which also flows into anvil-impact's projection cache via
    # baseline.key). Absent a config file, `$deltaArgs` stays empty and the id
    # is `<none>`, so adopters without a `.delta.toml` are unaffected.
    #
    # anvil manages `.delta.toml` (the anvil-delta artifact owns its
    # trip_wire_patterns region), so in an anvil-managed repo the file should
    # exist whenever this impact recipe does. Its absence means cargo-delta runs
    # under defaults with trip wires + file_exclude OFF, which can silently
    # UNDER-scope -- the opposite of what trip wires exist to prevent. Every
    # neighbouring precondition here (missing base ref, shallow clone) is a hard
    # error; failing open on this one alone would be surprising, so warn loudly.
    # We warn rather than fail because a repo may legitimately opt out of the
    # `.delta.toml` region; the warning surfaces the reduced coverage without
    # blocking. (anvil-impact re-probes but stays silent: this dependency
    # recipe always runs first, so one warning per compute is enough.)
    $deltaArgs = @()
    $deltaConfigId = '<none>'
    if (Test-Path '.delta.toml') {
        $deltaConfigPath = (Resolve-Path '.delta.toml').Path
        $deltaArgs = @('--config', $deltaConfigPath)
        # SHA-256 is an arbitrary but stable choice: the key only needs a
        # deterministic content fingerprint to detect config edits, not any
        # cryptographic property. Get-FileHash defaults to SHA-256, so this
        # avoids pulling in another algorithm. Changing it only invalidates
        # already-cached baselines (they recompute once); it is not a contract.
        $deltaConfigId = (Get-FileHash -LiteralPath $deltaConfigPath -Algorithm SHA256).Hash
    } else {
        [Console]::Error.WriteLine("anvil-impact: warning: no .delta.toml found at the repo root; cargo-delta will run under its defaults (trip_wire_patterns and file_exclude_patterns inactive), which can under-scope the impact set. Restore the anvil-managed .delta.toml to get conservative scoping.")
    }

    # Only a clean tree corresponds exactly to HEAD. Include the pinned
    # cargo-delta version in the clean current key without invoking the tool,
    # so an upgrade invalidates old snapshot formats. target/ changes do not
    # perturb this key.
    $currentState = "$((git rev-parse HEAD).Trim()) {{ cargo_delta_version }}"

    # Consumer fast path: reuse an already-present, matching snapshot set
    # WITHOUT cargo-delta or a fetched base ref -- this short-circuits a local
    # repeat run when nothing changed. (The cloud-workflow consume path never
    # reaches here: ANVIL_IMPACT=consume returned at the guard above and trusts
    # the downloaded artifact verbatim -- anvil-impact asserts its presence
    # before any scoped check reads it.) We still detect a moved base ref when
    # it is cheaply resolvable (best effort). If the base cannot be resolved
    # $baseSha stays $null, the baseline is treated as not fresh, and we fall
    # through to the recompute path, which fails fast with git-fetch guidance
    # rather than scoping against a stale baseline.
    $currentFresh = (-not $dirty) -and (Test-Path $currentJson) -and (Test-Path $currentKeyFile) -and `
        ("$(Get-Content -Raw $currentKeyFile)".Trim() -eq $currentState)
    $baseSha = $null
    $base = '{{ replace(anvil_base_ref, "'", "''") }}'
    if ($base) {
        git rev-parse --verify "$base^{commit}" 2>$null | Out-Null
        if ($LASTEXITCODE -eq 0) { $baseSha = (git rev-parse $base).Trim() }
    }
    # A moved base ref, changed config, or tool upgrade invalidates the
    # baseline, so it is never reused across incompatible rules or formats.
    $baselineKey = "$baseSha $deltaConfigId {{ cargo_delta_version }}"
    $baselineFresh = (-not $deltaConfigDirty) -and (Test-Path $baselineKeyFile) -and `
        ((Test-Path $baselineJson) -or (Test-Path $noWorkspaceMarker)) -and `
        ("$(Get-Content -Raw $baselineKeyFile)".Trim() -eq $baselineKey)
    if ($currentFresh -and $baselineFresh) {
        Write-Host 'anvil-impact: snapshots up to date'
        exit 0
    }

    # --- (Re)compute path: this is the only path that needs cargo-delta and a
    # resolvable base ref (the impact job in cloud workflows, or a local first
    # run / cache miss). ---
    # cargo-delta is validated here -- inside the recompute path, after the
    # off/consume guard and the fast path -- rather than as a hard `just`
    # dependency of `anvil-impact`. Only recompute needs the tool; the paths
    # that skip it (ANVIL_IMPACT=off/consume, or a cache hit) must be able to
    # no-op without it. Groups that can actually reach recompute declare
    # cargo-delta as their own setup prereq (see groups/*.just), so a local
    # `just anvil-<group>` still fails fast if it is missing; keeping it off
    # anvil-impact's dependency line is what lets the no-op paths stay
    # tool-agnostic.
    # PowerShell on Linux ARM can abort while multiple fresh pwsh processes
    # initialize concurrently during this nested tool probe. Serialize only
    # this probe with the existing workspace mutex; snapshot and impact work
    # remains concurrent under immutable generations.
    $prerequisiteLockHeld = $false
    try {
        try {
            [void]$baselineMutex.WaitOne()
            $prerequisiteLockHeld = $true
        } catch [System.Threading.AbandonedMutexException] {
            $prerequisiteLockHeld = $true
        }
        & "{{ just_executable() }}" anvil-tool-cargo-delta-validate-prereqs
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    } finally {
        if ($prerequisiteLockHeld) { $baselineMutex.ReleaseMutex() }
    }
    [System.IO.Directory]::CreateDirectory($baselineSnapDir) | Out-Null
    [System.IO.Directory]::CreateDirectory($snapDir) | Out-Null

    # The best-effort base-ref resolution above may have left `$baseSha` unset
    # (unresolvable ref, or a `just`/git hiccup). Recompute cannot proceed
    # without it, so resolve with fail-fast diagnostics now. We deliberately do
    # NOT `git fetch`: mutating git state as a side effect of a build check is
    # surprising and can race the user's own git operations.
    if (-not $baseSha) {
        $base = '{{ replace(anvil_base_ref, "'", "''") }}'
        git rev-parse --verify "$base^{commit}" 2>$null | Out-Null
        if ($LASTEXITCODE -ne 0) {
            $branch = ($base -replace '^origin/', '')
            Write-Error "anvil-impact: base ref '$base' not found locally. Run ``git fetch origin $branch`` and retry."
            exit 1
        }
        $baseSha = (git rev-parse $base).Trim()
    }
    if ((git rev-parse --is-shallow-repository) -eq 'true') {
        Write-Error 'anvil-impact: shallow clone detected; cargo-delta needs full history for the base ref. Run ``git fetch --unshallow`` and retry.'
        exit 1
    }
    if ($dirty) {
        Set-Content -LiteralPath (Join-Path $impactDir 'base.sha') -Value $baseSha -Encoding UTF8 -NoNewline
    }

    # --- Baseline snapshot: only when the base sha, config, or tool changed. ---
    # Re-derive the composite key now that `$baseSha` is authoritatively
    # resolved (the fast-path value above may have been $null on a cache miss).
    $baselineKey = "$baseSha $deltaConfigId {{ cargo_delta_version }}"
    $haveBaseline = (Test-Path $baselineKeyFile) -and `
        ("$(Get-Content -Raw $baselineKeyFile)".Trim() -eq $baselineKey) -and `
        ((Test-Path $baselineJson) -or (Test-Path $noWorkspaceMarker))
    if ($haveBaseline) {
        Write-Host "anvil-impact: baseline snapshot up to date (base $baseSha)"
    } else {
        Write-Host "anvil-impact: snapshotting baseline at $base ($baseSha)"
        # The baseline worktree is checked out at the merge target, whose
        # rust-toolchain.toml may pin a toolchain that is NOT installed on this
        # machine (any PR that bumps rust-toolchain.toml hits this). The
        # snapshot is metadata-only (file presence + content hashes), so use
        # the selected compiler from the current checkout to override any
        # different toolchain file in the baseline worktree. Environment/MSRV
        # selections are already valid rustup overrides. For a selecting
        # toolchain file, use the selected rustc sysroot as an unambiguous path
        # toolchain.
        $stableArgs = @({{ anvil_stable_toolchain_arg }})
        $baselineToolchain = if (-not [string]::IsNullOrWhiteSpace($env:RUSTUP_TOOLCHAIN)) {
            $env:RUSTUP_TOOLCHAIN.Trim()
        } elseif ($stableArgs.Count -eq 1) {
            ([string] $stableArgs[0]).Substring(1)
        } else {
            $sysroot = @(& rustc --print sysroot)
            if ($LASTEXITCODE -ne 0 -or $sysroot.Count -ne 1 -or [string]::IsNullOrWhiteSpace([string] $sysroot[0])) {
                Write-Error 'anvil-impact: rustc could not report the current checkout stable toolchain sysroot'
                exit 1
            }
            ([string] $sysroot[0]).Trim()
        }

        # Temp-root precedence follows the runner-managed scratch dir on each
        # host: RUNNER_TEMP on GitHub Actions, AGENT_TEMPDIRECTORY on Azure
        # Pipelines -- both are job-owned and cleaned up by the runner, so the
        # throwaway worktree never leaks into the workspace or survives the job.
        # Local runs fall back to the system temp dir. A fresh nonce prevents
        # collisions with abandoned directories when the OS reuses a PID.
        $tmpRoot = $env:RUNNER_TEMP
        if (-not $tmpRoot) { $tmpRoot = $env:AGENT_TEMPDIRECTORY }
        if (-not $tmpRoot) { $tmpRoot = [System.IO.Path]::GetTempPath() }
        $wt = Join-Path $tmpRoot "anvil-baseline-$PID-$([System.Guid]::NewGuid().ToString('N'))"
        # GIT_LFS_SKIP_SMUDGE=1: the worktree inherits the repo config but not
        # the credential helper, so LFS smudge would fail. cargo-delta only
        # needs file content hashes; LFS pointer files hash consistently.
        $env:GIT_LFS_SKIP_SMUDGE = '1'
        $baselineFailed = $false
        $baselineNoWorkspace = $false
        $baseSnap = $null
        try {
            $worktreeOutput = @(git worktree add --detach $wt $baseSha 2>&1)
            if ($LASTEXITCODE -ne 0) {
                throw "anvil-impact: failed to create baseline worktree at ${wt}: $($worktreeOutput -join [Environment]::NewLine)"
            }
            if (-not (Test-Path (Join-Path $wt 'Cargo.toml'))) {
                # First-time anvil adoption: the base predates the cargo
                # workspace (no root Cargo.toml), so there is nothing for
                # cargo-delta to snapshot. Record a marker; anvil-impact falls
                # back to full-workspace validation rather than failing.
                Write-Host "anvil-impact: base '$base' has no root Cargo.toml (first-time adoption?); falling back to full-workspace"
                $baselineNoWorkspace = $true
            } else {
                Push-Location $wt
                # Override only this baseline subprocess scope, then restore the
                # caller's input override before returning to the current tree.
                $hadToolchain = Test-Path Env:\RUSTUP_TOOLCHAIN
                $priorToolchain = if ($hadToolchain) { $env:RUSTUP_TOOLCHAIN } else { $null }
                try {
                    $env:RUSTUP_TOOLCHAIN = $baselineToolchain
                    $baseSnap = cargo delta @deltaArgs snapshot
                    if ($LASTEXITCODE -ne 0) { throw 'cargo delta snapshot (baseline) failed' }
                } finally {
                    if ($hadToolchain) {
                        $env:RUSTUP_TOOLCHAIN = $priorToolchain
                    } else {
                        Remove-Item Env:\RUSTUP_TOOLCHAIN -ErrorAction SilentlyContinue
                    }
                    Pop-Location
                }
            }
        } catch {
            $baselineFailed = $true
            throw
        } finally {
            $cleanupFailures = [System.Collections.Generic.List[string]]::new()
            $worktreeOutput = @(git worktree list --porcelain -z)
            $listFailed = $LASTEXITCODE -ne 0
            if ($listFailed) {
                $cleanupFailures.Add("failed to list worktrees: $($worktreeOutput -join [Environment]::NewLine)")
            }
            $worktrees = if ($listFailed) { @() } else { ($worktreeOutput -join "`n").Split([char] 0) }
            $registeredPath = 'worktree ' + $wt.Replace([System.IO.Path]::DirectorySeparatorChar, [char] '/')
            if ($listFailed -or $worktrees -contains $registeredPath) {
                $cleanupOutput = @(git worktree remove --force --force $wt 2>&1)
                if ($LASTEXITCODE -ne 0) {
                    $cleanupFailures.Add("failed to remove baseline worktree at ${wt}: $($cleanupOutput -join [Environment]::NewLine)")
                }
            }
            try {
                if (Test-Path -LiteralPath $wt) {
                    Remove-Item -LiteralPath $wt -Recurse -Force -ErrorAction Stop
                }
            } catch {
                $cleanupFailures.Add("failed to remove baseline directory at ${wt}: $($_.Exception.Message)")
            }
            if ($cleanupFailures.Count -gt 0) {
                $cleanupMessage = "anvil-impact: baseline cleanup failed: $($cleanupFailures -join '; ')"
                if ($baselineFailed) {
                    Write-Warning -Message $cleanupMessage -WarningAction Continue
                } else {
                    throw $cleanupMessage
                }
            }
        }

        # Publish baseline cache files only after the snapshot succeeds. A
        # workspace-wide mutex serializes replacement for concurrent local
        # invocations, while dirty runs copy their selected baseline into the
        # immutable generation before releasing it.
        if (-not $baselineNoWorkspace -and -not $baseSnap) {
            throw 'cargo-delta did not produce a baseline snapshot'
        }
        try {
            [void]$baselineMutex.WaitOne()
            if ($baselineNoWorkspace) {
                Remove-Item -LiteralPath $baselineJson -ErrorAction SilentlyContinue
                New-Item -ItemType File -Path $noWorkspaceMarker -Force | Out-Null
                if ($dirty) {
                    New-Item -ItemType File -Path $generationNoWorkspaceMarker -Force | Out-Null
                    Remove-Item -LiteralPath $generationBaselineJson -ErrorAction SilentlyContinue
                }
            } else {
                Set-Content -LiteralPath $baselineJson -Value $baseSnap -Encoding UTF8
                Remove-Item -LiteralPath $noWorkspaceMarker -ErrorAction SilentlyContinue
                if ($dirty) {
                    Set-Content -LiteralPath $generationBaselineJson -Value $baseSnap -Encoding UTF8
                    Remove-Item -LiteralPath $generationNoWorkspaceMarker -ErrorAction SilentlyContinue
                }
            }
            Set-Content -LiteralPath $baselineKeyFile -Value $baselineKey -Encoding UTF8 -NoNewline
            if ($dirty) {
                Set-Content -LiteralPath $generationBaselineKey -Value $baselineKey -Encoding UTF8 -NoNewline
            }
        } finally {
            $baselineMutex.ReleaseMutex()
        }
    }
    if ($dirty -and $haveBaseline) {
        try {
            [void]$baselineMutex.WaitOne()
            $actualKey = "$(Get-Content -Raw -LiteralPath $baselineKeyFile)".Trim()
            if ($actualKey -ne $baselineKey) {
                Write-Error "anvil-impact: baseline '$base' changed while publishing dirty impact; rerun the command."
                exit 1
            }
            if (Test-Path -LiteralPath $noWorkspaceMarker -PathType Leaf) {
                New-Item -ItemType File -Path $generationNoWorkspaceMarker -Force | Out-Null
            } else {
                Copy-Item -LiteralPath $baselineJson -Destination $generationBaselineJson -Force
            }
            Set-Content -LiteralPath $generationBaselineKey -Value $baselineKey -Encoding UTF8 -NoNewline
        } finally {
            $baselineMutex.ReleaseMutex()
        }
    }

    # --- Current snapshot: clean content is cached by HEAD, while dirty
    # content is always captured fresh from the filesystem. ---
    $haveCurrent = (-not $dirty) -and (Test-Path $currentJson) -and (Test-Path $currentKeyFile) -and `
        ("$(Get-Content -Raw $currentKeyFile)".Trim() -eq $currentState)
    if ($haveCurrent) {
        Write-Host 'anvil-impact: current snapshot up to date'
    } else {
        if ($dirty) {
            Write-Host 'anvil-impact: snapshotting dirty working tree'
        } else {
            Write-Host 'anvil-impact: snapshotting working tree'
        }
        $curSnap = & cargo @stableArgs delta @deltaArgs snapshot
        if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-impact: cargo delta snapshot (current) failed'; exit 1 }
        Set-Content -LiteralPath $currentJson -Value $curSnap -Encoding UTF8
        if (-not $dirty) {
            Set-Content -LiteralPath $currentKeyFile -Value $currentState -Encoding UTF8 -NoNewline
        }
    }
