anvil_release_mode := if env("ANVIL_RELEASE", "") == "" {
    ""
} else if env("ANVIL_RELEASE") == "consume" {
    "consume"
} else {
    error("ANVIL_RELEASE must be unset or 'consume'")
}

anvil_release_input_dir := if anvil_release_mode == "consume" {
    env("ANVIL_RELEASE_INPUT_DIR", "target/anvil/release")
} else {
    "target/anvil/release"
}

anvil_release_selection := "--package-file " + quote(anvil_release_input_dir + "/candidates.packages")

# Collect release candidates independently of source-change impact.
[group("anvil")]
[script("pwsh", "-NoProfile")]
anvil-release-candidates: anvil-release-candidates-validate-prereqs
    $ErrorActionPreference = 'Stop'
    Set-StrictMode -Version 3
    $outputFile = Join-Path '{{ replace(anvil_release_input_dir, "'", "''") }}' 'candidates.packages'
    if ('{{ anvil_release_mode }}' -eq 'consume') {
        & cargo {{_anvil_stable_toolchain_args}} each --package-file $outputFile --once --dry-run -- cargo package '{packages}'
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
        exit 0
    }

    if (Test-Path -LiteralPath $outputFile) { Remove-Item -LiteralPath $outputFile }
    $stableArgs = {{_anvil_stable_toolchain_args}}
    $root = '{{ replace(justfile_directory(), "'", "''") }}'

    function Get-WorkspacePackages([string] $manifest) {
        $json = & cargo @stableArgs metadata --no-deps --format-version 1 --manifest-path $manifest
        if ($LASTEXITCODE -ne 0) { throw "anvil-release-candidates: cargo metadata failed for '$manifest'" }
        $metadata = ($json -join "`n") | ConvertFrom-Json
        $members = [Collections.Generic.HashSet[string]]::new([string[]] $metadata.workspace_members, [StringComparer]::Ordinal)
        return @($metadata.packages | Where-Object { $members.Contains([string] $_.id) })
    }

    $current = @(Get-WorkspacePackages (Join-Path $root 'Cargo.toml'))
    $base = & '{{ replace(just_executable(), "'", "''") }}' --justfile '{{ replace(justfile(), "'", "''") }}' _anvil-base-ref
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $base = ($base -join "`n").Trim()
    $commit = git rev-parse --verify --end-of-options "$base^{commit}"
    if ($LASTEXITCODE -ne 0) { throw "anvil-release-candidates: baseline '$base' is unavailable; fetch it or set BASE_REF to a local commit" }
    $prefix = git rev-parse --show-prefix
    if ($LASTEXITCODE -ne 0) { throw 'anvil-release-candidates: cannot locate workspace inside the Git repository' }

    # A baseline toolchain file must not install or select a different compiler.
    $sysroot = & rustc @stableArgs --print sysroot
    if ($LASTEXITCODE -ne 0 -or @($sysroot).Count -ne 1) { throw 'anvil-release-candidates: cannot resolve the current compiler sysroot' }
    $oldToolchain = $env:RUSTUP_TOOLCHAIN
    $oldSmudge = $env:GIT_LFS_SKIP_SMUDGE
    $tempRoot = if ($env:RUNNER_TEMP) { $env:RUNNER_TEMP } elseif ($env:AGENT_TEMPDIRECTORY) { $env:AGENT_TEMPDIRECTORY } else { [IO.Path]::GetTempPath() }
    $snapshot = Join-Path $tempRoot ("anvil-release-" + [guid]::NewGuid().ToString('N'))
    $created = $false
    try {
        $env:GIT_LFS_SKIP_SMUDGE = '1'
        git worktree add --detach $snapshot ($commit -join "`n").Trim()
        if ($LASTEXITCODE -ne 0) { throw 'anvil-release-candidates: cannot create isolated baseline worktree' }
        $created = $true
        $env:RUSTUP_TOOLCHAIN = ([string] $sysroot).Trim()
        $baselineRoot = Join-Path $snapshot ([string] $prefix).Trim()
        $manifest = Join-Path $baselineRoot 'Cargo.toml'
        $previous = if (Test-Path -LiteralPath $manifest -PathType Leaf) {
            Push-Location $baselineRoot
            try { @(Get-WorkspacePackages $manifest) } finally { Pop-Location }
        } else {
            Write-Host 'anvil-release-candidates: baseline predates the workspace'
            @()
        }
    } finally {
        $env:RUSTUP_TOOLCHAIN = $oldToolchain
        $env:GIT_LFS_SKIP_SMUDGE = $oldSmudge
        if ($created) {
            git worktree remove --force $snapshot
            if ($LASTEXITCODE -ne 0) { throw "anvil-release-candidates: cannot remove temporary baseline worktree '$snapshot'" }
        }
    }

    $versions = [Collections.Generic.Dictionary[string,string]]::new([StringComparer]::Ordinal)
    foreach ($package in $previous) { $versions.Add([string] $package.name, [string] $package.version) }
    $candidates = [Collections.Generic.SortedSet[string]]::new([StringComparer]::Ordinal)
    foreach ($package in $current) {
        if ($package.publish -is [array] -and $package.publish.Count -eq 0) { continue }
        if (-not $versions.ContainsKey($package.name) -or $versions[$package.name] -cne $package.version) {
            [void] $candidates.Add("$($package.name)@$($package.version)")
        }
    }
    [void] [IO.Directory]::CreateDirectory((Split-Path -Parent $outputFile))
    $pendingFile = "$outputFile.$([guid]::NewGuid().ToString('N')).tmp"
    try {
        [IO.File]::WriteAllLines($pendingFile, [string[]] $candidates, [Text.UTF8Encoding]::new($false))
        Move-Item -LiteralPath $pendingFile -Destination $outputFile -Force
    } finally {
        if (Test-Path -LiteralPath $pendingFile) { Remove-Item -LiteralPath $pendingFile }
    }
    if ($candidates.Count -eq 0) {
        Write-Host "anvil-release-candidates: no release candidates; skipping -> $outputFile"
    } else {
        Write-Host "anvil-release-candidates: selected $($candidates.Count) package(s) -> $outputFile"
    }

