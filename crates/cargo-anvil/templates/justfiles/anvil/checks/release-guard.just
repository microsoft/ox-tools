# Publication intent is independent of source impact, including dirty-tree
# full-workspace fallbacks. Candidate selection and preparation belong to the tool.
[script("pwsh", "-NoProfile")]
anvil-release-guard: anvil-release-guard-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $base = (& "{{ just_executable() }}" _anvil-base-ref)
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    $outputDir = Join-Path 'target/anvil/release' ([Guid]::NewGuid().ToString('N'))
    Write-Host "anvil-release-guard: preserving this run's artifacts in $outputDir"
    & cargo {{_anvil_stable_toolchain_args}} release-guard check --base $base --manifest-path Cargo.toml --output-dir $outputDir --test-runner cargo --feature-mode all --feature-mode default --feature-mode no-default
    exit $LASTEXITCODE

# Install the guard and nextest test support. Cargo orchestrates the publication
# suite; the guard's own tests also exercise its optional nextest runner.
[group("anvil-setup")]
anvil-release-guard-setup installer="install": (anvil-tool-cargo-release-guard-install installer) (anvil-tool-cargo-nextest-install installer)

# Validate prerequisites without installing tools.
[group("anvil-setup")]
anvil-release-guard-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-cargo-release-guard-validate-prereqs anvil-tool-cargo-nextest-validate-prereqs
