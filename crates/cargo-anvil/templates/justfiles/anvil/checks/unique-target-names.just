# Unscoped. A collision is a property of the whole workspace, and only one
# member of a contending pair needs to appear in a diff to create one -- an
# impact-scoped run would pass on the very change that introduces it. Reads
# `cargo metadata` only, so the full workspace costs no compilation. Single
# command, but run under pwsh so it does not depend on the adopter's default
# shell (absent/varying on Windows).

# Check that no two workspace targets uplift to the same build artifact.
[script("pwsh", "-NoProfile")]
anvil-unique-target-names: anvil-unique-target-names-validate-prereqs
    $ErrorActionPreference = 'Stop'
    & cargo {{_anvil_stable_toolchain_args}} unique-target-names
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Install prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-setup installer="install": (anvil-tool-cargo-unique-target-names-install installer)

# Validate prerequisites for the `anvil-unique-target-names` recipe.
[group("anvil-setup")]
anvil-unique-target-names-validate-prereqs: anvil-tool-cargo-unique-target-names-validate-prereqs
