# Modified tier. cargo-unused-deps reads the workspace root and every member
# manifest in one pass, so impact decides whether the check runs but does not
# narrow the command to selected packages.

# Check that every workspace dependency is inherited by a member.
[script("pwsh", "-NoProfile")]
anvil-unused-deps: anvil-unused-deps-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    $include = (& "{{ just_executable() }}" _anvil-impact-include modified)
    if ($include -eq '--skip') { Write-Host 'anvil-unused-deps: no modified packages; skipping'; exit 0 }
    & cargo {{_anvil_stable_toolchain_args}} unused-deps
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Install prerequisites for the `anvil-unused-deps` recipe.
[group("anvil-setup")]
anvil-unused-deps-setup installer="install": (anvil-tool-cargo-unused-deps-install installer)

# Validate prerequisites for the `anvil-unused-deps` recipe.
[group("anvil-setup")]
anvil-unused-deps-validate-prereqs: anvil-tool-cargo-unused-deps-validate-prereqs
