# Opt-in full-workspace release-profile validation. This group is deliberately
# outside the PR, scheduled, and full tiers because optimized validation is
# expensive and repository-specific. It never consults impact data.

# Run full-workspace Clippy and tests with Cargo's release profile.
[group("anvil")]
[script("pwsh", "-NoProfile")]
anvil-release-profile: anvil-release-profile-validate-prereqs
    $ErrorActionPreference = 'Stop'
    & cargo {{_anvil_stable_toolchain_args}} clippy --workspace --all-targets --all-features --locked --profile release "--" '-D' 'warnings'
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

    $resultsDirectory = Join-Path (Get-Location) 'target/anvil/test-results'
    New-Item -ItemType Directory -Force -Path $resultsDirectory | Out-Null
    $configPath = Join-Path $resultsDirectory 'release-profile-nextest.toml'
    $reportPath = Join-Path $resultsDirectory 'release-profile.xml'
    $nextestReportPath = Join-Path (Get-Location) 'target/nextest/anvil-release-profile/release-profile.xml'
    foreach ($staleReport in @($reportPath, $nextestReportPath)) {
        if (Test-Path -LiteralPath $staleReport) {
            Remove-Item -LiteralPath $staleReport -Force
        }
    }
    @'
    [profile.anvil-release-profile.junit]
    path = "release-profile.xml"
    '@ | Set-Content -LiteralPath $configPath -Encoding utf8NoBOM

    & cargo {{_anvil_stable_toolchain_args}} nextest run --config-file $configPath --profile anvil-release-profile --cargo-profile release --workspace --all-features --locked
    $nextestExit = $LASTEXITCODE
    if (Test-Path -LiteralPath $nextestReportPath) {
        Copy-Item -LiteralPath $nextestReportPath -Destination $reportPath -Force
    } elseif ($nextestExit -eq 0) {
        Write-Error "anvil-release-profile: nextest succeeded without writing $nextestReportPath"
        exit 1
    }
    if ($nextestExit -ne 0) { exit $nextestExit }

    & cargo {{_anvil_stable_toolchain_args}} test --doc --workspace --all-features --locked --profile release
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Install prerequisites for the `anvil-release-profile` recipe.
[private]
anvil-release-profile-setup installer="install": anvil-component-default-clippy-install (anvil-tool-cargo-nextest-install installer)

# Validate prerequisites for the `anvil-release-profile` recipe.
[private]
anvil-release-profile-validate-prereqs: anvil-component-default-clippy-validate-prereqs anvil-tool-cargo-nextest-validate-prereqs
