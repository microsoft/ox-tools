{
  "name": "anvil-container",
  "image": "__IMAGE__",
  "workspaceFolder": "__WORKDIR__",
  "workspaceMount": "source=${localWorkspaceFolder},target=__WORKDIR__,type=bind",
  "mounts": __MOUNTS_JSON__,
  "containerEnv": {
    "ANVIL_IN_CONTAINER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
