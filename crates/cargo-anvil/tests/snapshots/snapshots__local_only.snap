#
# Pinned versions used by the anvil check tree.

#
# Everything anvil installs (cargo subcommands + rustup toolchains)
# is pinned here. The pinning policy:
#   - On install (`-install` recipes): exactly this version (`=<pin>` for
#     cargo subcommands, exact ref for rustup toolchains). Pulling
#     "latest-matching" at install time is a cloud-workflow reproducibility risk --
#     an upstream release between yesterday's green build and today's PR can
#     change behavior. The `=` constraint locks the install to the version the
#     catalog was validated against.
#   - On validate-prereqs (`-validate-prereqs` recipes): the installed
#     version must be `>= <pin>`. A user who has manually upgraded a
#     tool for their own reasons (e.g. needing an unreleased bugfix)
#     is not downgraded by setup. The validate gate uses
#     `installed >= pin`, so newer is fine.
#
# To bump a pin, edit the version in place and re-run
# `cargo anvil`. The dirty-file flow preserves the edit on
# subsequent runs. To add a new tool, append a variable and the matching
# `-install`/`-validate-prereqs` pair in `tools.just`. To remove a tool,
# delete its variable and recipes (and any check that depends on them).

# ============================================================================
# Rustup toolchains
# ============================================================================

# General nightly used by udeps, miri, careful, and any future
# nightly-dependent check. Bumped on a regular cadence (monthly is a
# reasonable default) when an adopter has time to absorb formatting /
# lint / API-surface drift. Pin only -- do not use bare `nightly` here.
rust_nightly := "nightly-2026-05-30"

# Pinned narrowly to the rustdoc JSON schema version that the currently
# selected cargo-check-external-types release accepts. cargo-check-
# external-types embeds a specific rustdoc-types crate version; if the
# nightly's emitted JSON format_version drifts past it, every run fails
# with "produces JSON format version X, but this tool requires
# format version Y" -- which is a tooling-incompat, not a real API
# violation. Bump this alongside any cargo-check-external-types upgrade.
rust_nightly_external_types := "nightly-2026-03-20"

# ============================================================================
# Cargo subcommands
# ============================================================================

cargo_aprz_version := "1.2.0"
cargo_audit_version := "0.22.2"
cargo_bolero_version := "0.13.4"
cargo_careful_version := "0.4.10"
cargo_check_external_types_version := "0.5.0"
cargo_coverage_gate_version := "0.6.0"
cargo_delta_version := "0.4.0"
cargo_deny_version := "0.20.2"
cargo_doc2readme_version := "0.7.3"
cargo_each_version := "0.3.0"
cargo_ensure_no_cyclic_deps_version := "0.2.0"
cargo_ensure_no_default_features_version := "1.1.0"
cargo_hack_version := "0.6.45"
cargo_heather_version := "0.3.0"
cargo_llvm_cov_version := "0.9.0"
cargo_mutants_version := "27.1.0"
cargo_nextest_version := "0.9.143"
cargo_semver_checks_version := "0.50.0"
cargo_sort_version := "2.1.4"
cargo_spellcheck_version := "0.15.7"
cargo_udeps_version := "0.1.61"

# Scheduled groups execute a private group recipe in a child Just process so
# ANVIL_IMPACT=off is visible while that child's dependency graph is evaluated.
[private]
[script("pwsh", "-NoProfile")]
_anvil-unscoped name:
    $env:ANVIL_IMPACT = 'off'
    & '{{ replace(just_executable(), "'", "''") }}' --justfile '{{ replace(justfile(), "'", "''") }}' '_anvil-{{ replace(name, "'", "''") }}'
    exit $LASTEXITCODE

# cargo-delta owns Git inspection, merge-base snapshots, cache invalidation, and
# package projection. ANVIL_IMPACT=consume reads package files produced by an
# earlier job; ANVIL_IMPACT=off selects the complete workspace.
anvil_impact_mode := if env("ANVIL_IMPACT", "") == "" {
    ""
} else if env("ANVIL_IMPACT") == "consume" {
    "consume"
} else if env("ANVIL_IMPACT") == "off" {
    "off"
} else {
    error("ANVIL_IMPACT must be unset, 'consume', or 'off'")
}

anvil_impact_input_dir := if anvil_impact_mode == "consume" {
    env("ANVIL_IMPACT_INPUT_DIR", "target/anvil/impact")
} else {
    "target/anvil/impact"
}

anvil_impact_compute_prefix := if anvil_impact_mode == "" { "" } else { "# " }

anvil_base_ref := if env("BASE_REF", "") == "" {
    if env("SYSTEM_PULLREQUEST_TARGETBRANCH", "") == "" {
        if env("GITHUB_BASE_REF", "") == "" {
            "origin/main"
        } else {
            "origin/" + env("GITHUB_BASE_REF")
        }
    } else {
        "origin/" + replace(env("SYSTEM_PULLREQUEST_TARGETBRANCH"), "refs/heads/", "")
    }
} else {
    env("BASE_REF")
}

anvil_modified_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/modified.packages")
}

anvil_affected_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/affected.packages")
}

anvil_required_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/required.packages")
}

# Resolve the command toolchain without overriding either RUSTUP_TOOLCHAIN or a
# repository toolchain file. Repositories with neither use their declared
# workspace rust-version through cargo-each's portable placeholder.
anvil_stable_toolchain_arg := if env("RUSTUP_TOOLCHAIN", "") == "" {
    if path_exists(justfile_directory() + "/rust-toolchain.toml") {
        ""
    } else if path_exists(justfile_directory() + "/rust-toolchain") {
        ""
    } else {
        quote("+{workspace-rust-version}")
    }
} else {
    ""
}

anvil_stable_install_prefix := if anvil_stable_toolchain_arg == "" { "# " } else { "" }

# Compute package-file artifacts for the three impact tiers. In consume/off
# mode the interpolation comments out these command lines, making the recipe a
# no-op without shell control flow.
[group("anvil")]
anvil-impact:
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --modified --format packages --output target/anvil/impact/modified.packages
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --affected --format packages --output target/anvil/impact/affected.packages
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --required --format packages --output target/anvil/impact/required.packages

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# PR tier: every check that should run on every pull request, split
# into two groups so the fast checks aren't blocked behind the slow
# ones in cloud workflows.

# Run all pull request checks.
[group("anvil")]
anvil-pr: anvil-pr-validate-prereqs \
    anvil-pr-fast \
    anvil-pr-slow

# scheduled tier: full-workspace re-runs of things that can change
# without a commit (advisories, flakes) + the truly expensive
# exhaustive checks that don't fit in a PR budget. Runs on a schedule
# against `main`, not on PRs.
#
# The scheduled tier is deliberately NOT impact-scoped: it is the catch-all
# that backstops PR-tier scoping. Every impact-scoped check depends on
# `anvil-impact` and populates its own scope from the cache, so the tier runs
# with ANVIL_IMPACT=off, which makes every cargo-each selection use the
# complete workspace and the `anvil-impact` dependency no-op.
# A dependency-only recipe cannot set an environment variable for its own
# dependencies, so the public tier wraps the private one through
# `_anvil-unscoped`.

# Run all scheduled checks.
[group("anvil")]
anvil-scheduled: (_anvil-unscoped "scheduled")

[private]
_anvil-scheduled: anvil-scheduled-validate-prereqs \
    anvil-scheduled-test \
    anvil-scheduled-advisories \
    anvil-scheduled-runtime-analysis \
    anvil-scheduled-exhaustive

# Full-workspace for the same reason as the scheduled tier.

# Full tier: PR + scheduled, end-to-end. Useful before tagging a release.
[group("anvil")]
anvil-full: (_anvil-unscoped "full")

[private]
_anvil-full: anvil-full-validate-prereqs \
    anvil-pr \
    _anvil-scheduled

# Tier-level + global setup + validate-prereqs
# ===========================================================================
#
# Per-tier recipes that fan out to per-group setup/validate-prereqs from
# groups.just. The global `anvil-setup` / `anvil-validate-prereqs`
# recipes are the catch-all entry points that install / verify everything.
#
# Cloud workflows typically invoke only the per-group setup it needs (e.g. the
# `anvil-pr-fast` composite action / step template runs
# `anvil-pr-fast-setup` rather than the global `anvil-setup`).
# Local users who want "install everything" run `just anvil-setup`.

# Install prerequisites for the `anvil-pr` recipe.
[group("anvil-setup")]
anvil-pr-setup installer="install": \
    (anvil-pr-fast-setup installer) \
    (anvil-pr-slow-setup installer)

# Validate prerequisites for the `anvil-pr` recipe.
[group("anvil-setup")]
anvil-pr-validate-prereqs: \
    anvil-pr-fast-validate-prereqs \
    anvil-pr-slow-validate-prereqs

# Install prerequisites for the `anvil-scheduled` recipe.
[group("anvil-setup")]
anvil-scheduled-setup installer="install": \
    (anvil-scheduled-test-setup installer) \
    (anvil-scheduled-advisories-setup installer) \
    (anvil-scheduled-runtime-analysis-setup installer) \
    (anvil-scheduled-exhaustive-setup installer)

# Validate prerequisites for the `anvil-scheduled` recipe.
[group("anvil-setup")]
anvil-scheduled-validate-prereqs: \
    anvil-scheduled-test-validate-prereqs \
    anvil-scheduled-advisories-validate-prereqs \
    anvil-scheduled-runtime-analysis-validate-prereqs \
    anvil-scheduled-exhaustive-validate-prereqs

# Install prerequisites for the `anvil-full` recipe.
[group("anvil-setup")]
anvil-full-setup installer="install": \
    (anvil-pr-setup installer) \
    (anvil-scheduled-setup installer)

# Validate prerequisites for the `anvil-full` recipe.
[group("anvil-setup")]
anvil-full-validate-prereqs: \
    anvil-pr-validate-prereqs \
    anvil-scheduled-validate-prereqs

# Global aliases. `anvil-setup` (no suffix) installs everything the
# catalog knows about; `anvil-validate-prereqs` verifies every tool
# and component is present at or above its pinned version.
#
# cargo-delta (the impact-analysis tool) is a prerequisite of every group
# whose checks are impact-scoped: those checks depend on `anvil-impact`,
# which invokes cargo-delta when it has to (re)compute the impact set, so
# each such group's `-setup` / `-validate-prereqs` installs / verifies it
# (fail-fast, rather than discovering it missing mid-run). In a cloud
# workflow a group job normally consumes the downloaded impact artifact and
# never actually runs cargo-delta, but the tool is guaranteed present.
# `anvil-setup` also lists it explicitly as the catch-all (harmless -- just
# dedups the fan-out).

# Install every tool and component in the anvil catalog.
[group("anvil-setup")]
anvil-setup installer="install": (anvil-full-setup installer) (anvil-tool-cargo-delta-install installer)

# Validate every tool and component in the anvil catalog.
[group("anvil-setup")]
anvil-validate-prereqs: anvil-full-validate-prereqs anvil-tool-cargo-delta-validate-prereqs

# Build all targets and features for local development.
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("profile", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
anvil-build package="" profile="": anvil-build-validate-prereqs
    cargo each {{ if package == "" { "--workspace" } else { "--package " + quote(package) } }} --once -- cargo {{ anvil_stable_toolchain_arg }} build '{packages}' {{ if profile == "" { "" } else { "--profile " + quote(profile) } }} --all-features --all-targets --locked

# Install prerequisites for the `anvil-build` recipe.
[group("anvil-setup")]
anvil-build-setup installer="install": (anvil-toolchain-stable-install installer)

# Validate prerequisites for the `anvil-build` recipe.
[group("anvil-setup")]
anvil-build-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-cargo-each-validate-prereqs

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# cargo-aprz discovers credentials from its explicit flag, GITHUB_TOKEN, and
# (when opted in below) the authenticated gh CLI before falling back to
# anonymous access. Unscoped because it consults an external risk database.

# Analyze dependency features and version requirements with cargo-aprz.
anvil-aprz: anvil-aprz-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} aprz deps --github-token-from-gh --error-if-high-risk --console appraisal

# Install prerequisites for the `anvil-aprz` recipe.
[group("anvil-setup")]
anvil-aprz-setup installer="install": (anvil-tool-cargo-aprz-install installer) (anvil-tool-cargo-each-install installer)

# Validate prerequisites for the `anvil-aprz` recipe.
[group("anvil-setup")]
anvil-aprz-validate-prereqs: anvil-tool-cargo-aprz-validate-prereqs anvil-tool-cargo-each-validate-prereqs

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (consults external advisory DB; reads Cargo.lock).

# Audit dependencies for known security vulnerabilities.
anvil-audit: anvil-audit-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} audit

# Install prerequisites for the `anvil-audit` recipe.
[group("anvil-setup")]
anvil-audit-setup installer="install": (anvil-tool-cargo-audit-install installer) (anvil-tool-cargo-each-install installer)

# Validate prerequisites for the `anvil-audit` recipe.
[group("anvil-setup")]
