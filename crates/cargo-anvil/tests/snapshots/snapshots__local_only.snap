# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Required tier. cargo doc resolves intra-doc links through the dep
# graph, so a dep changing its public API can break doc-build in a
# crate that wasn't itself modified.

# Build documentation for required workspace packages.
[arg("open", long, value="true")]
anvil-doc-build open="false": anvil-doc-build-validate-prereqs anvil-impact
    cargo each {{ anvil_required_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} doc '{packages}' --config {{ quote('build.rustdocflags=["-D","warnings"]') }} --all-features --no-deps {{ if open == "true" { "--open" } else { "" } }}

# doc-build, examples and doc-test are pure cargo built-ins; the rust
# toolchain (rustc + cargo) is the only prerequisite, and we already
# rely on it being present everywhere anvil runs.

# Install prerequisites for the `anvil-doc-build` recipe.
[group("anvil-setup")]
anvil-doc-build-setup installer="install": (anvil-toolchain-stable-install installer)

# Validate prerequisites for the `anvil-doc-build` recipe.
[group("anvil-setup")]
anvil-doc-build-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-cargo-each-validate-prereqs

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Two cargo-test invocations cover both feature
# configurations: --all-features catches doctests that only compile
# with optional features enabled; the default-features run catches
# doctests that only compile when those features are off. The
# duplication is cheap because doctests are already a small fraction
# of total compile/test time.

# Run documentation tests for affected workspace packages.
anvil-doc-test: anvil-doc-test-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} test --doc '{packages}' --all-features --locked
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} test --doc '{packages}' --locked

# Install prerequisites for the `anvil-doc-test` recipe.
[group("anvil-setup")]
