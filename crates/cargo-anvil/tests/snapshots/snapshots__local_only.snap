---
source: crates/cargo-anvil/tests/snapshots.rs
expression: render_tree(tmp.path())
---
=== .anvil/anvil.just ===
# Copyright (c) Microsoft Corporation.
# Licensed under the MIT License.
# GENERATED BY cargo-anvil. DO NOT EDIT DIRECTLY.
# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Update behaviour: https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/updates.md

# Friendly default: `just anvil` runs the PR tier.
alias anvil := anvil-pr

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/local.md

set lazy
set lists

# Cargo's inventory is captured once, and only when a setup or validation
# recipe actually references it.
installed_cargo_tools := `cargo install --list`
cargo_binstall_version := replace_regex(installed_cargo_tools, '(?ms)\A.*^cargo-binstall v([^:\r\n]+):\r?$.*\z', '$1')
cargo_binstall_found := if cargo_binstall_version == installed_cargo_tools { "false" } else { "true" }
bolero_command_prefix := if os() == "linux" { "" } else { "# " }
mutants_command_prefix := if os() == "windows" { if arch() == "aarch64" { "# " } else { "" } } else { "" }

# Install exactly the catalog version when the installed version is too old.
# A newer local version is accepted. `binstall` is binary-only and never falls
# back to compilation; installer mode is caller policy.
[arg("installer", pattern="^(install|binstall)$")]
_install-tool name minimum installer="install" \
    extracted=(replace_regex(installed_cargo_tools, ('(?ms)\A.*^' + name + ' v([^:\r\n]+):\r?$.*\z'), '$1')) \
    found=(if extracted == installed_cargo_tools { "false" } else { "true" }) \
    installed=(if found == "true" { extracted } else { "" }) \
    satisfied=(if found == "true" { semver_matches(installed, ">=" + minimum) } else { "false" }) \
    source_command=(if name == "cargo-each" { "cargo install --locked --version =" + minimum + " " + name } else if anvil_stable_toolchain_arg == "" { "cargo install --locked --version =" + minimum + " " + name } else { "cargo each --workspace --once -- cargo " + anvil_stable_toolchain_arg + " install --locked --version =" + minimum + " " + name }) \
    binary_command=(if name == "cargo-each" { "cargo binstall --no-confirm --locked --disable-strategies compile --version =" + minimum + " " + name } else if anvil_stable_toolchain_arg == "" { "cargo binstall --no-confirm --locked --disable-strategies compile --version =" + minimum + " " + name } else { "cargo each --workspace --once -- cargo " + anvil_stable_toolchain_arg + " binstall --no-confirm --locked --disable-strategies compile --version =" + minimum + " " + name }):
    {{ if satisfied == "true" { "# cargo-binstall not needed" } else if installer == "binstall" { if cargo_binstall_found == "true" { "# cargo-binstall already available" } else { "cargo install --locked cargo-binstall" } } else { "# cargo-binstall not needed" } }}
    {{ if satisfied == "true" { "# " + name + " " + installed + " satisfies >= " + minimum } else if installer == "install" { source_command } else { binary_command } }}

# Fail before a check starts when a required Cargo tool is missing or too old.
_check-tool name minimum \
    extracted=(replace_regex(installed_cargo_tools, ('(?ms)\A.*^' + name + ' v([^:\r\n]+):\r?$.*\z'), '$1')) \
    found=(if extracted == installed_cargo_tools { "false" } else { "true" }) \
    installed=(if found == "true" { extracted } else { "" }) \
    satisfied=(if found == "true" { semver_matches(installed, ">=" + minimum) } else { "false" }):
    {{ if satisfied == "true" { "# " + name + " " + installed + " satisfies >= " + minimum } else { error(name + " >= " + minimum + " is required; run its setup recipe") } }}

# cargo-each is the bootstrap tool. It installs with the Cargo already
# available to the caller, then resolves the workspace rust-version fallback
# used to provision and run the remaining tools.
[group("anvil-setup")]
anvil-tool-cargo-each-install installer="install": (_install-tool "cargo-each" cargo_each_version installer)

[group("anvil-setup")]
anvil-tool-cargo-each-validate-prereqs: (_check-tool "cargo-each" cargo_each_version)

[group("anvil-setup")]
anvil-toolchain-stable-install installer="install": (anvil-tool-cargo-each-install installer)
    {{ anvil_stable_install_prefix }}cargo each --workspace --once -- rustup toolchain install '{workspace-rust-version}' --profile minimal

[group("anvil-setup")]
anvil-tool-rustc-validate-prereqs: anvil-tool-cargo-each-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} --version

[group("anvil-setup")]
anvil-tool-pwsh-validate-prereqs:
    pwsh --version

# Pinned nightly toolchains.
[group("anvil-setup")]
anvil-toolchain-nightly-install:
    rustup toolchain install {{ rust_nightly }} --profile minimal

[group("anvil-setup")]
anvil-toolchain-nightly-validate-prereqs:
    rustup run {{ rust_nightly }} rustc --version

[group("anvil-setup")]
anvil-toolchain-nightly-external-types-install:
    rustup toolchain install {{ rust_nightly_external_types }} --profile minimal

[group("anvil-setup")]
anvil-toolchain-nightly-external-types-validate-prereqs:
    rustup run {{ rust_nightly_external_types }} rustc --version

# Rustup components. Stable components honor RUSTUP_TOOLCHAIN or a repository
# toolchain file; repositories with neither use the workspace rust-version.
_install-component toolchain component:
    {{ if toolchain == "default" { if anvil_stable_toolchain_arg == "" { "rustup component add " + component } else { "cargo each --workspace --once -- rustup component add --toolchain '{workspace-rust-version}' " + component } } else { "rustup component add --toolchain " + toolchain + " " + component } }}

[group("anvil-setup")]
anvil-component-default-clippy-install installer="install": (anvil-toolchain-stable-install installer) (_install-component "default" "clippy")

[group("anvil-setup")]
anvil-component-default-clippy-validate-prereqs: anvil-tool-cargo-each-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} clippy --version

[group("anvil-setup")]
anvil-component-default-rustfmt-install installer="install": (anvil-toolchain-stable-install installer) (_install-component "default" "rustfmt")

[group("anvil-setup")]
anvil-component-default-rustfmt-validate-prereqs: anvil-tool-cargo-each-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} fmt --version

[group("anvil-setup")]
anvil-component-nightly-rustfmt-install: anvil-toolchain-nightly-install (_install-component rust_nightly "rustfmt")

[group("anvil-setup")]
anvil-component-nightly-rustfmt-validate-prereqs: anvil-toolchain-nightly-validate-prereqs
    cargo +{{ rust_nightly }} fmt --version

[group("anvil-setup")]
anvil-component-nightly-miri-install: anvil-toolchain-nightly-install (_install-component rust_nightly "miri")

[group("anvil-setup")]
anvil-component-nightly-miri-validate-prereqs: anvil-toolchain-nightly-validate-prereqs
    cargo +{{ rust_nightly }} miri --version

[group("anvil-setup")]
anvil-component-nightly-rust-src-install: anvil-toolchain-nightly-install (_install-component rust_nightly "rust-src")

[group("anvil-setup")]
anvil-component-nightly-rust-src-validate-prereqs: anvil-toolchain-nightly-validate-prereqs
    rustup run {{ rust_nightly }} rustc --print sysroot

[group("anvil-setup")]
anvil-component-nightly-llvm-tools-install: anvil-toolchain-nightly-install (_install-component rust_nightly "llvm-tools")

[group("anvil-setup")]
anvil-component-nightly-llvm-tools-validate-prereqs: anvil-toolchain-nightly-validate-prereqs
    rustup run {{ rust_nightly }} rustc --print sysroot

# Cargo subcommands.
[group("anvil-setup")]
anvil-tool-cargo-aprz-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-aprz" cargo_aprz_version installer)

[group("anvil-setup")]
anvil-tool-cargo-aprz-validate-prereqs: (_check-tool "cargo-aprz" cargo_aprz_version)

[group("anvil-setup")]
anvil-tool-cargo-audit-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-audit" cargo_audit_version installer)

[group("anvil-setup")]
anvil-tool-cargo-audit-validate-prereqs: (_check-tool "cargo-audit" cargo_audit_version)

[group("anvil-setup")]
anvil-tool-cargo-bolero-install installer="install": (anvil-toolchain-stable-install installer)
    {{ bolero_command_prefix }}{{ just_executable() }} _install-tool cargo-bolero {{ cargo_bolero_version }} {{ installer }}

[group("anvil-setup")]
anvil-tool-cargo-bolero-validate-prereqs:
    {{ bolero_command_prefix }}{{ just_executable() }} _check-tool cargo-bolero {{ cargo_bolero_version }}

[group("anvil-setup")]
anvil-tool-cargo-careful-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-careful" cargo_careful_version installer)

[group("anvil-setup")]
anvil-tool-cargo-careful-validate-prereqs: (_check-tool "cargo-careful" cargo_careful_version)

[group("anvil-setup")]
anvil-tool-cargo-check-external-types-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-check-external-types" cargo_check_external_types_version installer)

[group("anvil-setup")]
anvil-tool-cargo-check-external-types-validate-prereqs: (_check-tool "cargo-check-external-types" cargo_check_external_types_version)

[group("anvil-setup")]
anvil-tool-cargo-coverage-gate-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-coverage-gate" cargo_coverage_gate_version installer)

[group("anvil-setup")]
anvil-tool-cargo-coverage-gate-validate-prereqs: (_check-tool "cargo-coverage-gate" cargo_coverage_gate_version)

[group("anvil-setup")]
anvil-tool-cargo-delta-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-delta" cargo_delta_version installer)

[group("anvil-setup")]
anvil-tool-cargo-delta-validate-prereqs: (_check-tool "cargo-delta" cargo_delta_version)

[group("anvil-setup")]
anvil-tool-cargo-deny-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-deny" cargo_deny_version installer)

[group("anvil-setup")]
anvil-tool-cargo-deny-validate-prereqs: (_check-tool "cargo-deny" cargo_deny_version)

[group("anvil-setup")]
anvil-tool-cargo-doc2readme-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-doc2readme" cargo_doc2readme_version installer)

[group("anvil-setup")]
anvil-tool-cargo-doc2readme-validate-prereqs: (_check-tool "cargo-doc2readme" cargo_doc2readme_version)

[group("anvil-setup")]
anvil-tool-cargo-ensure-no-cyclic-deps-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-ensure-no-cyclic-deps" cargo_ensure_no_cyclic_deps_version installer)

[group("anvil-setup")]
anvil-tool-cargo-ensure-no-cyclic-deps-validate-prereqs: (_check-tool "cargo-ensure-no-cyclic-deps" cargo_ensure_no_cyclic_deps_version)

[group("anvil-setup")]
anvil-tool-cargo-ensure-no-default-features-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-ensure-no-default-features" cargo_ensure_no_default_features_version installer)

[group("anvil-setup")]
anvil-tool-cargo-ensure-no-default-features-validate-prereqs: (_check-tool "cargo-ensure-no-default-features" cargo_ensure_no_default_features_version)

[group("anvil-setup")]
anvil-tool-cargo-hack-install installer="install": (anvil-toolchain-stable-install installer) (_install-tool "cargo-hack" cargo_hack_version installer)

[group("anvil-setup")]
