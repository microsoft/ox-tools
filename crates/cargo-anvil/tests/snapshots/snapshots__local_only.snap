# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier.

# Build all workspace benchmarks.
anvil-bench: anvil-bench-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} bench '{packages}' --all-features --no-run

# bench uses the cargo built-in in compile-only mode; no extra tool install
# is needed beyond the Rust toolchain.

# Install prerequisites for the `anvil-bench` recipe.
[group("anvil-setup")]
anvil-bench-setup installer="install": (anvil-toolchain-stable-install installer)

# Validate prerequisites for the `anvil-bench` recipe.
[group("anvil-setup")]
anvil-bench-validate-prereqs: anvil-tool-rustc-validate-prereqs anvil-tool-cargo-each-validate-prereqs

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Smoke-only fuzz pass via [bolero](https://crates.io/crates/bolero):
# each fuzz target gets a 60-second libfuzzer run, just enough to
# surface obvious crashes/hangs introduced by a PR without paying for
# a long fuzzing campaign.
#
# Linux-only: cargo-bolero's libfuzzer engine (and its bolero-afl
# build dependency) only builds on Linux, so the recipe self-skips on
# non-Linux hosts -- the pr-runtime-analysis Windows/ARM legs treat
# bolero as a no-op rather than a failure. This matches oxidizer's
# reference workflow, whose bolero job runs exclusively on ubuntu.
# Crates that ship bolero harnesses still get them compiled and
# exercised as ordinary tests by anvil-llvm-cov on every leg; the
# libfuzzer campaign is the Linux-only extra.
#
# Target discovery is `cargo +<nightly> bolero list --profile release` over the affected packages.
# Crates with no bolero harness print zero targets and the recipe
# no-ops. The libfuzzer engine requires nightly, so the test
# invocation uses the pinned rust_nightly. Adopters who want longer
# campaigns wire a separate scheduled job; anvil deliberately does
# not ship a long-form fuzz tier (the failure surface is too
# repo-specific to standardize).

# Run Bolero tests for affected workspace packages.
[script("pwsh", "-NoProfile")]
anvil-bolero: anvil-bolero-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    if (-not $IsLinux) {
        Write-Host 'anvil-bolero: non-Linux host -- skipping (cargo-bolero/libfuzzer is Linux-only; harnesses still run under anvil-llvm-cov)'
        exit 0
    }
    $targets = [System.Collections.Generic.List[object]]::new()
    $targetsJson = & cargo '+{{ rust_nightly }}' each {{ anvil_affected_selection }} -- cargo '+{{ rust_nightly }}' bolero list --profile release --package '{name}'
    if ($LASTEXITCODE -ne 0) {
        Write-Error 'anvil-bolero: target discovery failed'
        exit $LASTEXITCODE
    }
    try {
        foreach ($targetJson in ($targetsJson | Where-Object { $_ -match '^\{' })) {
            $targets.Add(($targetJson | ConvertFrom-Json))
        }
    } catch {
        Write-Error "anvil-bolero: could not parse target discovery output: $_"
        exit 1
    }
    if ($targets.Count -eq 0) {
        Write-Host 'anvil-bolero: no fuzz targets in affected packages; skipping'
        exit 0
    }
    $failed = $false
    foreach ($t in $targets) {
        $packageName = if ($t.package) { $t.package } else { $t.package_name }
        $testName = if ($t.test) { $t.test } elseif ($t.test_name) { $t.test_name } else { $t.target }
        if (-not $packageName -or -not $testName) {
            Write-Error "anvil-bolero: target discovery returned an unsupported object: $($t | ConvertTo-Json -Compress)"
            exit 1
        }
        Write-Host "anvil-bolero: ${packageName}::${testName}"
        & cargo '+{{ rust_nightly }}' bolero test --profile release --engine libfuzzer -T 60s --package $packageName $testName
        if ($LASTEXITCODE -ne 0) { $failed = $true }
    }
    if ($failed) { exit 1 }

# bolero needs cargo-bolero plus the pinned nightly toolchain
# (libfuzzer engine requires nightly rustc features).

# Install prerequisites for the `anvil-bolero` recipe.
[group("anvil-setup")]
anvil-bolero-setup installer="install": anvil-toolchain-nightly-install (anvil-tool-cargo-bolero-install installer) (anvil-tool-cargo-each-install installer)

# Validate prerequisites for the `anvil-bolero` recipe.
[group("anvil-setup")]
anvil-bolero-validate-prereqs: anvil-toolchain-nightly-validate-prereqs anvil-tool-cargo-bolero-validate-prereqs anvil-tool-cargo-each-validate-prereqs

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run tests with cargo-careful for affected workspace packages.
[script("pwsh", "-NoProfile")]
anvil-careful: anvil-careful-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    # Guard against cargo-careful's stale-sysroot hazard. cargo-careful
    # builds a custom std ("careful sysroot": debug-assertions + extra UB
    # checks) into a STABLE cache path -- ProjectDirs(de.ralfj.cargo-careful),
    # NOT keyed by rustc version -- and runs the workspace build with
    # `--sysroot <that stable path>`. cargo's fingerprint hashes the
    # RUSTFLAGS string (the stable sysroot *path*) but not the sysroot's
    # *contents*. So when the pinned nightly (or the careful tool, which sets
    # the std-build flags) changes, cargo-careful rebuilds that std in place
    # while cargo still considers the workspace artifacts up to date -- they
    # then link against a now-replaced std and fail with metadata /
    # "found crate compiled by an incompatible version of rustc" errors.
    #
    # cargo can't see this, so we track the careful build identity ourselves
    # (the nightly rustc -- commit hash et al. -- plus the resolved
    # cargo-careful executable's content hash) and `cargo clean` when it
    # changes, forcing the workspace to be rebuilt against the freshly-built
    # std. cargo-careful does not expose a version command: both
    # `cargo careful --version` and direct `cargo-careful --version` are
    # rejected. Hashing the executable identifies the code that cargo will
    # dispatch without relying on that unsupported interface. The marker
    # lives under target/, so it is wiped by the clean and travels with any
    # target/ cache.
    $rustcVV = (& rustc '+{{ rust_nightly }}' -vV | Out-String)
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-careful: could not query nightly rustc version'; exit 1 }
    $carefulCommand = Get-Command cargo-careful -ErrorAction SilentlyContinue
    if (-not $carefulCommand -or -not $carefulCommand.Source) {
        Write-Error 'anvil-careful: could not resolve the cargo-careful executable'
        exit 1
    }
    $carefulExecutableHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $carefulCommand.Source).Hash.ToLowerInvariant()
    $idSource = $rustcVV.Trim() + "`n$carefulExecutableHash"
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $idHash = ([System.BitConverter]::ToString($sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($idSource)))).Replace('-', '').ToLower()
    # Human-readable identity for log output: the first `rustc -vV` line
    # (e.g. "rustc 1.98.0-nightly (<hash> <date>)") plus the executable hash.
    $idLabel = "$(($rustcVV -split "`n")[0].Trim()) + cargo-careful sha256:$($carefulExecutableHash.Substring(0, 12))"
    $marker = Join-Path 'target' 'anvil/careful-sysroot.id'
    $prev = if (Test-Path -LiteralPath $marker) { (Get-Content -LiteralPath $marker -Raw).Trim() } else { $null }
    if ($null -ne $prev -and $prev -ne $idHash) {
        Write-Host 'anvil-careful: careful sysroot identity changed since the last run -- running `cargo clean` so the'
        Write-Host '  workspace is rebuilt against the freshly-built careful std (cargo cannot detect the in-place'
        Write-Host '  sysroot rebuild on its own, so stale artifacts would otherwise fail with an'
        Write-Host '  "incompatible version of rustc" / metadata mismatch).'
        Write-Host "  reason : the nightly toolchain and/or resolved cargo-careful executable changed"
        Write-Host "  now    : $idLabel"
        Write-Host "  identity: $($prev.Substring(0, [Math]::Min(12, $prev.Length)))... -> $($idHash.Substring(0, 12))..."
        & cargo '+{{ rust_nightly }}' clean
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    }
    # Persist the current identity (also seeds the marker on first run, when
    # there is nothing to clean). Written after the clean so it survives it.
    New-Item -ItemType Directory -Force -Path (Split-Path $marker) | Out-Null
    Set-Content -LiteralPath $marker -Value $idHash
    & cargo '+{{ rust_nightly }}' each {{ anvil_affected_selection }} --once -- cargo '+{{ rust_nightly }}' careful test '{packages}' --all-features --locked
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# Install prerequisites for the `anvil-careful` recipe.
[group("anvil-setup")]
anvil-careful-setup installer="install": anvil-component-nightly-rust-src-install (anvil-tool-cargo-careful-install installer) (anvil-tool-cargo-each-install installer)

# Validate prerequisites for the `anvil-careful` recipe.
[group("anvil-setup")]
anvil-careful-validate-prereqs: anvil-component-nightly-rust-src-validate-prereqs anvil-tool-cargo-careful-validate-prereqs anvil-tool-cargo-each-validate-prereqs

