        Write-Host 'anvil-tool-cargo-mutants-validate-prereqs: aarch64-pc-windows-msvc -- skipping (winapi build incompat)'
        exit 0
    }
    & just _check-tool cargo-mutants {{cargo_mutants_version}}
    exit $LASTEXITCODE

