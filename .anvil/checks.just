# Update cargo-anvil and regenerate; repository-specific edits stop automatic updates.
# Update behaviour: https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/updates.md

# Platform configs replace, rather than overlay, cargo-mutants' default config.
_anvil_mutants_platform_config := ".cargo/mutants." + os() + ".toml"
_anvil_mutants_config_arg := if path_exists(justfile_directory() / _anvil_mutants_platform_config) == "true" {
    "--config=" + _anvil_mutants_platform_config
} else {
    ""
}

# Scheduled groups execute a private group recipe in a child Just process so
# the internal full-workspace override is visible while that child's dependency
# graph is evaluated.
[private]
_anvil-unscoped name:
    {{ just_executable() }} --justfile {{ quote(justfile()) }} --set anvil_impact_override off _anvil-{{ name }}

# cargo-delta owns Git inspection, merge-base snapshots, cache invalidation, and
# package projection. ANVIL_IMPACT=consume reads package files produced by an
# earlier job; ANVIL_IMPACT=off selects the complete workspace. Child Just
# processes use the override rather than shell-specific environment mutation.
anvil_impact_override := ""
anvil_impact_mode := if anvil_impact_override != "" {
    anvil_impact_override
} else if env("ANVIL_IMPACT", "") == "" {
    ""
} else if env("ANVIL_IMPACT") == "consume" {
    "consume"
} else if env("ANVIL_IMPACT") == "off" {
    "off"
} else {
    error("ANVIL_IMPACT must be unset, 'consume', or 'off'")
}

anvil_impact_input_dir := if anvil_impact_mode == "consume" {
    env("ANVIL_IMPACT_INPUT_DIR", "target/anvil/impact")
} else {
    "target/anvil/impact"
}

anvil_impact_compute_prefix := if anvil_impact_mode == "" { "" } else { "# " }

anvil_base_ref := if env("BASE_REF", "") == "" {
    if env("SYSTEM_PULLREQUEST_TARGETBRANCH", "") == "" {
        if env("GITHUB_BASE_REF", "") == "" {
            "origin/main"
        } else {
            "origin/" + env("GITHUB_BASE_REF")
        }
    } else {
        "origin/" + replace(env("SYSTEM_PULLREQUEST_TARGETBRANCH"), "refs/heads/", "")
    }
} else {
    env("BASE_REF")
}

anvil_modified_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/modified.packages")
}

anvil_affected_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/affected.packages")
}

anvil_required_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/required.packages")
}

# Some tools represent the complete workspace by omitting package selectors
# rather than accepting Cargo's `--workspace` flag. In scoped modes cargo-each
# still expands the selected set to explicit `--package` arguments.
anvil_explicit_package_args := if anvil_impact_mode == "off" { "" } else { "'{packages}'" }

# Resolve cargo-each's optional workspace compatibility floor once, lazily.
# The stable marker makes the dry-run output safe to consume as a Just value.
workspace_rust_version_line := `cargo each --workspace --once --dry-run -- "workspace-rust-version={workspace-rust-version}"`
workspace_rust_version := replace(workspace_rust_version_line, "workspace-rust-version=", "")

# Resolve the command toolchain without overriding either RUSTUP_TOOLCHAIN or a
# repository toolchain file. Repositories with neither use their declared
# workspace rust-version when present and otherwise use Cargo's default.
anvil_stable_toolchain_arg := if env("RUSTUP_TOOLCHAIN", "") == "" {
    if path_exists(justfile_directory() + "/rust-toolchain.toml") {
        ""
    } else if path_exists(justfile_directory() + "/rust-toolchain") {
        ""
    } else if workspace_rust_version == "" {
        ""
    } else {
        quote("+" + workspace_rust_version)
    }
} else {
    ""
}

anvil_workspace_toolchain_selection := if anvil_stable_toolchain_arg == "" { "--none" } else { "--workspace" }
anvil_msrv_selection := if workspace_rust_version == "" { "--none" } else { anvil_affected_selection }
anvil_msrv_workspace_selection := if workspace_rust_version == "" { "--none" } else { "--workspace" }

# Compute package-file artifacts for the three impact tiers. In consume/off
# mode the interpolation comments out these command lines, making the recipe a
# no-op without shell control flow.
[group("anvil")]
anvil-impact:
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --modified --format packages --output target/anvil/impact/modified.packages
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --affected --format packages --output target/anvil/impact/affected.packages
    {{ anvil_impact_compute_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} delta --config .delta.toml impact --base-ref {{ quote(anvil_base_ref) }} --required --format packages --output target/anvil/impact/required.packages

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# PR tier: every check that should run on every pull request, split
# into two groups so the fast checks aren't blocked behind the slow
# ones in cloud workflows.

# Run all pull request checks.
[group("anvil")]
anvil-pr: anvil-pr-validate-prereqs \
    anvil-pr-fast \
    anvil-pr-slow

# scheduled tier: full-workspace re-runs of things that can change
# without a commit (advisories, flakes) + the truly expensive
# exhaustive checks that don't fit in a PR budget. Runs on a schedule
# against `main`, not on PRs.
#
# The scheduled tier is deliberately NOT impact-scoped: it is the catch-all
# that backstops PR-tier scoping. Every impact-scoped check depends on
# `anvil-impact` and populates its own scope from the cache, so the tier runs
# with ANVIL_IMPACT=off, which makes every cargo-each selection use the
# complete workspace and the `anvil-impact` dependency no-op.
# A dependency-only recipe cannot set an environment variable for its own
# dependencies, so the public tier wraps the private one through
# `_anvil-unscoped`.

# Run all scheduled checks.
[group("anvil")]
anvil-scheduled: (_anvil-unscoped "scheduled")

[private]
_anvil-scheduled: anvil-scheduled-validate-prereqs \
    anvil-scheduled-test \
    anvil-scheduled-advisories \
    anvil-scheduled-runtime-analysis \
    anvil-scheduled-exhaustive

# Full-workspace for the same reason as the scheduled tier.

# Full tier: PR + scheduled, end-to-end. Useful before tagging a release.
[group("anvil")]
anvil-full: (_anvil-unscoped "full")

[private]
_anvil-full: anvil-full-validate-prereqs \
    anvil-pr \
    _anvil-scheduled

# Build all targets and features for local development.
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("profile", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
anvil-build package="" profile="": anvil-build-validate-prereqs
    cargo each {{ if package == "" { "--workspace" } else { "--package " + quote(package) } }} --once -- cargo {{ anvil_stable_toolchain_arg }} build '{packages}' {{ if profile == "" { "" } else { "--profile " + quote(profile) } }} --all-features --all-targets --locked

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# cargo-aprz discovers credentials from its explicit flag, GITHUB_TOKEN, and
# (when opted in below) the authenticated gh CLI before falling back to
# anonymous access. Unscoped because it consults an external risk database.

# Analyze dependency features and version requirements with cargo-aprz.
anvil-aprz: anvil-aprz-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} aprz deps --github-token-from-gh --error-if-high-risk --console appraisal

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (consults external advisory DB; reads Cargo.lock).

# Audit dependencies for known security vulnerabilities.
anvil-audit: anvil-audit-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} audit

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier.

# Build all workspace benchmarks.
anvil-bench: anvil-bench-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} bench '{packages}' --all-features --no-run

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Smoke-only fuzz pass via [bolero](https://crates.io/crates/bolero):
# each fuzz target gets a 60-second libfuzzer run, just enough to
# surface obvious crashes/hangs introduced by a PR without paying for
# a long fuzzing campaign.
#
# Linux-only: cargo-bolero's libfuzzer engine (and its bolero-afl
# build dependency) only builds on Linux, so the recipe self-skips on
# non-Linux hosts -- the pr-runtime-analysis Windows/ARM legs treat
# bolero as a no-op rather than a failure. This matches oxidizer's
# reference workflow, whose bolero job runs exclusively on ubuntu.
# Crates that ship bolero harnesses still get them compiled and
# exercised as ordinary tests by anvil-llvm-cov on every leg; the
# libfuzzer campaign is the Linux-only extra.
#
# Target discovery is `cargo +<nightly> bolero list --profile release` over the affected packages.
# Crates with no bolero harness print zero targets and the recipe
# no-ops. The libfuzzer engine requires nightly, so the test
# invocation uses the pinned rust_nightly. Adopters who want longer
# campaigns wire a separate scheduled job; anvil deliberately does
# not ship a long-form fuzz tier (the failure surface is too
# repo-specific to standardize).

anvil_bolero_targets_file := "target" / ("bolero-list-" + just_pid() + ".jsonl")

[private]
_ensure-target-dir: anvil-impact
    {{ if path_exists("target") { "# target directory already exists" } else { "mkdir target" } }}

# Run Bolero tests for affected workspace packages.
anvil-bolero: anvil-bolero-validate-prereqs _ensure-target-dir
    {{ bolero_command_prefix }}cargo +{{ rust_nightly }} each {{ anvil_affected_selection }} -- cargo +{{ rust_nightly }} bolero list --profile release --package '{name}' > {{ quote(anvil_bolero_targets_file) }}
    {{ bolero_command_prefix }}cargo +{{ rust_nightly }} each --json-lines-file {{ quote(anvil_bolero_targets_file) }} --keep-going -- cargo +{{ rust_nightly }} bolero test --profile release --engine libfuzzer -T 60s --package '{json:package}' '{json:test}'
    {{ bolero_command_prefix }}rm {{ quote(anvil_bolero_targets_file) }}

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run tests with cargo-careful for affected workspace packages.
[script("pwsh", "-NoProfile")]
anvil-careful: anvil-careful-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    if ('{{ anvil_impact_mode }}' -ne 'off') {
        $packageFile = Join-Path '{{ replace(anvil_impact_input_dir, "'", "''") }}' 'affected.packages'
        if (-not (Test-Path -LiteralPath $packageFile -PathType Leaf)) {
            throw "anvil-careful: missing impact package file $packageFile"
        }
        if ((Get-Item -LiteralPath $packageFile).Length -eq 0) {
            Write-Host 'anvil-careful: no affected packages; skipping'
            exit 0
        }
    }
    # Guard against cargo-careful's stale-sysroot hazard. cargo-careful
    # builds a custom std ("careful sysroot": debug-assertions + extra UB
    # checks) into a STABLE cache path -- ProjectDirs(de.ralfj.cargo-careful),
    # NOT keyed by rustc version -- and runs the workspace build with
    # `--sysroot <that stable path>`. cargo's fingerprint hashes the
    # RUSTFLAGS string (the stable sysroot *path*) but not the sysroot's
    # *contents*. So when the pinned nightly (or the careful tool, which sets
    # the std-build flags) changes, cargo-careful rebuilds that std in place
    # while cargo still considers the workspace artifacts up to date -- they
    # then link against a now-replaced std and fail with metadata /
    # "found crate compiled by an incompatible version of rustc" errors.
    #
    # cargo can't see this, so we track the careful build identity ourselves
    # (the nightly rustc -- commit hash et al. -- plus the resolved
    # cargo-careful executable's content hash) and `cargo clean` when it
    # changes, forcing the workspace to be rebuilt against the freshly-built
    # std. cargo-careful does not expose a version command: both
    # `cargo careful --version` and direct `cargo-careful --version` are
    # rejected. Hashing the executable identifies the code that cargo will
    # dispatch without relying on that unsupported interface. The marker
    # lives under target/, so it is wiped by the clean and travels with any
    # target/ cache.
    $rustcVV = (& rustc '+{{ rust_nightly }}' -vV | Out-String)
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-careful: could not query nightly rustc version'; exit 1 }
    $carefulCommand = Get-Command cargo-careful -ErrorAction SilentlyContinue
    if (-not $carefulCommand -or -not $carefulCommand.Source) {
        Write-Error 'anvil-careful: could not resolve the cargo-careful executable'
        exit 1
    }
    $carefulExecutableHash = (Get-FileHash -Algorithm SHA256 -LiteralPath $carefulCommand.Source).Hash.ToLowerInvariant()
    $idSource = $rustcVV.Trim() + "`n$carefulExecutableHash"
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $idHash = ([System.BitConverter]::ToString($sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($idSource)))).Replace('-', '').ToLower()
    # Human-readable identity for log output: the first `rustc -vV` line
    # (e.g. "rustc 1.98.0-nightly (<hash> <date>)") plus the executable hash.
    $idLabel = "$(($rustcVV -split "`n")[0].Trim()) + cargo-careful sha256:$($carefulExecutableHash.Substring(0, 12))"
    $marker = Join-Path 'target' 'anvil/careful-sysroot.id'
    $prev = if (Test-Path -LiteralPath $marker) { (Get-Content -LiteralPath $marker -Raw).Trim() } else { $null }
    if ($null -ne $prev -and $prev -ne $idHash) {
        Write-Host 'anvil-careful: careful sysroot identity changed since the last run -- running `cargo clean` so the'
        Write-Host '  workspace is rebuilt against the freshly-built careful std (cargo cannot detect the in-place'
        Write-Host '  sysroot rebuild on its own, so stale artifacts would otherwise fail with an'
        Write-Host '  "incompatible version of rustc" / metadata mismatch).'
        Write-Host "  reason : the nightly toolchain and/or resolved cargo-careful executable changed"
        Write-Host "  now    : $idLabel"
        Write-Host "  identity: $($prev.Substring(0, [Math]::Min(12, $prev.Length)))... -> $($idHash.Substring(0, 12))..."
        & cargo '+{{ rust_nightly }}' clean
        if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    }
    # Persist the current identity (also seeds the marker on first run, when
    # there is nothing to clean). Written after the clean so it survives it.
    New-Item -ItemType Directory -Force -Path (Split-Path $marker) | Out-Null
    Set-Content -LiteralPath $marker -Value $idHash
    & cargo '+{{ rust_nightly }}' each {{ anvil_affected_selection }} --once -- cargo '+{{ rust_nightly }}' careful test '{packages}' --all-features --locked
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Required tier. cargo-hack's feature powerset cascades through dep
# features, so the required set (workspace-internal transitive deps)
# is the right scope.

# Check feature combinations for required workspace packages.
anvil-cargo-hack: anvil-cargo-hack-validate-prereqs anvil-impact
    cargo each {{ anvil_required_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} hack '{packages}' --feature-powerset --depth 2 check

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Modified tier.
#
# cargo-sort 2.1.2 and newer report formatting-only differences as warnings
# unless `--check-format` is set. Keep it enabled so dependency ordering and
# Cargo manifest style are both enforced.
#
# `--grouped` keeps the blank lines between groups of key/value pairs
# (e.g. blank-line-separated dependency blocks) intact.

# Check that Cargo.toml dependency tables are sorted.
anvil-cargo-sort: anvil-cargo-sort-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} sort --workspace --grouped --check --check-format

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Batched builds can enable features through other selected
# packages, hiding missing test dependencies or example feature requirements.
# Check every package's targets independently with default features and with
# defaults disabled, without linking or executing their test binaries.

# Check all targets of affected packages independently.
anvil-check-all-targets: anvil-check-all-targets-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --keep-going -- cargo {{ anvil_stable_toolchain_arg }} check --package '{spec}' --all-targets --locked
    cargo each {{ anvil_affected_selection }} --keep-going -- cargo {{ anvil_stable_toolchain_arg }} check --package '{spec}' --all-targets --no-default-features --locked

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Per project policy, clippy runs on the affected set
# rather than the modified set: a change in a crate can introduce a
# clippy issue in a dependent crate (e.g., trait-bound or
# obviously-truthy-condition lints that key off the changed type), so
# we want downstream reverse dependencies to lint as well. cargo-clippy is a
# rustup component; same reasoning as fmt for the require.

# Lint affected workspace packages with Clippy.
anvil-clippy: anvil-clippy-validate-prereqs anvil-impact
    cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} clippy '{packages}' --all-targets --all-features --locked -- -D warnings

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (consults external advisory DB; reads Cargo.lock, not
# workspace members). Single command, but run under pwsh so it does not
# depend on the adopter's default shell (absent/varying on Windows).

# Check dependency licenses, bans, sources, and advisories.
anvil-deny: anvil-deny-validate-prereqs
    cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} deny check

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Required tier. cargo doc resolves intra-doc links through the dep
# graph, so a dep changing its public API can break doc-build in a
# crate that wasn't itself modified.

# Build documentation for required workspace packages.
[arg("open", long, value="true")]
anvil-doc-build open="false": anvil-doc-build-validate-prereqs anvil-impact
    cargo each {{ anvil_required_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} doc '{packages}' --config {{ quote('build.rustdocflags=["-D","warnings"]') }} --all-features --no-deps {{ if open == "true" { "--open" } else { "" } }}

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. Two cargo-test invocations cover both feature
# configurations: --all-features catches doctests that only compile
# with optional features enabled; the default-features run catches
# doctests that only compile when those features are off. The
# duplication is cheap because doctests are already a small fraction
# of total compile/test time.
#
# Cargo errors when `cargo test --doc` selects only bin-only packages. Build
# the subset with at least one Cargo target marked `doctest = true`. This uses
# Cargo's capability bit rather than approximating from target kinds, so
# explicit crate types such as rlib/cdylib and proc macros remain eligible.

# Run documentation tests for affected workspace packages.
[script("pwsh", "-NoProfile")]
anvil-doc-test: anvil-doc-test-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    $selection = $null
    if ('{{ anvil_impact_mode }}' -ne 'off') {
        $packageFile = Join-Path '{{ replace(anvil_impact_input_dir, "'", "''") }}' 'affected.packages'
        if (-not (Test-Path -LiteralPath $packageFile -PathType Leaf)) {
            throw "anvil-doc-test: missing impact package file $packageFile"
        }
        $selection = @(Get-Content -LiteralPath $packageFile | Where-Object { $_ -ne '' })
        if ($selection.Count -eq 0) {
            Write-Host 'anvil-doc-test: no affected packages; skipping'
            exit 0
        }
    }
    $metadataJson = & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-doc-test: cargo metadata failed'; exit $LASTEXITCODE }
    try {
        $meta = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-doc-test: could not parse cargo metadata output: $_"
        exit 1
    }
    $workspacePackages = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    $docPackages = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    foreach ($package in $meta.packages) {
        $spec = "$($package.name)@$($package.version)"
        $workspacePackages.Add($spec) | Out-Null
        if ($package.targets | Where-Object { $_.doctest -eq $true }) {
            $docPackages.Add($spec) | Out-Null
        }
    }
    $specs = if ($null -eq $selection) {
        $workspaceSpecs = [string[]]@($docPackages)
        [Array]::Sort($workspaceSpecs, [System.StringComparer]::Ordinal)
        $workspaceSpecs
    } else {
        @(
            foreach ($spec in $selection) {
                if (-not $workspacePackages.Contains($spec)) {
                    throw "anvil-doc-test: impact package spec '$spec' does not identify a workspace member"
                }
                if ($docPackages.Contains($spec)) { $spec }
            }
        )
    }
    if ($specs.Count -eq 0) {
        Write-Host 'anvil-doc-test: no affected doctest-capable packages; skipping'
        exit 0
    }
    $docSelection = [System.Collections.Generic.List[string]]::new()
    foreach ($spec in $specs) {
        $docSelection.Add('--package')
        $docSelection.Add($spec)
    }
    & cargo each @docSelection --once -- cargo {{ anvil_stable_toolchain_arg }} test --doc '{packages}' --all-features --locked
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    & cargo each @docSelection --once -- cargo {{ anvil_stable_toolchain_arg }} test --doc '{packages}' --locked
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Modified tier.

# Check that workspace dependencies contain no cycles.
anvil-ensure-no-cyclic-deps: anvil-ensure-no-cyclic-deps-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} ensure-no-cyclic-deps

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Modified tier.

# Check that workspace packages compile without default features.
anvil-ensure-no-default-features: anvil-ensure-no-default-features-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} ensure-no-default-features

# Build affected examples, or run selected examples locally with bounded,
# process-tree-aware cargo-each timeouts.
[arg("run", long, value="true")]
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("example", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("timeout", long, pattern='(?:[1-9][0-9]{0,2}|[12][0-9]{3}|3[0-5][0-9]{2}|3600)')]
anvil-examples run="false" package="" example="" timeout="30": anvil-examples-validate-prereqs anvil-impact
    cargo each {{ if example == "" { if package == "" { anvil_affected_selection } else { "--package " + quote(package) } } else if package == "" { error("--example requires --package") } else { "--package " + quote(package) } }} --once -- cargo {{ anvil_stable_toolchain_arg }} build '{packages}' {{ if example == "" { "--examples" } else { "--example " + quote(example) } }} --all-features --locked
    {{ if run == "true" { if example == "" { "just _anvil-examples-run " + quote(package) + " " + quote(timeout) } else { "# explicit example selected below" } } else { "# example execution not requested" } }}
    {{ if run == "true" { if example == "" { "# " } else { "" } } else { "# " } }}cargo each --package {{ quote(package) }} --timeout {{ timeout }}s -- cargo {{ anvil_stable_toolchain_arg }} run --config {{ quote('env.ANVIL_EXAMPLE="1"') }} --package '{spec}' --example {{ quote(example) }} --all-features --locked

# Run automatically eligible examples while honoring each package's
# `[package.metadata.anvil.examples].no-run` target list.
[private]
[script("pwsh", "-NoProfile")]
_anvil-examples-run package timeout:
    $ErrorActionPreference = 'Stop'
    $packageName = '{{ replace(package, "'", "''") }}'
    $timeout = '{{ replace(timeout, "'", "''") }}'
    $selected = $null
    if (-not $packageName -and '{{ anvil_impact_mode }}' -ne 'off') {
        $packageFile = Join-Path '{{ replace(anvil_impact_input_dir, "'", "''") }}' 'affected.packages'
        if (-not (Test-Path -LiteralPath $packageFile -PathType Leaf)) {
            throw "anvil-examples: missing impact package file $packageFile"
        }
        $selected = [System.Collections.Generic.HashSet[string]]::new(
            [System.StringComparer]::Ordinal
        )
        foreach ($spec in Get-Content -LiteralPath $packageFile) {
            if ($spec) { $selected.Add($spec) | Out-Null }
        }
        if ($selected.Count -eq 0) {
            Write-Host 'anvil-examples: no affected packages; skipping execution'
            exit 0
        }
    }
    $metadataJson = & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-examples: cargo metadata failed'; exit $LASTEXITCODE }
    try {
        $meta = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-examples: could not parse cargo metadata output: $_"
        exit 1
    }
    $workspacePackages = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    foreach ($candidate in $meta.packages) {
        $workspacePackages.Add("$($candidate.name)@$($candidate.version)") | Out-Null
    }
    if ($null -ne $selected) {
        foreach ($spec in $selected) {
            if (-not $workspacePackages.Contains($spec)) {
                throw "anvil-examples: impact package spec '$spec' does not identify a workspace member"
            }
        }
    }
    $targets = @(
        foreach ($candidate in $meta.packages) {
            $spec = "$($candidate.name)@$($candidate.version)"
            if ($packageName -and $candidate.name -cne $packageName) { continue }
            if ($null -ne $selected -and -not $selected.Contains($spec)) { continue }
            $excluded = @($candidate.metadata.anvil.examples.'no-run')
            foreach ($target in $candidate.targets) {
                if ($target.kind -ccontains 'example' -and $excluded -cnotcontains $target.name) {
                    [pscustomobject]@{ spec = $spec; target = $target.name }
                }
            }
        }
    )
    if ($packageName -and -not ($meta.packages | Where-Object { $_.name -ceq $packageName })) {
        throw "anvil-examples: package '$packageName' does not identify a workspace member"
    }
    if ($targets.Count -eq 0) {
        Write-Host 'anvil-examples: no automatically runnable examples; skipping'
        exit 0
    }
    $failed = $false
    foreach ($item in $targets) {
        & cargo each --package $item.spec --timeout "${timeout}s" -- cargo {{ anvil_stable_toolchain_arg }} run --config 'env.ANVIL_EXAMPLE="1"' --package '{spec}' --example $item.target --all-features --locked
        if ($LASTEXITCODE -ne 0) { $failed = $true }
    }
    if ($failed) { exit 1 }

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier (lints public API of changed crates and reverse dependencies).
#
# cargo-check-external-types is per-manifest. cargo-each selects affected
# library crates and supplies each manifest without recipe-side metadata logic.

# Check public APIs for unapproved external types.
anvil-external-types: anvil-external-types-validate-prereqs anvil-impact
    cargo +{{ rust_nightly_external_types }} each {{ anvil_affected_selection }} --filter target-kind:lib --keep-going -- cargo +{{ rust_nightly_external_types }} check-external-types --manifest-path '{manifest}'

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Modified tier. cargo-fmt is a rustup component. We invoke it via the
# pinned nightly (see versions.just) to support the default catalog's
# unstable rustfmt options (imports_granularity, group_imports,
# format_code_in_doc_comments). The recipe retains that pin even when a
# repository's formatting configuration enables only stable options.
# Floating nightly would mean format-drift breaking cloud workflows on
# rustup updates — the same trap we explicitly avoid for
# udeps/miri/careful/external-types.
#
# Iterate workspace members rather than every local path dependency that
# `cargo fmt --all` discovers. `--keep-going` reports formatting failures from
# every member while retaining a bounded rustfmt command line per invocation.
#
# Pin both the cargo-each wrapper and cargo-fmt to the same nightly so the
# formatting command does not mix stable and nightly toolchains.

# Check Rust source formatting.
[arg("fix", long, value="true")]
anvil-fmt fix="false": anvil-fmt-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_modified_selection }} --keep-going -- cargo +{{ rust_nightly }} fmt --manifest-path '{manifest}' {{ if fix == "true" { "" } else { "--check" } }}

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Modified tier.

# Check source files for required license headers.
anvil-license-headers: anvil-license-headers-validate-prereqs anvil-impact
    cargo each {{ anvil_modified_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} heather

# Collect both supported feature configurations, run opted-out packages without
# instrumentation, handle platform export limits, and enforce package coverage
# policy through cargo-coverage-gate.
anvil-llvm-cov: anvil-llvm-cov-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_affected_selection }} --once -- cargo +{{ rust_nightly }} coverage-gate {{ anvil_explicit_package_args }} run --no-coverage-target aarch64-pc-windows-msvc

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. `loom` is a permutation-based concurrency model
# checker: a crate exercises it through a dedicated `[[test]]` target
# that declares `required-features = ["loom"]` (e.g. tests/loom.rs).
# We detect those targets *structurally* from `cargo metadata` -- a
# test target whose `kind` contains "test" and whose `required-features`
# contains "loom" -- so detection is authoritative manifest data, not a
# filename / cfg / comment heuristic. Running only those targets (via
# `--test <name>`) keeps loom off the crate's ordinary tests, which must
# not run under loom.
#
# Two independent switches must both be on, and they answer different
# questions:
#   * The `loom` feature answers "which target": `required-features`
#     makes Cargo select the loom test only when the feature is enabled,
#     so a normal `cargo test` / coverage run never compiles or runs it.
#     We pass --all-features so feature-gated loom sub-modules (e.g.
#     `#![cfg(all(loom, feature = "..."))]`) still compile.
#   * `RUSTFLAGS=--cfg loom` answers "how it compiles": loom's own
#     machinery and the ecosystem gate on `cfg(loom)`, not on a feature
#     (source swaps std<->loom atomics on `#[cfg(loom)]`, and
#     `[target.'cfg(loom)'.dependencies] loom` links only under the cfg).
#     The feature does NOT replace the cfg; both are required.
# We scope `cargo test` to the owning package with `-p` (never
# `--workspace`) so a global `--cfg loom` never leaks into deps reachable
# only through *other* members (e.g. concurrent-queue), and run
# single-threaded (loom drives its own scheduling). --release per the
# loom docs: permutation exploration is wall-clock dominated by the SUT.
# Anvil does not impose a global exploration bound: each model owns its
# topology and must remain tractable under exhaustive exploration.
#
# Fail-loud guard: a crate that *declares* loom support -- a `loom`
# feature or a `cfg(loom)`-gated dependency -- but exposes no
# `required-features = ["loom"]` test target is almost certainly a
# regression (renamed/removed target), so we error rather than silently
# skip it. When no crate ships a loom target (the common case) the recipe
# skips with exit 0 -- the regular tests already ran under anvil-llvm-cov.
#
# `cargo metadata --no-deps` scans only the adopter's own members
# (layout-agnostic; works for any `members` glob). RUSTFLAGS goes via
# $env: rather than --config so it propagates to cargo's child rustc
# invocations cleanly on both pwsh/bash.

# Run Loom concurrency tests for affected workspace packages.
[script("pwsh", "-NoProfile")]
anvil-loom: anvil-loom-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    $selected = $null
    if ('{{ anvil_impact_mode }}' -ne 'off') {
        $packageFile = Join-Path '{{ replace(anvil_impact_input_dir, "'", "''") }}' 'affected.packages'
        if (-not (Test-Path -LiteralPath $packageFile -PathType Leaf)) {
            throw "anvil-loom: missing impact package file $packageFile"
        }
        $selected = [System.Collections.Generic.HashSet[string]]::new(
            [System.StringComparer]::Ordinal
        )
        foreach ($spec in Get-Content -LiteralPath $packageFile) {
            if ($spec) { $selected.Add($spec) | Out-Null }
        }
        if ($selected.Count -eq 0) {
            Write-Host 'anvil-loom: no affected packages; skipping'
            exit 0
        }
    }
    $metadataJson = & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) { Write-Error 'anvil-loom: cargo metadata failed'; exit $LASTEXITCODE }
    try {
        $meta = $metadataJson | ConvertFrom-Json
    } catch {
        Write-Error "anvil-loom: could not parse cargo metadata output: $_"
        exit 1
    }
    $workspacePackages = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    foreach ($package in $meta.packages) {
        $workspacePackages.Add("$($package.name)@$($package.version)") | Out-Null
    }
    if ($null -ne $selected) {
        foreach ($spec in $selected) {
            if (-not $workspacePackages.Contains($spec)) {
                throw "anvil-loom: impact package spec '$spec' does not identify a workspace member"
            }
        }
    }
    $loomTargetPackages = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    $declarers = [System.Collections.Generic.HashSet[string]]::new(
        [System.StringComparer]::Ordinal
    )
    foreach ($package in $meta.packages) {
        $spec = "$($package.name)@$($package.version)"
        if ($null -ne $selected -and -not $selected.Contains($spec)) { continue }
        if ($package.features.PSObject.Properties.Name -ccontains 'loom' -or
            [bool]($package.dependencies | Where-Object { $_.target -and $_.target -match 'cfg\(.*\bloom\b.*\)' })) {
            $declarers.Add($spec) | Out-Null
        }
        foreach ($target in $package.targets) {
            if ($target.kind -ccontains 'test' -and $target.'required-features' -ccontains 'loom') {
                $loomTargetPackages.Add($spec) | Out-Null
            }
        }
    }
    $missing = @($declarers | Where-Object { -not $loomTargetPackages.Contains($_) })
    if ($missing.Count -ne 0) {
        [Array]::Sort($missing, [System.StringComparer]::Ordinal)
        throw 'anvil-loom: package(s) declare Loom support but expose no [[test]] target with required-features = ["loom"]: ' + ($missing -join ', ')
    }
    if ($loomTargetPackages.Count -eq 0) {
        Write-Host 'anvil-loom: no Loom test targets; skipping'
        exit 0
    }
    & cargo each {{ anvil_affected_selection }} --each-target test --target-required-feature loom -- cargo {{ anvil_stable_toolchain_arg }} test --config {{ quote('build.rustflags=["--cfg","loom"]') }} --package '{spec}' --release --all-features --locked --test '{target}' -- --test-threads=1
    exit $LASTEXITCODE

anvil_miri_jobs := env("ANVIL_MIRI_JOBS", "auto")

# Run Miri tests for affected workspace packages.
[arg("package", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
[arg("test", long, pattern='(?:[A-Za-z0-9_.:-]+)?')]
[arg("example", long, pattern='(?:[A-Za-z0-9_.-]+)?')]
anvil-miri package="" test="" example="": anvil-miri-validate-prereqs (_anvil-miri-test "standard" package test example)

# Profile-specific environment is the only shell policy here. Package
# selection, metadata filtering, concurrency, failure aggregation, and process
# cleanup belong to cargo-each.
[script("pwsh", "-NoProfile")]
_anvil-miri-test profile package="" test_filter="" example="": anvil-impact
    $ErrorActionPreference = 'Stop'
    $profile = '{{ replace(profile, "'", "''") }}'
    $testFilter = '{{ replace(test_filter, "'", "''") }}'
    $example = '{{ replace(example, "'", "''") }}'
    if ($testFilter -and $example) { throw 'choose exactly one of --test or --example' }
    if ($example -and '{{ replace(package, "'", "''") }}' -eq '') { throw '--example requires --package' }
    switch ($profile) {
        'standard' {}
        'tree-borrows' {
            $env:MIRIFLAGS = "-Zmiri-tree-borrows $($env:MIRIFLAGS)".Trim()
            $env:RUSTFLAGS = "--cfg miri_tree_borrows $($env:RUSTFLAGS)".Trim()
        }
        'strict-provenance' {
            $env:MIRIFLAGS = "-Zmiri-strict-provenance $($env:MIRIFLAGS)".Trim()
            $env:RUSTFLAGS = "--cfg miri_strict_provenance $($env:RUSTFLAGS)".Trim()
        }
        'race-coverage' {
            $day = (Get-Date).Day
            $env:MIRIFLAGS = "-Zmiri-many-seeds=$((2 * $day) - 1)..$((2 * $day) + 1) $($env:MIRIFLAGS)".Trim()
            $env:RUSTFLAGS = "--cfg miri_race_coverage $($env:RUSTFLAGS)".Trim()
        }
        default { throw "unknown Miri profile '$profile'" }
    }
    if ($example) {
        & cargo '+{{ rust_nightly }}' each {{ if package == "" { anvil_affected_selection } else { "--package " + quote(package) } }} --exclude-filter 'metadata:anvil.miri.exclude=true' --jobs {{ anvil_miri_jobs }} --keep-going -- cargo '+{{ rust_nightly }}' miri run --package '{spec}' --example $example --all-features --locked
    } else {
        $filter = if ($testFilter) { @('--', $testFilter) } else { @() }
        & cargo '+{{ rust_nightly }}' each {{ if package == "" { anvil_affected_selection } else { "--package " + quote(package) } }} --exclude-filter 'metadata:anvil.miri.exclude=true' --jobs {{ anvil_miri_jobs }} --keep-going -- cargo '+{{ rust_nightly }}' miri test --package '{spec}' --tests --all-features --locked @filter
    }
    exit $LASTEXITCODE

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Race coverage rotates the miri-many-seeds window daily by
# day-of-month: day N -> seeds [2N-1, 2N+1) (2 seeds/day,
# ~62 seeds/month). Rotating amortizes the seed space across the
# schedule rather than retesting the same seeds every night; race
# conditions surface as inter-seed nondeterminism rather than
# per-seed crashes, so coverage matters more than depth-per-seed.

# Run Miri tests with race coverage tracking.
anvil-miri-race-coverage: anvil-miri-race-coverage-validate-prereqs (_anvil-miri-test "race-coverage")

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run Miri tests with strict provenance checks.
anvil-miri-strict-provenance: anvil-miri-strict-provenance-validate-prereqs (_anvil-miri-test "strict-provenance")

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Stricter miri profiles. Each runs miri with a profile-specific
# MIRIFLAGS plus a profile-specific
# `--cfg miri_<profile>` set via RUSTFLAGS. Per-test opt-outs use
# `#[cfg_attr(miri_<profile>, ignore = "<reason>")]`, keeping the
# suppression next to the test rather than in a sidecar file.
# The cfg names are declared in the workspace check-cfg list
# (regions/cargo-rust-lints.toml) so non-miri builds don't warn.
#
# Under scheduled-runtime-analysis these profiles run full-workspace:
# that tier sets ANVIL_IMPACT=off, so cargo-each selects the workspace.
# A direct local invocation consumes the affected package file.

# Run Miri tests with the Tree Borrows model.
anvil-miri-tree-borrows: anvil-miri-tree-borrows-validate-prereqs (_anvil-miri-test "tree-borrows")

# Run affected-package tests under the declared public MSRV. A repository
# without a root MSRV is a no-op.
anvil-msrv-test: anvil-msrv-test-validate-prereqs anvil-impact
    cargo each {{ anvil_msrv_selection }} --once -- cargo '+{workspace-rust-version}' test '{packages}' --tests --all-features --locked
    cargo each {{ anvil_msrv_selection }} --once -- cargo '+{workspace-rust-version}' test '{packages}' --tests --locked

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Affected tier. cargo-mutants does its own diff-scoping via --in-diff;
# the affected-tier guard is the wiring-layer's coarse filter (if no
# affected packages exist, the entire mutants run is pointless).
#
# Skip on aarch64-pc-windows-msvc: cargo-mutants doesn't build there
# (upstream winapi incompatibility), so `_anvil-require cargo-mutants`
# would fail. The merged pr-slow group runs on all four OS legs; mutants
# is the only sub-recipe that can't follow, so it bails out early on the
# affected leg. Coverage on the other three legs is unchanged.

# Run mutation testing for changes relative to the base branch.
[script("pwsh", "-NoProfile")]
anvil-mutants-diff: anvil-mutants-diff-validate-prereqs anvil-impact
    $ErrorActionPreference = 'Stop'
    if ('{{ anvil_impact_mode }}' -ne 'off') {
        $packageFile = Join-Path '{{ replace(anvil_impact_input_dir, "'", "''") }}' 'affected.packages'
        if (-not (Test-Path -LiteralPath $packageFile -PathType Leaf)) {
            throw "anvil-mutants-diff: missing impact package file $packageFile"
        }
        if ((Get-Item -LiteralPath $packageFile).Length -eq 0) {
            Write-Host 'anvil-mutants-diff: no affected packages; skipping'
            exit 0
        }
    }
    if ($IsWindows -and ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64')) {
        Write-Host 'anvil-mutants-diff: anvil-mutants-diff-validate-prereqs aarch64-pc-windows-msvc -- cargo-mutants does not build here (winapi); skipping'
        exit 0
    }
    $base = '{{ replace(anvil_base_ref, "'", "''") }}'
    # cargo-mutants --in-diff takes a FILE path containing a unified
    # diff, not a git revision range. Write the diff to a temp file
    # first. RUNNER_TEMP (GH) and AGENT_TEMPDIRECTORY (ADO) point at
    # the job's scratch dir; fall back to the system temp dir locally.
    $tmp_dir = $env:RUNNER_TEMP
    if (-not $tmp_dir) { $tmp_dir = $env:AGENT_TEMPDIRECTORY }
    if (-not $tmp_dir) { $tmp_dir = [System.IO.Path]::GetTempPath() }
    $diff_path = Join-Path $tmp_dir 'anvil-mutants-diff.diff'
    # Diff the base against the WORKING TREE, not against HEAD.
    # cargo-mutants validates every line of the diff against the file on
    # disk and aborts when they disagree, so a commit-to-commit diff fails
    # the moment anything is uncommitted -- which is the normal local state,
    # since the point of running a tier locally is to check work in progress.
    # CI has a clean tree, so the two forms are identical there and this is
    # not a behaviour change for it.
    git diff "$base" --output=$diff_path
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
    & cargo each {{ anvil_affected_selection }} --once -- cargo {{ anvil_stable_toolchain_arg }} mutants --in-diff $diff_path --no-shuffle --jobs 0 {{_anvil_mutants_config_arg}}
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped. Scheduled-exhaustive deliberately runs over the whole
# workspace regardless of diff.

# Run exhaustive mutation testing across the workspace.
anvil-mutants-full: anvil-mutants-full-validate-prereqs
    {{ mutants_command_prefix }}cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} mutants --workspace --no-shuffle --jobs 0 {{_anvil_mutants_config_arg}}

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped (PR title is not source-related).
#
# Validates that $env:PR_TITLE matches the accepted title syntax when it
# holds a value; no-op when unset or empty. Cloud workflows inject PR_TITLE
# explicitly: both GH Actions and ADO resolve the current title via their REST
# APIs, fail closed when a known PR's title cannot be retrieved, and publish an
# empty value only outside PR builds. Local runs have no reliable way to recover
# the PR title, so an unset or empty value defers the check rather than failing
# it.
# It does NOT tolerate a non-empty-but-wrong value: a misconfigured cloud
# variable (e.g. an unexpanded pipeline macro) is a real error and fails
# the check loudly rather than silently passing.

anvil_pr_title := env("PR_TITLE", "")
anvil_pr_title_pattern := '^(?i:feat|fix|chore|docs|refactor|test|build|ci|perf|revert)(?:\([^)]+\))?!?: .+$'
anvil_pr_title_error := "PR title '" + anvil_pr_title + "' does not match the accepted Conventional Commits subset.\nAllowed patterns: <type>: <description>, <type>(<scope>): <description>, <type>!: <description>, <type>(<scope>)!: <description>\nAllowed types (case-insensitive): feat, fix, chore, docs, refactor, test, build, ci, perf, revert"

# Validate the pull request title.
anvil-pr-title: anvil-pr-title-validate-prereqs
    {{ if anvil_pr_title == "" { "echo " + quote("anvil-pr-title: PR_TITLE env var is unset or empty; skipping title validation") } else if anvil_pr_title =~ anvil_pr_title_pattern { "# PR title matches the accepted Conventional Commits subset" } else { error(anvil_pr_title_error) } }}

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped.
#
# A workspace-level README template (`crates/README.j2` / `README.j2`) feeds
# every crate's README but is a repo-level input cargo-delta does not map to a
# cargo package, so this check cannot be safely impact-scoped and always runs.
#
# cargo-doc2readme regenerates a crate's README.md from its rustdoc.
# Two extension points users frequently need:
#   * Workspace-level template (`crates/README.j2` or `README.j2` at repo
#     root): a Tera template applied to every crate's README. anvil
#     auto-detects it and passes `--template` to the per-crate runs.
#   * Per-crate opt-out: hand-crafted READMEs (e.g. a tool crate whose
#     README is more freeform than the lib docs) opt out by adding
#     `[package.metadata.ox-gen-readme]\ndisable = true` to their
#     Cargo.toml. anvil skips those crates.
#
# Library or proc-macro rustdoc is preferred when a crate has one; bin-only
# crates use their binary rustdoc so every publishable crate follows the same
# generation policy.
# TODO(anvil-runner): even after a `cargo ox-run` helper absorbs the
# skip/splat preamble, this recipe stays multi-step: per-crate
# iteration over eligible targets, cargo-metadata-driven opt-outs
# (publish=false, [package.metadata.ox-gen-readme] disable), per-crate
# Push-Location into the crate dir (cargo-doc2readme is CWD-sensitive
# rather than --manifest-path-driven), and per-crate template-path
# resolution. The recipe iterates the full eligible-crate set every run.

# Generate or check every eligible crate README with the same selection policy.
[script("pwsh", "-NoProfile")]
_anvil-readme mode: anvil-readme-check-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $action = '{{ mode }}'
    if ($action -notin @('generate', 'check')) {
        [Console]::Error.WriteLine("anvil-readme: invalid mode '$action'; expected 'generate' or 'check'")
        exit 2
    }
    $check = $action -eq 'check'
    $prefix = "anvil-readme-${action}"
    # Detect a workspace-level README template. Two conventional
    # locations: crates/README.j2 (cargo-workspaces idiom) or
    # README.j2 at repo root.
    $template = $null
    foreach ($candidate in 'crates/README.j2', 'README.j2') {
        if (Test-Path $candidate) { $template = (Resolve-Path $candidate).Path; break }
    }
    # Iterate every crate with rustdoc, then drop private crates and opt-outs.
    # Unscoped: a change to the workspace-level README template is a repo-level
    # input cargo-delta cannot map to a package, so this check always runs the
    # full eligible-crate set rather than an impact subset.
    $metadataJson = & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} metadata --no-deps --format-version 1
    if ($LASTEXITCODE -ne 0) {
        Write-Error "${prefix}: cargo metadata failed"
        exit $LASTEXITCODE
    }
    $meta = $metadataJson | ConvertFrom-Json
    $hadFailure = $false
    foreach ($p in $meta.packages) {
        $name = $p.name
        $hasLib = [bool]($p.targets | Where-Object { ($_.kind -contains 'lib') -or ($_.kind -contains 'proc-macro') })
        $hasBin = [bool]($p.targets | Where-Object { $_.kind -contains 'bin' })
        if (-not $hasLib -and -not $hasBin) { continue }
        # Skip private crates (publish = false). They aren't released
        # and rarely have a polished README. Mirrors the
        # `cargo workspaces exec --ignore-private` idiom adopters
        # commonly use.
        if ($p.publish -is [array] -and $p.publish.Count -eq 0) {
            Write-Host "${prefix}: $name (skipped: publish = false)"
            continue
        }
        $disabled = $false
        if ($p.metadata -and $p.metadata.'ox-gen-readme' -and $p.metadata.'ox-gen-readme'.disable) {
            $disabled = $true
        }
        if ($disabled) {
            Write-Host "${prefix}: $name (opted out via [package.metadata.ox-gen-readme])"
            continue
        }
        Write-Host "${prefix}: $name"
        # cargo doc2readme writes / compares relative to its CWD (not
        # --manifest-path), so chdir into the crate before invoking it.
        # We also compute a per-crate relative path to the
        # workspace-level template so the same template file works for
        # every crate (parallels the cargo-workspaces idiom).
        $crateDir = Split-Path -Parent $p.manifest_path
        Push-Location $crateDir
        try {
            $relTemplate = if ($template) {
                Resolve-Path -Relative -LiteralPath $template
            } else {
                $null
            }
            $target = if ($hasLib) { '--lib' } else { '--bin' }
            $args = @('doc2readme', $target)
            if ($check) { $args += '--check' }
            if ($relTemplate) { $args += @('--template', $relTemplate) }
            & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} @args
            if ($LASTEXITCODE -ne 0) { $hadFailure = $true }
        } finally {
            Pop-Location
        }
    }
    if ($hadFailure) { exit 1 }

# Check README files, or regenerate them with `--fix`.
[arg("fix", long, value="true")]
anvil-readme fix="false": (_anvil-readme if fix == "true" { "generate" } else { "check" })

# Check that crate README files are up to date.
anvil-readme-check: (_anvil-readme "check")

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Unscoped.
#
# cargo-spellcheck checks the whole workspace and reads a repo-root `.spelling`
# dictionary -- repo-level inputs that cargo-delta does not map to any cargo
# package -- so this check cannot be safely impact-scoped and always runs.
#
# cargo-spellcheck reads a Hunspell-compatible dictionary file at the
# path configured in `spellcheck.toml` (typically `extra_dictionaries =
# ["target/spelling.dic"]`). The convention used by the surveyed
# Microsoft Rust repos is to keep the *source* word list in a
# human-edited `.spelling` file at the repo root and preprocess it
# into the .dic format at check time (Hunspell .dic requires:
# alphabetical sort, blank/numeric lines removed, line-count header).
# We always (re)generate `target/spelling.dic` so that the generated config
# pointing at it never fails on a missing file -- if `.spelling` is
# absent we emit an empty dictionary (count `0`, no words) rather than
# leaving the path dangling.

# Check spelling in source comments and documentation.
[script("pwsh", "-NoProfile")]
anvil-spellcheck: anvil-spellcheck-validate-prereqs
    $ErrorActionPreference = 'Stop'
    $output_file = 'target/spelling.dic'
    $filtered_lines = @()
    if (Test-Path '.spelling') {
        $lines = Get-Content '.spelling' | Sort-Object
        $filtered_lines = @($lines | Where-Object { $_ -notmatch '^\d+$' -and $_ -ne '' })
    }
    $line_count = $filtered_lines.Count
    [System.IO.Directory]::CreateDirectory([System.IO.Path]::GetDirectoryName($output_file)) | Out-Null
    @($line_count) + $filtered_lines | Set-Content $output_file
    & cargo each --workspace --once -- cargo {{ anvil_stable_toolchain_arg }} spellcheck --cfg spellcheck.toml check --code 1
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Required tier. cargo-udeps detects unused dependencies by resolving
# the full crate graph and seeing which deps are referenced; that's
# precisely what the required tier is for. Pinned to the general
# nightly defined in versions.just.
#
# Run twice, because cargo-udeps only analyzes the targets it is told
# to, and each invocation catches a variant the other masks:
#   1. default targets (lib + bins): catches a dep in `[dependencies]`
#      that is referenced only by tests/benches/examples -- it belongs
#      in `[dev-dependencies]`. Under `--all-targets` such a dep looks
#      "used" (the test/bench/example target satisfies the lookup), so
#      this run is the only one that surfaces it.
#   2. `--all-targets`: catches unused `[dev-dependencies]` -- which the
#      default-targets run never compiles, so it is the only one that
#      surfaces those.
# A genuinely-unused dep is caught by both; the two together cover all
# of {unused dep, unused dev-dep, dep that should be a dev-dep}.

# Check required workspace packages for unused dependencies.
anvil-udeps: anvil-udeps-validate-prereqs anvil-impact
    cargo +{{ rust_nightly }} each {{ anvil_required_selection }} --once -- cargo +{{ rust_nightly }} udeps '{packages}' --all-features
    cargo +{{ rust_nightly }} each {{ anvil_required_selection }} --once -- cargo +{{ rust_nightly }} udeps '{packages}' --all-features --all-targets

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run the fast pull request checks.
[group("anvil")]
anvil-pr-fast: anvil-pr-fast-validate-prereqs \
    anvil-fmt \
    anvil-clippy \
    anvil-check-all-targets \
    anvil-cargo-sort \
    anvil-license-headers \
    anvil-ensure-no-cyclic-deps \
    anvil-ensure-no-default-features \
    anvil-doc-build \
    anvil-readme-check \
    anvil-spellcheck \
    anvil-pr-title \
    anvil-deny \
    anvil-audit \
    anvil-udeps \
    anvil-external-types

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run pull request compatibility tests under the declared MSRV.
[group("anvil")]
anvil-pr-msrv: anvil-pr-msrv-validate-prereqs anvil-msrv-test

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# pr-slow is the local umbrella for everything that takes more than ~30s
# per crate (tests, MSRV tests, stricter runtimes, mutation testing). Its
# groups can be invoked individually without invoking the other groups:
#
#   pr-test: tests + coverage
#   pr-msrv: all-target tests under the declared MSRV
#   pr-runtime-analysis: stricter-runtime correctness (miri, careful)
#   pr-mutants: mutation testing
#
# Cloud workflows run these groups as independent parallel jobs.
# The umbrella runs them sequentially only when invoked locally:
#
#   $ just anvil-pr-test   # tests + coverage only
#   $ just anvil-pr-msrv   # MSRV all-target tests only
#   $ just anvil-pr-runtime-analysis   # miri + careful only
#   $ just anvil-pr-mutants   # mutants only

# Run the slow pull request checks.
[group("anvil")]
anvil-pr-slow: anvil-pr-slow-validate-prereqs anvil-pr-test anvil-pr-msrv anvil-pr-runtime-analysis anvil-pr-mutants

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run the pull request tests.
[group("anvil")]
anvil-pr-test: anvil-pr-test-validate-prereqs \
    anvil-llvm-cov \
    anvil-doc-test \
    anvil-examples

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run the pull request runtime analysis.
[group("anvil")]
anvil-pr-runtime-analysis: anvil-pr-runtime-analysis-validate-prereqs \
    anvil-miri \
    anvil-careful \
    anvil-loom \
    anvil-bolero

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Run the pull request mutation tests.
[group("anvil")]
anvil-pr-mutants: anvil-pr-mutants-validate-prereqs anvil-mutants-diff

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Scheduled groups

# Scheduled groups are the full-workspace backstop for PR-tier impact scoping,
# so route through _anvil-unscoped: it exports ANVIL_IMPACT=off
# before the check dependencies run, so the group is full-workspace regardless
# of how it is invoked (CI, `just anvil-scheduled`, or
# `just anvil-scheduled-test` directly). Because these groups never recompute
# the impact set, they no longer need cargo-delta as a prerequisite.

# Run the scheduled tests.
[group("anvil")]
anvil-scheduled-test: (_anvil-unscoped "scheduled-test")

[private]
_anvil-scheduled-test: anvil-scheduled-test-validate-prereqs \
    anvil-llvm-cov \
    anvil-doc-test \
    anvil-examples

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Full-workspace backstop: routed through _anvil-unscoped so
# ANVIL_IMPACT=off is set before the check dependencies run, regardless of how
# the group is invoked. The group does not recompute impact and therefore does
# not require cargo-delta.

# Run the scheduled advisory checks.
[group("anvil")]
anvil-scheduled-advisories: (_anvil-unscoped "scheduled-advisories")

[private]
_anvil-scheduled-advisories: anvil-scheduled-advisories-validate-prereqs \
    anvil-deny \
    anvil-audit \
    anvil-aprz \
    anvil-clippy

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# scheduled-runtime-analysis is the full-workspace counterpart of
# pr-runtime-analysis: it re-runs miri unscoped (PR-tier miri is
# impact-scoped, so crates untouched by a PR never get miri coverage)
# and adds the three stricter miri profiles (tree-borrows, strict-
# provenance, race-coverage) which are too expensive for PR.

# Full-workspace backstop: routed through _anvil-unscoped so
# ANVIL_IMPACT=off is set before the check dependencies run, regardless of how
# the group is invoked. The group does not recompute impact and therefore does
# not require cargo-delta.

# Run the scheduled runtime analysis.
[group("anvil")]
anvil-scheduled-runtime-analysis: (_anvil-unscoped "scheduled-runtime-analysis")

[private]
_anvil-scheduled-runtime-analysis: anvil-scheduled-runtime-analysis-validate-prereqs \
    anvil-miri \
    anvil-miri-tree-borrows \
    anvil-miri-strict-provenance \
    anvil-miri-race-coverage

# See https://github.com/microsoft/ox-tools/blob/main/crates/cargo-anvil/docs/design/checks.md

# Full-workspace backstop: routed through _anvil-unscoped so
# ANVIL_IMPACT=off is set before the check dependencies run, regardless of how
# the group is invoked. The group does not recompute impact and therefore does
# not require cargo-delta.

# Run the scheduled exhaustive checks.
[group("anvil")]
anvil-scheduled-exhaustive: (_anvil-unscoped "scheduled-exhaustive")

[private]
_anvil-scheduled-exhaustive: anvil-scheduled-exhaustive-validate-prereqs \
    anvil-mutants-full \
    anvil-cargo-hack \
    anvil-bench
