# Used by scheduled and full wrappers to disable impact scoping before dependencies run.
[private]
[no-exit-message]
_anvil-unscoped name:
    {{ just_executable() }} --justfile {{ quote(justfile()) }} --set anvil_impact_override off _anvil-{{ name }}

anvil_impact_override := ""
anvil_impact_mode := if anvil_impact_override != "" {
    anvil_impact_override
} else if env("ANVIL_IMPACT", "") == "" {
    ""
} else if env("ANVIL_IMPACT") == "consume" {
    "consume"
} else if env("ANVIL_IMPACT") == "off" {
    "off"
} else {
    error("ANVIL_IMPACT must be unset, 'consume', or 'off'")
}

anvil_impact_input_dir := if anvil_impact_mode == "consume" {
    env("ANVIL_IMPACT_INPUT_DIR", "target/anvil/impact")
} else {
    "target/anvil/impact"
}

anvil_impact_compute_prefix := if anvil_impact_mode == "" { "" } else { "# " }
anvil_impact_toolchain_arg := if anvil_impact_mode == "" { anvil_stable_toolchain_arg } else { "" }

anvil_base_ref := if env("BASE_REF", "") == "" {
    if env("SYSTEM_PULLREQUEST_TARGETBRANCH", "") == "" {
        if env("GITHUB_BASE_REF", "") == "" {
            "origin/main"
        } else {
            "origin/" + env("GITHUB_BASE_REF")
        }
    } else {
        "origin/" + replace(env("SYSTEM_PULLREQUEST_TARGETBRANCH"), "refs/heads/", "")
    }
} else {
    env("BASE_REF")
}

anvil_modified_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/modified.packages")
}

anvil_affected_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/affected.packages")
}

anvil_required_selection := if anvil_impact_mode == "off" {
    "--workspace"
} else {
    "--package-file " + quote(anvil_impact_input_dir + "/required.packages")
}

anvil_explicit_package_args := if anvil_impact_mode == "off" { "" } else { "'{packages}'" }

anvil_root_msrv := env("ANVIL_ROOT_MSRV", "")
workspace_rust_version_line := if anvil_root_msrv == "" {
    shell("cargo each --workspace --once --dry-run -- " + quote("workspace-rust-version={workspace-rust-version}"))
} else {
    "workspace-rust-version=" + if anvil_root_msrv == "none" { "" } else { anvil_root_msrv }
}
workspace_rust_version := replace(workspace_rust_version_line, "workspace-rust-version=", "")

anvil_stable_toolchain_arg := if env("RUSTUP_TOOLCHAIN", "") == "" {
    if path_exists(justfile_directory() + "/rust-toolchain.toml") {
        ""
    } else if path_exists(justfile_directory() + "/rust-toolchain") {
        ""
    } else if workspace_rust_version == "" {
        ""
    } else {
        quote("+" + workspace_rust_version)
    }
} else {
    ""
}

anvil_msrv_selection := if workspace_rust_version == "" { "--none" } else { anvil_affected_selection }
anvil_msrv_workspace_selection := if workspace_rust_version == "" { "--none" } else { "--workspace" }

# Used by anvil-scheduled and _anvil-full to fan out all scheduled groups.
[private]
_anvil-scheduled: anvil-scheduled-validate-prereqs \
    anvil-scheduled-test \
    anvil-scheduled-advisories \
    anvil-scheduled-runtime-analysis \
    anvil-scheduled-exhaustive
# Used by anvil-full to run pull-request and scheduled tiers in one unscoped child.
[private]
_anvil-full: anvil-full-validate-prereqs \
    anvil-pr \
    _anvil-scheduled

anvil_bolero_targets_file := "target" / ("bolero-list-" + just_pid() + ".jsonl")
anvil_bolero_host_target := `rustc +{{ rust_nightly }} --print host-tuple`
# Used by anvil-bolero to create its JSONL output directory after impact analysis.
[private]
_ensure-target-dir: anvil-impact
    {{ if path_exists("target") { "# target directory already exists" } else { "mkdir target" } }}

anvil_careful_prefix := if anvil_impact_mode == "off" {
    ""
} else if trim(read(anvil_impact_input_dir + "/affected.packages")) == "" {
    "# "
} else {
    ""
}
anvil_careful_target_dir := if anvil_careful_prefix == "" {
    "target" / "anvil" / "careful" / sha256(
        shell("rustup run " + rust_nightly + " rustc -vV")
        + "\n"
        + sha256_file(which("cargo-careful"))
    )
} else {
    ""
}

anvil_coverage_gate_host_target := shell("rustc +" + rust_nightly + " --print host-tuple")
anvil_coverage_gate_local_command := shell(
    "cargo each --workspace --filter metadata:anvil.catalog-tool=cargo-coverage-gate --once --dry-run -- cargo +"
    + rust_nightly
    + " run --locked --package cargo-coverage-gate --bin cargo-coverage-gate --target="
    + anvil_coverage_gate_host_target
    + " -- coverage-gate"
)
anvil_coverage_gate_command := if anvil_coverage_gate_local_command == "" {
    "cargo +" + rust_nightly + " coverage-gate"
} else {
    anvil_coverage_gate_local_command
}

# Compile selected packages together once, then run emitted Miri test artifacts
# concurrently. `metadata.anvil.miri.exclude = true` omits a package's own
# tests; `ANVIL_MIRI_JOBS` limits artifact workers.

anvil_miri_artifacts_file := "target" / ("anvil-miri-artifacts-" + just_pid() + ".jsonl")
anvil_miri_sysroot := shell("cargo +" + rust_nightly + " miri setup --print-sysroot")
anvil_miri_target_libdir := shell("rustup run " + rust_nightly + " rustc --print target-libdir")
anvil_miri_library_path_name := if os() == "windows" { "PATH" } else if os() == "macos" { "DYLD_FALLBACK_LIBRARY_PATH" } else { "LD_LIBRARY_PATH" }
anvil_miri_library_path_separator := if os() == "windows" { ";" } else { ":" }
anvil_miri_default_library_path := if os() == "macos" { home_directory() / "lib" + ":/usr/local/lib:/usr/lib" } else { "" }
anvil_miri_inherited_library_path := env(anvil_miri_library_path_name, anvil_miri_default_library_path)
anvil_miri_library_path := anvil_miri_target_libdir + if anvil_miri_inherited_library_path == "" { "" } else { anvil_miri_library_path_separator + anvil_miri_inherited_library_path }
anvil_miri_race_seed_windows := "01=1..3 02=3..5 03=5..7 04=7..9 05=9..11 06=11..13 07=13..15 08=15..17 09=17..19 10=19..21 11=21..23 12=23..25 13=25..27 14=27..29 15=29..31 16=31..33 17=33..35 18=35..37 19=37..39 20=39..41 21=41..43 22=43..45 23=45..47 24=47..49 25=49..51 26=51..53 27=53..55 28=55..57 29=57..59 30=59..61 31=61..63"
anvil_miri_race_seed_window := replace_regex(anvil_miri_race_seed_windows, ".*(?:^| )" + datetime("%d") + "=([^ ]+)(?: |$).*", "$1")

anvil_miri_selection(package) := if package == "" { anvil_affected_selection } else { "--package " + quote(package) }

anvil_miri_flags(profile) := trim(if profile == "tree-borrows" { "-Zmiri-tree-borrows " + env("MIRIFLAGS", "") } else if profile == "strict-provenance" { "-Zmiri-strict-provenance " + env("MIRIFLAGS", "") } else if profile == "race-coverage" { "-Zmiri-many-seeds=" + anvil_miri_race_seed_window + " " + env("MIRIFLAGS", "") } else { env("MIRIFLAGS", "") })

anvil_miri_rustflags(profile) := trim(if profile == "tree-borrows" { "--cfg miri_tree_borrows " + env("RUSTFLAGS", "") } else if profile == "strict-provenance" { "--cfg miri_strict_provenance " + env("RUSTFLAGS", "") } else if profile == "race-coverage" { "--cfg miri_race_coverage " + env("RUSTFLAGS", "") } else { env("RUSTFLAGS", "") })

anvil_toml_basic_string(value) := '"' + replace(replace(replace(replace(value, '\', '\\'), '"', '\"'), "\r", '\r'), "\n", '\n') + '"'
anvil_cargo_env_config(name, value) := "--config " + quote("env." + name + ".value=" + anvil_toml_basic_string(value)) + " --config " + quote("env." + name + ".force=true")

# Test mode compiles once and lets cargo-each run Cargo's executable test
# artifacts from their package roots. Example mode runs directly through Miri.
[env("MIRI_BE_RUSTC", "host")]
[env("MIRI_SYSROOT", anvil_miri_sysroot)]
[env(anvil_miri_library_path_name, anvil_miri_library_path)]
[private]
_anvil-miri-test profile package="" test_filter="" example="": anvil-impact _ensure-target-dir
    {{ if profile == "standard" || profile == "tree-borrows" || profile == "strict-provenance" || profile == "race-coverage" { "# valid Miri profile" } else { error("anvil miri: unknown profile '" + profile + "'") } }}
    {{ if test_filter != "" && example != "" { error("anvil-miri: choose exactly one of --test or --example") } else { "# valid test/example selection" } }}
    {{ if example != "" && package == "" { error("anvil-miri: --example requires --package to avoid workspace ambiguity") } else { "# valid example package selection" } }}
    {{ if example == "" { "# " } else { "" } }}cargo +{{ rust_nightly }} {{ anvil_cargo_env_config("MIRIFLAGS", anvil_miri_flags(profile)) }} {{ anvil_cargo_env_config("RUSTFLAGS", anvil_miri_rustflags(profile)) }} each {{ anvil_miri_selection(package) }} --filter {{ quote("not metadata:anvil.miri.exclude=true") }} --once -- cargo +{{ rust_nightly }} miri run '{packages}' --all-features --locked --example {{ quote(example) }}
    {{ if example != "" { "# " } else { "" } }}cargo +{{ rust_nightly }} {{ anvil_cargo_env_config("MIRIFLAGS", anvil_miri_flags(profile)) }} {{ anvil_cargo_env_config("RUSTFLAGS", anvil_miri_rustflags(profile)) }} {{ if os() == "windows" { anvil_cargo_env_config("__CARGO_TEMPORARY_BUILD_DIR_NEW_LAYOUT_OPT_OUT", "1") } else { "" } }} each {{ anvil_miri_selection(package) }} --filter {{ quote("not metadata:anvil.miri.exclude=true") }} --once -- cargo +{{ rust_nightly }} miri test '{packages}' --all-features --tests --no-run --locked --message-format=json,json-render-diagnostics > {{ quote(anvil_miri_artifacts_file) }}
    {{ if example != "" { "# " } else { "" } }}cargo +{{ rust_nightly }} {{ anvil_cargo_env_config("MIRIFLAGS", anvil_miri_flags(profile)) }} each --json-lines-file {{ quote(anvil_miri_artifacts_file) }} --json-filter {{ quote("reason=compiler-artifact and profile.test=true and executable") }} --json-work-dir-parent manifest_path --jobs {{ quote(env("ANVIL_MIRI_JOBS", "auto")) }} --keep-going -- rustup run {{ rust_nightly }} cargo-miri runner '{json:executable}' {{ if test_filter == "" { "" } else { quote(test_filter) } }}
    {{ if example != "" { "# " } else { "" } }}rm {{ quote(anvil_miri_artifacts_file) }}

anvil_mutants_diff_dir := env("RUNNER_TEMP", env("AGENT_TEMPDIRECTORY", env("TEMP", env("TMPDIR", "."))))
anvil_mutants_diff_file := anvil_mutants_diff_dir / ("anvil-mutants-diff-" + just_pid() + ".diff")
# Comment out campaign commands when impact selected no packages.
anvil_mutants_diff_skip_prefix := if anvil_impact_mode == "off" { "" } else if trim(read(anvil_impact_input_dir + "/affected.packages")) == "" { "# " } else { "" }

anvil_pr_title := env("PR_TITLE", "")
anvil_pr_title_pattern := '^(?i:feat|fix|chore|docs|refactor|test|build|ci|perf|revert)(?:\([^)]+\))?!?: .+$'
anvil_pr_title_error := "PR title '" + anvil_pr_title + "' does not match the accepted Conventional Commits subset.\nAllowed patterns: <type>: <description>, <type>(<scope>): <description>, <type>!: <description>, <type>(<scope>)!: <description>\nAllowed types (case-insensitive): feat, fix, chore, docs, refactor, test, build, ci, perf, revert"

anvil_readme_template := if path_exists("crates/README.j2") {
    absolute_path("crates/README.j2")
} else if path_exists("README.j2") {
    absolute_path("README.j2")
} else {
